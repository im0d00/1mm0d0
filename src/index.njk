<script>
// LOADER
const statuses = ['Initializing security modules...', 'Loading profile data...', 'Establishing secure connection...', 'Verifying credentials...', 'Rendering interface...', 'System ready.'];
let si = 0;
const lstat = document.getElementById('lstat');
const sint = setInterval(() => { if (si < statuses.length - 1) { si++; if (lstat) lstat.textContent = statuses[si]; } }, 350);
window.addEventListener('load', () => {
    clearInterval(sint);
    if (lstat) lstat.textContent = 'System ready.';
    setTimeout(() => document.getElementById('loader')?.classList.add('hide'), 1000);
});

// MULTI-LAYERED CYBERSECURITY HERO CANVAS
(() => {
    const c = document.getElementById('hero-canvas');
    if (!c) return;
    const ctx = c.getContext('2d');
    let W, H, nodes = [], logLines = [];
    const nodeCount = 65;
    let animId = null;
    let isHeroVisible = true;
    let mouse = { x: -1000, y: -1000 };

    // Canvas sizing
    function resize() {
        W = c.width = c.offsetWidth || window.innerWidth;
        H = c.height = c.offsetHeight || window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    // Track mouse for interactive node displacement
    c.parentElement?.addEventListener('mousemove', (e) => {
        const rect = c.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
    });
    c.parentElement?.addEventListener('mouseleave', () => {
        mouse.x = -1000; mouse.y = -1000;
    });

    // Node initialization
    const types = ['cyan', 'violet', 'green'];
    for (let i = 0; i < nodeCount; i++) {
        nodes.push({
            x: Math.random() * W,
            y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.45,
            vy: (Math.random() - 0.5) * 0.45,
            r: Math.random() * 2 + 1,
            pulse: Math.random() * Math.PI * 2,
            type: types[Math.floor(Math.random() * types.length)]
        });
    }

    // Terminal log streams for Layer 4
    const logPool = [
        '[SOC-LOG] 10.0.4.12:443 -> TCP SYN_ACK',
        '[SIEM] Snort Rule Match #1002 ALARM_LOW',
        '[DFIR] Volatility Memory Dump Proc...',
        '[NET] BGP Neighbor 172.16.0.1 ESTABLISHED',
        '[CRYPT] Ed25519 Signature Verified',
        '[CERT] Cisco CCNA / Cybersecurity Verified'
    ];
    for (let i = 0; i < 6; i++) {
        logLines.push({
            text: logPool[i % logPool.length],
            x: Math.random() * (W - 250) + 20,
            y: Math.random() * H,
            speed: 0.25 + Math.random() * 0.35,
            opacity: 0.12 + Math.random() * 0.18
        });
    }

    function draw() {
        if (!isHeroVisible) return;
        ctx.clearRect(0, 0, W, H);

        // 1. Draw Layer: Grid Mesh Lines
        ctx.strokeStyle = 'rgba(0,212,255,0.03)';
        ctx.lineWidth = 1;
        const gridSize = 60;
        for (let x = 0; x < W; x += gridSize) {
            ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
        }
        for (let y = 0; y < H; y += gridSize) {
            ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
        }

        // 2. Draw Layer: Floating SOC Log Stream
        ctx.font = '10px "JetBrains Mono", monospace';
        logLines.forEach(l => {
            l.y -= l.speed;
            if (l.y < -20) {
                l.y = H + 20;
                l.x = Math.random() * (W - 250) + 20;
            }
            ctx.fillStyle = `rgba(0,212,255,${l.opacity})`;
            ctx.fillText(l.text, l.x, l.y);
        });

        // 3. Draw Layer: Neural Network Nodes & Distance Connections
        nodes.forEach(n => {
            n.x += n.vx;
            n.y += n.vy;
            n.pulse += 0.02;

            if (n.x < 0 || n.x > W) n.vx *= -1;
            if (n.y < 0 || n.y > H) n.vy *= -1;

            // Mouse displacement effect
            const mdx = n.x - mouse.x;
            const mdy = n.y - mouse.y;
            const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
            if (mdist < 120 && mdist > 0) {
                const force = (120 - mdist) / 120;
                n.x += (mdx / mdist) * force * 1.5;
                n.y += (mdy / mdist) * force * 1.5;
            }
        });

        // Inter-node connection lines
        for (let i = 0; i < nodeCount; i++) {
            for (let j = i + 1; j < nodeCount; j++) {
                const dx = nodes[i].x - nodes[j].x;
                const dy = nodes[i].y - nodes[j].y;
                const d = Math.sqrt(dx * dx + dy * dy);

                if (d < 165) {
                    const alpha = (1 - d / 165) * 0.22;
                    if (nodes[i].type === 'cyan') ctx.strokeStyle = `rgba(0,212,255,${alpha})`;
                    else if (nodes[i].type === 'violet') ctx.strokeStyle = `rgba(167,139,250,${alpha})`;
                    else ctx.strokeStyle = `rgba(0,255,136,${alpha})`;

                    ctx.lineWidth = 0.6;
                    ctx.beginPath();
                    ctx.moveTo(nodes[i].x, nodes[i].y);
                    ctx.lineTo(nodes[j].x, nodes[j].y);
                    ctx.stroke();
                }
            }
        }

        // Render Nodes
        nodes.forEach(n => {
            const p = 0.6 + 0.4 * Math.sin(n.pulse);
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r * (0.8 + 0.3 * p), 0, Math.PI * 2);
            if (n.type === 'cyan') ctx.fillStyle = `rgba(0,212,255,${p * 0.8})`;
            else if (n.type === 'violet') ctx.fillStyle = `rgba(167,139,250,${p * 0.7})`;
            else ctx.fillStyle = `rgba(0,255,136,${p * 0.8})`;
            ctx.fill();
        });

        animId = requestAnimationFrame(draw);
    }

    // Pause canvas when out of view for performance optimization
    const heroSec = document.getElementById('hero');
    if (heroSec && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                isHeroVisible = entry.isIntersecting;
                if (isHeroVisible) {
                    if (!animId) draw();
                } else if (animId) {
                    cancelAnimationFrame(animId);
                    animId = null;
                }
            });
        }, { threshold: 0.05 });
        observer.observe(heroSec);
    }

    draw();
})();

// METRIC CARD COUNTER ANIMATION
(() => {
    const metrics = document.querySelectorAll('.metric-num[data-target]');
    if (metrics.length === 0) return;

    let animated = false;
    function startCounting() {
        if (animated) return;
        animated = true;

        metrics.forEach(el => {
            const target = parseInt(el.getAttribute('data-target'), 10) || 0;
            const suffix = el.getAttribute('data-suffix') || '';
            const duration = 1500;
            const stepTime = 30;
            const steps = duration / stepTime;
            const increment = target / steps;
            let current = 0;

            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    el.textContent = target + suffix;
                    clearInterval(timer);
                } else {
                    el.textContent = Math.floor(current) + suffix;
                }
            }, stepTime);
        });
    }

    const heroSection = document.getElementById('hero');
    if (heroSection && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
            if (entries[0].isIntersecting) startCounting();
        }, { threshold: 0.2 });
        observer.observe(heroSection);
    } else {
        startCounting();
    }
})();

// STICKY NAVBAR & ACTIVE SECTION HIGHLIGHTING
(() => {
    const navbar = document.getElementById('navbar');
    const mobNav = document.getElementById('mobNav');
    const mobOverlay = document.getElementById('mobOverlay');
    const ham = document.getElementById('ham');
    const mobCloseBtn = document.getElementById('mobCloseBtn');

    const scrollIndicator = document.getElementById('heroScrollIndicator');

    window.addEventListener('scroll', () => {
        if (navbar) {
            if (window.scrollY > 40) navbar.classList.add('scrolled');
            else navbar.classList.remove('scrolled');
        }

        if (scrollIndicator) {
            if (window.scrollY > 80) scrollIndicator.classList.add('hidden');
            else scrollIndicator.classList.remove('hidden');
        }

        const secs = document.querySelectorAll('section[id]');
        const links = document.querySelectorAll('.nav-links a');
        let cur = '';
        secs.forEach(s => {
            if (window.scrollY >= s.offsetTop - 140) cur = s.id;
        });
        links.forEach(a => {
            const href = a.getAttribute('href');
            a.classList.toggle('active', href === '#' + cur || href === '/#' + cur);
        });
    });

    function openMobileDrawer() {
        mobNav?.classList.add('open');
        mobOverlay?.classList.add('visible');
        document.body.style.overflow = 'hidden';
    }

    function closeMobileDrawer() {
        mobNav?.classList.remove('open');
        mobOverlay?.classList.remove('visible');
        document.body.style.overflow = '';
    }

    ham?.addEventListener('click', openMobileDrawer);
    mobCloseBtn?.addEventListener('click', closeMobileDrawer);
    mobOverlay?.addEventListener('click', closeMobileDrawer);

    document.querySelectorAll('.mobile-links a').forEach(a => {
        a.addEventListener('click', closeMobileDrawer);
    });
})();

// KEYBOARD SHORTCUT (CTRL+K / CMD+K) FOR SEARCH
window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearchModal();
    }
    if (e.key === 'Escape') {
        const searchModal = document.getElementById('searchModal');
        if (searchModal) searchModal.style.display = 'none';
        const detailModal = document.getElementById('detailModal');
        if (detailModal) detailModal.style.display = 'none';
        document.getElementById('mobNav')?.classList.remove('open');
        document.getElementById('mobOverlay')?.classList.remove('visible');
        document.body.style.overflow = '';
    }
});

function openSearchModal() {
    const searchModal = document.getElementById('searchModal');
    const searchInput = document.getElementById('searchInput');
    if (searchModal) searchModal.style.display = 'flex';
    if (searchInput) searchInput.focus();
    if (typeof searchData !== 'undefined' && searchData.length === 0) {
        fetch('/search.json')
            .then(res => res.json())
            .then(data => { searchData = data; })
            .catch(() => {});
    }
}

// HERO ROLE TYPEWRITER
const roles = {{ hero.rotating_job_titles | dump | safe }};
let ri = 0;
const roleEl = document.getElementById('heroRole');
if (roleEl && Array.isArray(roles) && roles.length > 0) {
    setInterval(() => {
        roleEl.style.opacity = '0';
        roleEl.style.transform = 'translateY(-10px)';
        setTimeout(() => {
            ri = (ri + 1) % roles.length;
            roleEl.textContent = roles[ri] + '_';
            roleEl.style.transition = 'opacity .4s,transform .4s';
            roleEl.style.opacity = '1';
            roleEl.style.transform = 'none';
        }, 300);
    }, 2800);
}

// SCROLL REVEAL & SKILL BARS
const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: .1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

const sobs = new IntersectionObserver(entries => {
    entries.forEach(e => {
        if (e.isIntersecting) {
            e.target.querySelectorAll('.sk-fill[data-w]').forEach(b => {
                setTimeout(() => { b.style.width = b.dataset.w + '%'; }, 200);
            });
            sobs.unobserve(e.target);
        }
    });
}, { threshold: .2 });
document.querySelectorAll('.card').forEach(c => { if (c.querySelector('.sk-fill')) sobs.observe(c); });

// CONTACT FORM HANDLER
function handleForm(e) {
    const endpoint = "{{ contact.contact_form_endpoint }}";
    if (!endpoint || endpoint === '#' || endpoint === '') {
        e.preventDefault();
        const cn = document.getElementById('cn')?.value || '';
        const ce = document.getElementById('ce')?.value || '';
        const co = document.getElementById('co')?.value || '';
        const ct = document.getElementById('ct')?.value || '';
        const cm = document.getElementById('cm')?.value || '';
        const txt = `Name: ${cn}\nEmail: ${ce}\nOrg: ${co}\nType: ${ct}\n\nMessage:\n${cm}`;
        navigator.clipboard.writeText(txt).catch(() => {});
        const okEl = document.getElementById('formOk');
        if (okEl) okEl.style.display = 'block';
        if (e.target && typeof e.target.reset === 'function') e.target.reset();
    }
}
</script>
<!-- SEARCH MODAL OVERLAY -->
<div id="searchModal" style="display:none; position:fixed; inset:0; z-index:99999; background:rgba(5,8,16,0.85); backdrop-filter:blur(8px); padding:2rem 1rem; align-items:flex-start; justify-content:center; overflow-y:auto;">
    <div class="card" style="max-width:700px; width:100%; margin-top:5vh; padding:1.8rem; position:relative; border:1px solid var(--border2); background:var(--panel);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <div style="font-family:'Space Grotesk',sans-serif; font-size:1.2rem; font-weight:700; color:var(--cyan); display:flex; align-items:center; gap:0.5rem;">
                <i class="fa-solid fa-terminal"></i> Security Operations Search Engine
            </div>
            <button id="searchCloseBtn" style="background:none; border:none; color:var(--silver); font-size:1.2rem; cursor:pointer;" aria-label="Close search">&times;</button>
        </div>
        <div style="position:relative; margin-bottom:1.2rem;">
            <input type="text" id="searchInput" placeholder="Search projects, labs, posts, tools, certs..." style="width:100%; padding:0.8rem 1rem 0.8rem 2.5rem; background:rgba(10,22,40,0.8); border:1px solid var(--border); border-radius:8px; color:var(--white); font-family:'JetBrains Mono',monospace; font-size:0.95rem;" />
            <i class="fa-solid fa-magnifying-glass" style="position:absolute; left:1rem; top:50%; transform:translateY(-50%); color:var(--cyan); font-size:0.9rem;"></i>
        </div>
        <div id="searchResults" style="max-height:400px; overflow-y:auto; display:flex; flex-direction:column; gap:0.6rem;">
            <div style="text-align:center; color:var(--muted); padding:1rem; font-size:0.88rem;">Type a query to search across all cybersecurity records...</div>
        </div>
    </div>
</div>

<script>
// SEARCH ENGINE & MODAL
let searchData = [];
const searchModal = document.getElementById('searchModal');
const searchInput = document.getElementById('searchInput');
const searchResults = document.getElementById('searchResults');

document.getElementById('searchOpenBtn')?.addEventListener('click', () => {
    if (searchModal) searchModal.style.display = 'flex';
    if (searchInput) searchInput.focus();
    if (searchData.length === 0) {
        fetch('/search.json')
            .then(res => res.json())
            .then(data => { searchData = data; })
            .catch(() => {});
    }
});
document.getElementById('searchCloseBtn')?.addEventListener('click', () => {
    if (searchModal) searchModal.style.display = 'none';
});
if (searchModal) {
    searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) searchModal.style.display = 'none';
    });
}

if (searchInput) {
    searchInput.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        if (!q) {
            if (searchResults) searchResults.innerHTML = '<div style="text-align:center; color:var(--muted); padding:1rem; font-size:0.88rem;">Type a query to search across all cybersecurity records...</div>';
            return;
        }
        const matches = searchData.filter(item => {
            return (item.title && item.title.toLowerCase().includes(q)) ||
                   (item.description && item.description.toLowerCase().includes(q)) ||
                   (item.category && item.category.toLowerCase().includes(q)) ||
                   (item.type && item.type.toLowerCase().includes(q)) ||
                   (item.tags && item.tags.some(t => String(t).toLowerCase().includes(q)));
        });

        if (!searchResults) return;
        if (matches.length === 0) {
            searchResults.innerHTML = '<div style="text-align:center; color:var(--amber); padding:1rem; font-size:0.88rem;"><i class="fa-solid fa-triangle-exclamation"></i> No threat vectors or records found matching "' + q + '".</div>';
        } else {
            searchResults.innerHTML = matches.map(item => `
                <a href="${item.url}" onclick="const sm=document.getElementById('searchModal'); if(sm) sm.style.display='none';" style="display:block; padding:0.8rem; background:rgba(11,19,40,0.6); border:1px solid var(--border); border-radius:6px; text-decoration:none; transition:border-color 0.2s;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:0.75rem; font-family:'JetBrains Mono',monospace; color:var(--cyan); text-transform:uppercase;">[${item.type}] ${item.category || ''}</span>
                        <i class="fa-solid fa-arrow-right fa-xs" style="color:var(--muted);"></i>
                    </div>
                    <div style="font-weight:600; color:var(--white); margin:0.3rem 0; font-size:0.95rem;">${item.title}</div>
                    <div style="font-size:0.82rem; color:var(--silver);">${item.description ? item.description.substring(0, 110) + '...' : ''}</div>
                </a>
            `).join('');
        }
    });
}

// SERVICE WORKER PWA REGISTRATION
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
}

// ADVANCED CATEGORY & YEAR FILTERING SYSTEM
function filterCategory(type, category, btn) {
    // Toggle active button state in the filter bar
    const bar = btn.parentElement;
    bar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    let selector = '';
    if (type === 'proj') selector = '.proj-item';
    else if (type === 'lab') selector = '.lab-item';
    else if (type === 'kb') selector = '.kb-item';
    else if (type === 'tl') selector = '.tl-card-item';

    const items = document.querySelectorAll(selector);
    items.forEach(el => {
        const cat = el.getAttribute('data-category') || '';
        if (category === 'all' || cat.toLowerCase().includes(category.toLowerCase())) {
            el.style.display = 'flex';
            if (selector === '.tl-card-item') el.style.display = 'block';
            el.classList.add('in');
        } else {
            el.style.display = 'none';
        }
    });
}

// TECHNOLOGY ICON RESOLVER ENGINE
function getTechIcon(name) {
    const n = name.toLowerCase();
    if (n.includes('python')) return 'fa-brands fa-python';
    if (n.includes('linux') || n.includes('ubuntu') || n.includes('kali')) return 'fa-brands fa-linux';
    if (n.includes('docker')) return 'fa-brands fa-docker';
    if (n.includes('aws') || n.includes('amazon')) return 'fa-brands fa-aws';
    if (n.includes('git') || n.includes('github')) return 'fa-brands fa-git-alt';
    if (n.includes('windows') || n.includes('active directory')) return 'fa-brands fa-windows';
    if (n.includes('bash') || n.includes('shell') || n.includes('terminal')) return 'fa-solid fa-terminal';
    if (n.includes('powershell')) return 'fa-solid fa-code';
    if (n.includes('nmap') || n.includes('scanner') || n.includes('nessus')) return 'fa-solid fa-radar';
    if (n.includes('wireshark') || n.includes('network') || n.includes('tcpdump')) return 'fa-solid fa-network-wired';
    if (n.includes('burp') || n.includes('web') || n.includes('owasp')) return 'fa-solid fa-bug';
    if (n.includes('metasploit') || n.includes('exploit') || n.includes('hydra') || n.includes('hashcat')) return 'fa-solid fa-skull-crossbones';
    if (n.includes('forensics') || n.includes('autopsy') || n.includes('volatility')) return 'fa-solid fa-magnifying-glass-chart';
    if (n.includes('snort') || n.includes('suricata') || n.includes('siem') || n.includes('wazuh') || n.includes('splunk')) return 'fa-solid fa-shield-cat';
    return 'fa-solid fa-microchip';
}

// GENERIC DETAIL MODAL DISPLAY SYSTEM
const detailModal = document.getElementById('detailModal');
const modalTitle = document.getElementById('modalTitle');
const modalBody = document.getElementById('modalBody');

function closeDetailModal() {
    if (detailModal) detailModal.style.display = 'none';
}

if (detailModal) {
    detailModal.addEventListener('click', (e) => {
        if (e.target === detailModal) closeDetailModal();
    });
}

function openSkillModal(skill, categoryName) {
    if (modalTitle) modalTitle.innerHTML = `<i class="fa-solid fa-code" style="color:var(--cyan);"></i> Skill Intelligence: ${skill.name}`;
    if (modalBody) modalBody.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem; background:rgba(0,212,255,0.06); padding:0.8rem 1rem; border-radius:8px; border:1px solid var(--border);">
            <div><span style="color:var(--muted); font-size:0.8rem;">Category:</span> <strong style="color:var(--cyan); font-family:'Space Grotesk',sans-serif;">${categoryName}</strong></div>
            <div><span style="color:var(--muted); font-size:0.8rem;">Proficiency:</span> <strong style="color:var(--green); font-family:'JetBrains Mono',monospace;">${skill.percentage}%</strong></div>
        </div>
        <div style="margin-bottom:1.5rem;">
            <div style="font-size:0.82rem; color:var(--muted); text-transform:uppercase; margin-bottom:0.4rem;">Skill Description & Practical Scope</div>
            <p style="color:var(--silver); line-height:1.6; font-size:0.95rem;">${skill.description || 'Proficient in theoretical principles and practical command-line execution for defensive and offensive operations.'}</p>
        </div>
        <div style="margin-bottom:1.5rem;">
            <div style="font-size:0.82rem; color:var(--muted); text-transform:uppercase; margin-bottom:0.4rem;">Associated Security Tools & Technologies</div>
            <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
                <span class="tech-badge"><i class="${getTechIcon(skill.name)}"></i> ${skill.name} Engine</span>
                <span class="tech-badge"><i class="fa-solid fa-terminal"></i> CLI Execution</span>
                <span class="tech-badge"><i class="fa-solid fa-shield-halved"></i> Security Hardening</span>
            </div>
        </div>
        <div style="background:var(--navy); padding:1rem; border-radius:8px; border:1px solid var(--border);">
            <div style="font-size:0.82rem; color:var(--muted); text-transform:uppercase; margin-bottom:0.4rem;"><i class="fa-solid fa-graduation-cap" style="color:var(--cyan);"></i> Continuous Learning Roadmap</div>
            <p style="font-size:0.88rem; color:var(--light);">Regularly updated via TryHackMe modules, lab exercises, and practical vulnerability write-ups.</p>
        </div>
    `;
    if (detailModal) detailModal.style.display = 'flex';
}

function openProjModal(proj) {
    if (modalTitle) modalTitle.innerHTML = `<i class="fa-solid fa-folder-open" style="color:var(--green);"></i> Project Specs: ${proj.title}`;
    const techBadges = (proj.technologies || []).map(t => `<span class="tech-badge"><i class="${getTechIcon(t)}"></i> ${t}</span>`).join('');
    if (modalBody) modalBody.innerHTML = `
        <div style="margin-bottom:1rem; color:var(--cyan); font-family:'JetBrains Mono',monospace; font-size:0.85rem;">
            CATEGORY: ${proj.category ? proj.category.toUpperCase() : 'CYBERSECURITY'}
        </div>
        <p style="color:var(--silver); font-size:0.95rem; line-height:1.6; margin-bottom:1.2rem;">${proj.description}</p>
        <div style="margin-bottom:1.5rem;">
            <div style="font-size:0.82rem; color:var(--muted); text-transform:uppercase; margin-bottom:0.5rem;">Technology Stack & Libraries</div>
            <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">${techBadges}</div>
        </div>
        <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; border-top:1px solid var(--border); padding-top:1rem;">
            ${proj.github_link ? `<a href="${proj.github_link}" target="_blank" class="res-dl" style="font-size:0.85rem; padding:8px 16px;"><i class="fa-brands fa-github"></i> GitHub Code</a>` : ''}
            ${proj.live_demo ? `<a href="${proj.live_demo}" target="_blank" class="res-dl" style="font-size:0.85rem; padding:8px 16px; background:var(--panel); border:1px solid var(--border2); color:var(--cyan);"><i class="fa-solid fa-arrow-up-right-from-square"></i> Live Demo</a>` : ''}
            ${proj.pdf ? `<a href="${proj.pdf}" download class="res-dl" style="font-size:0.85rem; padding:8px 16px; background:rgba(124,58,237,0.2); color:var(--violet2);"><i class="fa-solid fa-file-pdf"></i> Download PDF Documentation</a>` : ''}
        </div>
    `;
    if (detailModal) detailModal.style.display = 'flex';
}

function openLabModal(lab) {
    if (modalTitle) modalTitle.innerHTML = `<i class="fa-solid fa-flask" style="color:var(--violet2);"></i> Lab Blueprint: ${lab.name}`;
    const toolBadges = (lab.tools || []).map(t => `<span class="tech-badge"><i class="${getTechIcon(t)}"></i> ${t}</span>`).join('');
    if (modalBody) modalBody.innerHTML = `
        <div style="margin-bottom:1rem; color:var(--violet2); font-family:'JetBrains Mono',monospace; font-size:0.85rem;">
            PLATFORM: ${lab.platform ? lab.platform.toUpperCase() : 'VIRTUAL LAB'}
        </div>
        <p style="color:var(--silver); font-size:0.95rem; line-height:1.6; margin-bottom:1.2rem;">${lab.description}</p>
        <div style="margin-bottom:1.5rem;">
            <div style="font-size:0.82rem; color:var(--muted); text-transform:uppercase; margin-bottom:0.5rem;">Security Tools & Environment</div>
            <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">${toolBadges}</div>
        </div>
        ${lab.writeup_url ? `
        <div style="margin-top:1.5rem; border-top:1px solid var(--border); padding-top:1rem;">
