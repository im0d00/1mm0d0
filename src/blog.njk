  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">[Aimad<span>.</span>Blog]</div>
        <p class="footer-tagline">Cybersecurity student, SOC enthusiast, and Cisco Ethical Hacker from Peshawar, Pakistan. Writing about what I learn — one post at a time.</p>
      </div>
      <div class="footer-col">
        <h4>Navigation</h4>
        <a href="/">Portfolio</a>
        <a href="/blog/">Blog Home</a>
        <a href="/#certifications">Certifications</a>
        <a href="/#projects">Projects</a>
        <a href="/#contact">Contact</a>
      </div>
      <div class="footer-col">
        <h4>Connect</h4>
        <a href="https://linkedin.com/in/aimadulislam" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin-in fa-xs" aria-hidden="true"></i> LinkedIn</a>
        <a href="https://github.com/Aimadulislam" target="_blank" rel="noopener"><i class="fa-brands fa-github fa-xs" aria-hidden="true"></i> GitHub</a>
        <a href="https://aimad.lizzdo.com" target="_blank" rel="noopener"><i class="fa-solid fa-globe fa-xs" aria-hidden="true"></i> Lizzdo.com</a>
        <a href="mailto:info@aimadulislam.dpdns.org"><i class="fa-solid fa-envelope fa-xs" aria-hidden="true"></i> Email</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">© 2026 Aimad Ul Islam — All rights reserved.</span>
      <div class="footer-socs">
        <a href="https://linkedin.com/in/aimadulislam" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>
        <a href="https://github.com/Aimadulislam" target="_blank" rel="noopener" aria-label="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
        <a href="mailto:info@aimadulislam.dpdns.org" aria-label="Email"><i class="fa-solid fa-envelope" aria-hidden="true"></i></a>
