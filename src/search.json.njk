---
permalink: /search.json
eleventyExcludeFromCollections: true
---
[
  {%- for post in collections.posts %}
  {
    "type": "Blog Post",
    "title": {{ post.data.title | dump | safe }},
    "description": {{ (post.data.excerpt or "") | dump | safe }},
    "category": {{ (post.data.categories[0] or "General") | dump | safe }},
    "tags": {{ (post.data.tags or []) | dump | safe }},
    "url": {{ post.url | dump | safe }}
  },
  {%- endfor %}
  {%- for proj in projects.items %}
  {
    "type": "Project",
    "title": {{ proj.title | dump | safe }},
    "description": {{ proj.description | dump | safe }},
    "category": {{ proj.category | dump | safe }},
    "tags": {{ proj.technologies | dump | safe }},
    "url": "/#projects"
  },
  {%- endfor %}
  {%- for lab in labs.items %}
  {
    "type": "Lab",
    "title": {{ lab.name | dump | safe }},
    "description": {{ lab.description | dump | safe }},
    "category": {{ lab.platform | dump | safe }},
    "tags": {{ lab.tools | dump | safe }},
    "url": "/#labs"
  },
  {%- endfor %}
  {%- for report in reports.items %}
  {
    "type": "Research Report",
    "title": {{ report.title | dump | safe }},
    "description": {{ report.summary | dump | safe }},
    "category": {{ report.category | dump | safe }},
    "tags": ["Research", "PDF", "Security Report"],
    "url": "/#reports"
  },
  {%- endfor %}
  {%- for cert in certifications.items %}
  {
    "type": "Certification",
    "title": {{ cert.name | dump | safe }},
    "description": {{ (cert.provider + " - " + cert.status) | dump | safe }},
    "category": "Credentials",
    "tags": [{{ cert.provider | dump | safe }}],
    "url": "/#certifications"
  },
  {%- endfor %}
  {
    "type": "Resource",
    "title": "Privacy Policy",
    "description": "Our commitment to data privacy, zero intrusive tracking, and data protection.",
    "category": "Legal & Governance",
    "tags": ["privacy", "gdpr", "data", "legal"],
    "url": "/resources/privacy-policy/"
  },
  {
    "type": "Resource",
    "title": "Terms of Use",
    "description": "Terms governing site access, intellectual property, and educational boundaries.",
    "category": "Legal & Governance",
    "tags": ["terms", "legal", "usage", "policy"],
    "url": "/resources/terms/"
  },
  {
    "type": "Resource",
    "title": "Vulnerability Disclosure",
    "description": "Responsible vulnerability disclosure guidelines and PGP encryption channel.",
    "category": "Security Defense",
    "tags": ["vulnerability", "disclosure", "bug-bounty", "pgp"],
    "url": "/resources/responsible-disclosure/"
  },
  {
    "type": "Resource",
    "title": "Infrastructure Security Policy",
    "description": "Technical overview of system architecture, CSP, WAF, and SSL hardening.",
    "category": "Security Defense",
    "tags": ["security", "csp", "waf", "ssl"],
    "url": "/resources/security-policy/"
  },
  {
    "type": "Resource",
    "title": "Frequently Asked Questions (FAQ)",
    "description": "Answers about lab setups, DFIR research, certification journey, and consulting.",
    "category": "Support",
    "tags": ["faq", "help", "labs", "support"],
    "url": "/resources/faq/"
  },
  {
    "type": "Resource",
    "title": "System Changelog",
    "description": "Version history, feature releases, and architecture improvements.",
    "category": "Releases",
    "tags": ["changelog", "updates", "releases", "version"],
    "url": "/resources/changelog/"
  },
  {%- for kbcat in knowledgebase.categories %}
  {%- for item in kbcat.items %}
  {
    "type": "Knowledge Base",
    "title": {{ item.title | dump | safe }},
    "description": {{ item.summary | dump | safe }},
    "category": {{ item.category | dump | safe }},
    "tags": {{ item.tags | dump | safe }},
    "url": "/#kb"
  }
  {%- if not loop.last or not loop.parent.loop.last %},{% endif %}
  {%- endfor %}
  {%- endfor %}
]
