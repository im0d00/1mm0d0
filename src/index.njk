                <h2 class="sec-title">Latest Technical Articles & DFIR Writeups</h2>
                <a href="/blog/" style="background:rgba(0,212,255,0.1); border:1px solid var(--border2); padding:0.4rem 1rem; border-radius:20px; color:var(--cyan); font-family:'JetBrains Mono',monospace; font-size:0.9rem; text-decoration:none;">
                    <i class="fa-solid fa-pen-nib"></i> View All {{ collections.posts | length }} Writeups <i class="fa-solid fa-arrow-right fa-xs"></i>
                </a>
            </div>
            <div class="sec-rule"></div>
        </div>

        <div class="articles-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1.8rem;">
            {% for post in collections.posts | head(3) %}
            <article class="card article-card reveal {% if loop.index == 2 %}rv1{% elif loop.index == 3 %}rv2{% endif %}" onclick="window.location='{{ post.url }}'" style="cursor:pointer; display:flex; flex-direction:column; background:var(--panel); border:1px solid var(--border2); border-radius:var(--radius-lg); overflow:hidden; transition:transform 0.3s, border-color 0.3s;">
                <div class="card-glow"></div>
                <div class="article-card-img-wrap" style="height:180px; position:relative; overflow:hidden; background:rgba(10,22,40,0.8); display:flex; align-items:center; justify-content:center;">
                    {% if post.data.image or post.data.thumbnail %}
                    <img class="article-card-img" src="{{ post.data.image or post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy" style="width:100%; height:100%; object-fit:cover;" />
                    {% else %}
                    <span style="font-size:3rem;">{{ post.data.emoji or "📄" }}</span>
                    {% endif %}
                    <span class="card-diff-badge {{ (post.data.difficulty or 'Intermediate') | lower }}" style="position:absolute; top:12px; right:12px; background:rgba(5,8,16,0.85); border:1px solid var(--border2); padding:3px 10px; border-radius:12px; font-size:0.75rem; color:var(--cyan); font-family:'JetBrains Mono',monospace;">{{ post.data.difficulty or "Intermediate" }}</span>
                </div>

                <div class="article-card-body" style="padding:1.5rem; display:flex; flex-direction:column; flex:1;">
                    <div class="article-card-tags" style="display:flex; gap:0.4rem; flex-wrap:wrap; margin-bottom:0.8rem;">
                        {% for cat in post.data.categories %}
                        <span class="tag tag-cyber" style="background:rgba(0,212,255,0.08); border:1px solid rgba(0,212,255,0.2); padding:2px 8px; border-radius:4px; font-size:0.75rem; color:var(--cyan);">{{ cat }}</span>
                        {% endfor %}
                    </div>

                    <h3 class="article-card-title" style="font-size:1.15rem; font-weight:700; color:var(--white); margin-bottom:0.6rem; line-height:1.4;">{{ post.data.title }}</h3>
                    <p class="article-card-excerpt" style="font-size:0.88rem; color:var(--silver); line-height:1.5; margin-bottom:1.2rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">{{ post.data.excerpt or post.data.subtitle or post.data.description }}</p>

                    <div class="article-card-footer" style="margin-top:auto; display:flex; justify-content:space-between; align-items:center; font-size:0.8rem; color:var(--muted); border-top:1px solid var(--border); padding-top:0.8rem;">
                        <span><i class="fa-regular fa-calendar"></i> {{ post.date | readableDate }}</span>
                        <span style="color:var(--cyan); font-weight:600;">Read Writeup <i class="fa-solid fa-arrow-right fa-xs"></i></span>
                    </div>
                </div>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

