            </div>
            <button id="searchCloseBtn" style="background:none; border:none; color:var(--silver); font-size:1.2rem; cursor:pointer;" aria-label="Close search">&times;</button>
        </div>
        <div style="position:relative; margin-bottom:1.2rem;">
            <input type="text" id="searchInput" placeholder="Search projects, labs, posts, tools, certs..." style="width:100%; padding:0.8rem 1rem 0.8rem 2.5rem; background:rgba(10,22,40,0.8); border:1px solid var(--border); border-radius:8px; color:var(--white); font-family:'JetBrains Mono',monospace; font-size:0.95rem;" />
            <i class="fa-solid fa-magnifying-glass" style="position:absolute; left:1rem; top:50%; transform:translateY(-50%); color:var(--cyan); font-size:0.9rem;"></i>
        </div>
        <div id="searchResults" style="max-height:400px; overflow-y:auto; display:flex; flex-direction:column; gap:0.6rem;">
            <div style="text-align:center; color:var(--muted); padding:1rem; font-size:0.88rem;">Type a query to search across all cybersecurity records...</div>
        </div>
    </div>
</div>

<script>
// SEARCH ENGINE & MODAL
let searchData = [];
const searchModal = document.getElementById('searchModal');
const searchInput = document.getElementById('searchInput');
const searchResults = document.getElementById('searchResults');

document.getElementById('searchOpenBtn').addEventListener('click', () => {
    searchModal.style.display = 'flex';
    searchInput.focus();
    if (searchData.length === 0) {
        fetch('/search.json')
            .then(res => res.json())
            .then(data => { searchData = data; })
            .catch(() => {});
    }
});
document.getElementById('searchCloseBtn').addEventListener('click', () => {
    searchModal.style.display = 'none';
});
searchModal.addEventListener('click', (e) => {
    if (e.target === searchModal) searchModal.style.display = 'none';
});

searchInput.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    if (!q) {
        searchResults.innerHTML = '<div style="text-align:center; color:var(--muted); padding:1rem; font-size:0.88rem;">Type a query to search across all cybersecurity records...</div>';
        return;
    }
    const matches = searchData.filter(item => {
        return (item.title && item.title.toLowerCase().includes(q)) ||
               (item.description && item.description.toLowerCase().includes(q)) ||
               (item.category && item.category.toLowerCase().includes(q)) ||
               (item.type && item.type.toLowerCase().includes(q)) ||
               (item.tags && item.tags.some(t => String(t).toLowerCase().includes(q)));
    });

    if (matches.length === 0) {
        searchResults.innerHTML = '<div style="text-align:center; color:var(--amber); padding:1rem; font-size:0.88rem;"><i class="fa-solid fa-triangle-exclamation"></i> No threat vectors or records found matching "' + q + '".</div>';
    } else {
        searchResults.innerHTML = matches.map(item => `
            <a href="${item.url}" onclick="document.getElementById('searchModal').style.display='none'" style="display:block; padding:0.8rem; background:rgba(11,19,40,0.6); border:1px solid var(--border); border-radius:6px; text-decoration:none; transition:border-color 0.2s;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:0.75rem; font-family:'JetBrains Mono',monospace; color:var(--cyan); text-transform:uppercase;">[${item.type}] ${item.category || ''}</span>
                    <i class="fa-solid fa-arrow-right fa-xs" style="color:var(--muted);"></i>
                </div>
                <div style="font-weight:600; color:var(--white); margin:0.3rem 0; font-size:0.95rem;">${item.title}</div>
                <div style="font-size:0.82rem; color:var(--silver);">${item.description ? item.description.substring(0, 110) + '...' : ''}</div>
            </a>
        `).join('');
    }
});

// SERVICE WORKER PWA REGISTRATION
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
}
</script>
</body>
</html>
