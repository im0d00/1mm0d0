---
permalink: /manifest.json
eleventyExcludeFromCollections: true
---
{
  "name": "{{ settings.website_title or 'Aimad Security Operations Center' }}",
  "short_name": "{{ settings.portfolio_name or 'AimadSOC' }}",
  "description": "{{ settings.website_description or 'Enterprise Cybersecurity Portfolio & Research Platform' }}",
  "start_url": "{{ brand.logo_link or '/' }}",
  "display": "standalone",
  "background_color": "{{ theme.background_color or '#050810' }}",
  "theme_color": "{{ settings.theme_color or '#00D4FF' }}",
  "icons": [
    {
      "src": "{{ brand.android_icon_192 or brand.pwa_icon or brand.favicon_png or settings.favicon or '/images/favicon.png' }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "{{ brand.android_icon_512 or brand.pwa_icon or brand.favicon_png or settings.favicon or '/images/favicon.png' }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
