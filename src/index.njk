---
layout: layouts/base.njk
---

<!-- HERO SECTION -->
<section id="hero">
    <canvas id="hero-canvas" data-speed="{{ hero.bg_animation_speed or 'normal' }}" data-opacity="{{ hero.bg_animation_opacity or 0.85 }}"></canvas>
    <div class="hero-glow-spot"></div>

    <div class="hero-inner">
        <!-- LEFT COLUMN: PROFILE CARD -->
        <div class="hero-profile reveal">
            <div class="profile-card-wrap">
                <div class="profile-outer">
                    <div class="orbit orbit1"></div>
                    <div class="orbit orbit2"></div>
                    <div class="profile-inner">
                        <img src="{{ settings.profile_picture or hero.hero_image }}" alt="{{ hero.name }}"
                        onerror="this.src='https://ui-avatars.com/api/?name={{ hero.name | urlencode }}&background=0A1628&color=00E5FF&size=290&bold=true'" />
                        <span class="profile-verified-badge" title="Verified Cybersecurity Analyst">
                            <i class="fa-solid fa-circle-check"></i>
                        </span>
                    </div>
                </div>

                <div class="profile-meta-card">
                    <div class="profile-status-pill">
                        <span class="status-dot"></span>
                        <span>{{ hero.profile_card.status_text or contact.availability or "Available for Consulting" }}</span>
                    </div>

                    <div class="profile-info-rows">
                        <div class="info-row"><i class="fa-solid fa-graduation-cap info-icon"></i> <span>{{ hero.profile_card.degree or "BSc Computer Science" }}</span></div>
                        <div class="info-row"><i class="fa-solid fa-location-dot info-icon"></i> <span>{{ hero.profile_card.location or "Peshawar, Pakistan" }}</span></div>
                        <div class="info-row"><i class="fa-solid fa-shield-halved info-icon"></i> <span>{{ hero.profile_card.specialization or "Blue Team & DFIR" }}</span></div>
                        <div class="info-row"><i class="fa-solid fa-certificate info-icon"></i> <span>{{ hero.profile_card.latest_cert or "Cisco Ethical Hacking" }}</span></div>
                        <div class="info-row"><i class="fa-solid fa-crosshairs info-icon"></i> <span>{{ hero.profile_card.current_focus or "SIEM & Threat Hunting" }}</span></div>
                    </div>

                    <div class="profile-card-socs">
                        {% for soc in settings.social_media_links or hero.social_icons %}
                        <a href="{{ soc.url or soc.link }}" target="_blank" rel="noopener noreferrer" aria-label="{{ soc.platform }}"><i class="{{ soc.icon }}"></i></a>
                        {% endfor %}
                    </div>

                    <a href="{{ resume.pdf_file or hero.resume_button_link }}" download class="btn primary card-cv-btn">
                        <i class="fa-solid fa-file-pdf"></i> Download CV
                    </a>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: HERO TEXT & CONTENT -->
        <div class="hero-text reveal rv1">
            <div class="hero-eyebrow">
                <i class="fa-solid fa-user-shield"></i> {{ hero.professional_title }}
            </div>
            
            <h1 class="hero-name hero-name-animate">
                <span class="name-first">{{ hero.name }}</span> <span class="name-accent">{{ hero.name_accent }}</span>
            </h1>

            <div class="hero-role-wrap">
                <span class="role-prefix">Specialization: </span>
                <span class="hero-role" id="heroRole">{{ hero.rotating_job_titles[0] }}_</span>
            </div>

            <p class="hero-desc">
                BSc Computer Science graduate from the <strong>University of Peshawar</strong> with expertise in 
                <span class="kw-highlight">Network Security</span>, <span class="kw-highlight">Ethical Hacking</span>, 
                <span class="kw-highlight">Digital Forensics (DFIR)</span>, and <span class="kw-highlight">SOC Operations</span>. 
                Cisco-certified in Networking & Linux Essentials; trained by <strong>BlueCapeSecurity</strong>.
            </p>

            <!-- CTA BUTTON SYSTEM -->
            <div class="hero-btns">
                <a href="{{ resume.pdf_file or hero.resume_button_link }}" download class="btn primary">
                    <i class="fa-solid fa-download"></i> {{ hero.resume_button_text }}
                </a>
                <a href="{{ hero.view_projects_button_link }}" class="btn secondary">
                    <i class="fa-solid fa-folder-open"></i> {{ hero.view_projects_button_text }}
                </a>
                <a href="{{ hero.blog_button_link }}" class="btn outline">
                    <i class="fa-solid fa-pen-nib"></i> {{ hero.blog_button_text }}
                </a>
                <a href="{{ hero.contact_button_link }}" class="btn ghost">
                    <i class="fa-solid fa-paper-plane"></i> {{ hero.contact_button_text }}
                </a>
            </div>

            <!-- DASHBOARD STATISTIC CARDS -->
            <div class="hero-metrics">
                <div class="metric-card">
                    <div class="metric-header">
                        <i class="fa-solid fa-award metric-icon"></i>
                        <span class="trend-indicator"><i class="fa-solid fa-circle-check"></i> Active</span>
                    </div>
                    <div class="metric-num" data-target="{{ certifications.items | length }}">0</div>
                    <div class="metric-lbl">Certifications</div>
                </div>
                <div class="metric-card">
                    <div class="metric-header">
                        <i class="fa-solid fa-layer-group metric-icon"></i>
                        <span class="trend-indicator"><i class="fa-solid fa-arrow-trend-up"></i> Live</span>
                    </div>
                    <div class="metric-num" data-target="{{ projects.items | length }}">0</div>
                    <div class="metric-lbl">Security Projects</div>
                </div>
                <div class="metric-card">
                    <div class="metric-header">
                        <i class="fa-solid fa-flask metric-icon"></i>
                        <span class="trend-indicator"><i class="fa-solid fa-bolt"></i> Lab</span>
                    </div>
                    <div class="metric-num" data-target="{{ labs.items | length }}">0</div>
                    <div class="metric-lbl">Virtual Labs</div>
                </div>
                <div class="metric-card">
                    <div class="metric-header">
                        <i class="fa-solid fa-brain metric-icon"></i>
                        <span class="trend-indicator"><i class="fa-solid fa-fire"></i> +12h/wk</span>
                    </div>
                    <div class="metric-num" data-target="{{ dashboard.learning_hours or 600 }}" data-suffix="+">0</div>
                    <div class="metric-lbl">Learning Hours</div>
                </div>
            </div>

            <!-- TRUST BADGES BAR -->
            {% if hero.show_trust_badges != false %}
            <div class="trust-badges-bar">
                <span class="trust-title">Validated Competencies & Badges:</span>
                <div class="trust-badges-list">
                    {% for badge in hero.trust_badges %}
                    <div class="trust-badge-item" title="{{ badge.label }}">
                        <i class="{{ badge.icon }}"></i>
                        <span>{{ badge.name }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- SCROLL INDICATOR -->
    {% if hero.show_scroll_indicator != false %}
    <div class="hero-scroll-indicator" id="heroScrollIndicator">
        <a href="#about" aria-label="Scroll down to About section">
            <span class="scroll-mouse">
                <span class="scroll-wheel"></span>
            </span>
            <span class="scroll-text">EXPLORE PLATFORM</span>
            <i class="fa-solid fa-chevron-down scroll-arrow"></i>
        </a>
    </div>
    {% endif %}

    <!-- SECTION DIVIDER -->
    <div class="section-divider hero-divider"></div>
</section>

<!-- ABOUT ME -->
<section id="about" style="background:linear-gradient(180deg,transparent,rgba(11,19,40,0.35),transparent);">
    <div class="container">
        <div class="reveal"><div class="sec-eye">01 About</div><h2 class="sec-title">Who I Am</h2><div class="sec-rule"></div></div>
        <div class="about-grid">
            <div class="about-text reveal">
                <p>{{ about.biography }}</p>
                <p>{{ about.personal_description }}</p>
                <p><strong>Career Objective:</strong> {{ about.career_objectives }}</p>
                <p><strong>Experience Summary:</strong> {{ about.experience_summary }}</p>
                
                <div class="tags" style="margin-top:1.2rem;">
                    {% for skillTag in about.skills %}
                    <span class="ctag tc">{{ skillTag }}</span>
                    {% endfor %}
                </div>

                {% if about.languages | length > 0 %}
                <div style="margin-top:1.5rem; display:flex; gap:1rem; flex-wrap:wrap; font-size:0.88rem; color:var(--silver);">
                    <strong style="color:var(--white);"><i class="fa-solid fa-language"></i> Languages:</strong>
                    {% for lang in about.languages %}
                    <span>{{ lang.language }} ({{ lang.proficiency }})</span>{% if not loop.last %} • {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            <div class="stats-grid reveal rv1">
                <div class="stat-c card"><div class="stat-n">{{ hero.statistics_override.years_tech or "7+" }}</div><div class="stat-l">Years Tech</div></div>
                <div class="stat-c card"><div class="stat-n">{{ certifications.items | length }}</div><div class="stat-l">Certifications</div></div>
                <div class="stat-c card"><div class="stat-n">{{ projects.items | length }}</div><div class="stat-l">Projects Completed</div></div>
                <div class="stat-c card"><div class="stat-n">{{ dashboard.learning_hours }}+</div><div class="stat-l">Learning Hours</div></div>
            </div>
        </div>
    </div>
</section>

<!-- EDUCATION -->
<section id="education">
    <div class="container">
        <div class="reveal"><div class="sec-eye">02 Education</div><h2 class="sec-title">Academic & Training Background</h2><div class="sec-rule"></div></div>
        {% for edu in education.items %}
        <div class="edu-card card reveal {% if loop.index == 2 %}rv1{% elif loop.index == 3 %}rv2{% endif %}"><div class="card-glow"></div><div class="corner tl"></div><div class="corner br"></div>
            <div class="edu-ic ic-uni"><i class="{{ edu.institution_logo or 'fa-solid fa-graduation-cap' }}"></i></div>
            <div>
                <div class="edu-h">{{ edu.course }} — {{ edu.degree }}</div>
                <div class="edu-org">{{ edu.institution }} — {{ edu.platform }}</div>
                <div class="edu-meta">
                    <span><i class="fa-regular fa-calendar fa-xs"></i> {{ edu.start_date }} – {{ edu.end_date }}</span>
                    <span><i class="fa-solid fa-location-dot fa-xs"></i> {{ edu.location }}</span>
                    {% if edu.institution_badge %}<span class="badge b-earned"><i class="fa-solid fa-award fa-xs"></i> {{ edu.institution_badge }}</span>{% endif %}
                </div>
                <div class="edu-detail">
                    <p>{{ edu.description }}</p>
                    {% if edu.skills_learned %}<div style="margin-top:0.4rem; font-size:0.85rem;"><strong style="color:var(--white)">Skills Learned:</strong> {{ edu.skills_learned }}</div>{% endif %}
                    {% if edu.certificate_link %}<a href="{{ edu.certificate_link }}" target="_blank" style="font-size:0.85rem; margin-top:0.4rem; display:inline-block;"><i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i> View Verification</a>{% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>

<!-- CERTIFICATIONS SECTION (Dynamic Counters & Badges) -->
<section id="certifications" style="background:linear-gradient(180deg,transparent,rgba(11,19,40,0.4),transparent);">
    <div class="container">
        <div class="reveal">
            <div class="sec-eye">03 Certifications</div>
            <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:1rem;">
                <h2 class="sec-title">Credentials & Certifications</h2>
                <div class="cert-counter-badge" style="background:rgba(0,212,255,0.1); border:1px solid var(--border2); padding:0.4rem 1rem; border-radius:20px; color:var(--cyan); font-family:'JetBrains Mono',monospace; font-size:0.9rem;">
                    <i class="fa-solid fa-award"></i> {{ certifications.items | length }} Certifications Total
                </div>
            </div>
            <div class="sec-rule"></div>
        </div>

        <!-- CERTIFICATION METRICS COUNTER BAR -->
        <div class="cert-stats-grid reveal" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; margin-bottom:2rem;">
            <div class="card" style="padding:1rem 1.2rem; display:flex; align-items:center; gap:1rem; background:rgba(10,22,40,0.6);">
                <div style="width:40px; height:40px; border-radius:10px; background:rgba(0,212,255,0.15); display:flex; align-items:center; justify-content:center; color:var(--cyan); font-size:1.2rem;"><i class="fa-solid fa-certificate"></i></div>
                <div>
                    <div style="font-size:1.5rem; font-weight:700; color:var(--white); font-family:'JetBrains Mono',monospace;">{{ certifications.items | length }}</div>
                    <div style="font-size:0.78rem; color:var(--silver);">Total Certifications</div>
                </div>
            </div>
            <div class="card" style="padding:1rem 1.2rem; display:flex; align-items:center; gap:1rem; background:rgba(10,22,40,0.6);">
                <div style="width:40px; height:40px; border-radius:10px; background:rgba(0,255,136,0.15); display:flex; align-items:center; justify-content:center; color:var(--green); font-size:1.2rem;"><i class="fa-solid fa-circle-check"></i></div>
                <div>
                    <div style="font-size:1.5rem; font-weight:700; color:var(--green); font-family:'JetBrains Mono',monospace;">
                        {% set vCount = 0 %}{% for c in certifications.items %}{% if c.status == 'Verified' or c.status == 'Active' or c.status == 'Completed' %}{% set vCount = vCount + 1 %}{% endif %}{% endfor %}{{ vCount }}
                    </div>
                    <div style="font-size:0.78rem; color:var(--silver);">Verified Credentials</div>
                </div>
            </div>
            <div class="card" style="padding:1rem 1.2rem; display:flex; align-items:center; gap:1rem; background:rgba(10,22,40,0.6);">
                <div style="width:40px; height:40px; border-radius:10px; background:rgba(124,58,237,0.15); display:flex; align-items:center; justify-content:center; color:var(--violet2); font-size:1.2rem;"><i class="fa-solid fa-shield-halved"></i></div>
                <div>
                    <div style="font-size:1.5rem; font-weight:700; color:var(--violet2); font-family:'JetBrains Mono',monospace;">
                        {% set aCount = 0 %}{% for c in certifications.items %}{% if c.status == 'Active' or c.status == 'Verified' %}{% set aCount = aCount + 1 %}{% endif %}{% endfor %}{{ aCount }}
                    </div>
                    <div style="font-size:0.78rem; color:var(--silver);">Active Certifications</div>
                </div>
            </div>
            <div class="card" style="padding:1rem 1.2rem; display:flex; align-items:center; gap:1rem; background:rgba(10,22,40,0.6);">
                <div style="width:40px; height:40px; border-radius:10px; background:rgba(255,183,0,0.15); display:flex; align-items:center; justify-content:center; color:var(--amber); font-size:1.2rem;"><i class="fa-solid fa-stopwatch"></i></div>
                <div>
                    <div style="font-size:1.5rem; font-weight:700; color:var(--amber); font-family:'JetBrains Mono',monospace;">{{ dashboard.learning_hours or 350 }}+</div>
                    <div style="font-size:0.78rem; color:var(--silver);">Learning Hours Logged</div>
                </div>
            </div>
        </div>

        <div class="cert-grid">
            {% for cert in certifications.items %}
            <div class="cert-card card reveal {% if loop.index % 3 == 2 %}rv1{% elif loop.index % 3 == 0 %}rv2{% endif %}"><div class="card-glow"></div><div class="corner tl"></div><div class="corner br"></div>
                <div class="cert-top">
                    <div class="cert-logo cl-cisco"><i class="{{ cert.provider_logo or 'fa-solid fa-award' }}"></i></div>
                    <div>
                        <div class="cert-name">{{ cert.name }}</div>
                        <div class="cert-iss">{{ cert.provider }}</div>
                    </div>
                </div>
                {% if cert.badge_image %}
                <div style="margin:0.5rem 0;"><img src="{{ cert.badge_image }}" alt="{{ cert.name }} Badge" style="max-height:28px;" /></div>
                {% endif %}
                {% if cert.credential_id %}
                <div style="font-size:0.78rem; font-family:'JetBrains Mono',monospace; color:var(--muted); margin-bottom:0.4rem;">ID: {{ cert.credential_id }}</div>
                {% endif %}
                {% if cert.description %}
                <p style="font-size:0.82rem; color:var(--silver); margin:0.4rem 0 0.6rem; line-height:1.4;">{{ cert.description }}</p>
                {% endif %}
                {% if cert.skill_tags and cert.skill_tags.length > 0 %}
                <div style="display:flex; gap:0.3rem; flex-wrap:wrap; margin-bottom:0.6rem;">
                    {% for tag in cert.skill_tags %}
                    <span style="font-size:0.72rem; padding:1px 6px; border-radius:4px; background:rgba(0,212,255,0.08); border:1px solid rgba(0,212,255,0.2); color:var(--cyan);">{{ tag }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                <div class="cert-foot">
                    <span class="cert-date">Issued: {{ cert.issue_date }}</span>
                    {% if cert.status == "Verified" or cert.status == "Active" or cert.status == "Completed" %}
                    <span class="badge b-earned">{{ cert.status }}</span>
                    {% elif cert.status == "In Progress" %}
                    <span class="badge b-prog">{{ cert.status }}</span>
                    {% else %}
                    <span class="badge b-plan">{{ cert.status }}</span>
                    {% endif %}
                </div>
                <div style="display:flex; gap:0.6rem; margin-top:0.6rem; flex-wrap:wrap;">
                    {% if cert.verification_url or cert.credential_url %}
                    <a href="{{ cert.verification_url or cert.credential_url }}" target="_blank" rel="noopener noreferrer" class="plink" style="font-size:0.78rem;"><i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i> Verify Credential</a>
                    {% endif %}
                    {% if cert.certificate_pdf %}
                    <a href="{{ cert.certificate_pdf }}" download class="plink" style="font-size:0.78rem; color:var(--green);"><i class="fa-solid fa-file-pdf fa-xs"></i> Certificate PDF</a>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- TECHNICAL SKILLS SECTION -->
<section id="skills">
    <div class="container">
        <div class="reveal"><div class="sec-eye">04 Skills</div><h2 class="sec-title">Technical Skills</h2><div class="sec-rule"></div></div>
        <div class="skills-grid">
            {% for cat in skills.categories %}
            <div class="card reveal {% if loop.index % 3 == 2 %}rv1{% elif loop.index % 3 == 0 %}rv2{% endif %}" style="padding:1.4rem;"><div class="card-glow"></div><div class="corner tl"></div>
                <div class="sk-head">
                    <div class="sk-ic si1"><i class="{{ cat.icon or 'fa-solid fa-code' }}"></i></div>
                    <h3>{{ cat.category_name }}</h3>
                </div>
                {% for sk in cat.skills %}
                <div class="sk-item" onclick='openSkillModal({{ sk | dump | safe }}, "{{ cat.category_name }}")' style="cursor:pointer; transition:transform 0.2s;" title="Click for Skill Intelligence">
                    <div class="sk-meta"><span class="sk-name"><i class="fa-solid fa-circle-chevron-right fa-xs" style="color:var(--cyan); margin-right:4px;"></i> {{ sk.name }}</span><span class="sk-pct">{{ sk.percentage }}%</span></div>
                    <div class="sk-bar"><div class="sk-fill" data-w="{{ sk.percentage }}" style="width:0%; background:{{ sk.color or 'var(--cyan)' }}"></div></div>
                    {% if sk.description %}<div style="font-size:0.75rem; color:var(--muted); margin-top:0.2rem;">{{ sk.description }}</div>{% endif %}
                </div>
                {% endfor %}
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- SECURITY TOOLS & PLATFORMS -->
<section id="tools" style="background:linear-gradient(180deg,transparent,rgba(11,19,40,0.3),transparent);">
    <div class="container">
        <div class="reveal"><div class="sec-eye">05 Security Tools</div><h2 class="sec-title">Security Tools & Platforms</h2><div class="sec-rule"></div></div>
        <div class="tools-grid reveal">
            {% for tool in tools.items %}
            <div class="tool-item">
                <i class="{{ tool.icon or 'fa-solid fa-screwdriver-wrench' }}"></i>
                <span>{{ tool.name }}</span>
                <span class="tlvl">{{ tool.skill_level }}</span>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- PROJECTS SECTION (Dynamic Counter & Advanced Filter) -->
<section id="projects">
    <div class="container">
        <div class="reveal">
            <div class="sec-eye">06 Projects</div>
            <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap;">
                <h2 class="sec-title">Projects & Security Repositories</h2>
                <div style="background:rgba(0,255,136,0.1); border:1px solid rgba(0,255,136,0.3); padding:0.4rem 1rem; border-radius:20px; color:var(--green); font-family:'JetBrains Mono',monospace; font-size:0.9rem;">
                    <i class="fa-solid fa-terminal"></i> {{ (projects.items | length) + (collections.projects | length) }} Projects Completed
                </div>
            </div>
            <div class="sec-rule"></div>
        </div>

        <div class="filter-bar reveal">
            <button class="filter-btn active" onclick="filterCategory('proj', 'all', this)">All Categories</button>
            <button class="filter-btn" onclick="filterCategory('proj', 'Home Lab', this)">Home Lab</button>
            <button class="filter-btn" onclick="filterCategory('proj', 'Automation', this)">Automation</button>
            <button class="filter-btn" onclick="filterCategory('proj', 'Digital Forensics', this)">Digital Forensics</button>
            <button class="filter-btn" onclick="filterCategory('proj', 'Networking', this)">Networking</button>
            <button class="filter-btn" onclick="filterCategory('proj', 'Web Development', this)">Web App Security</button>
            <button class="filter-btn" onclick="filterCategory('proj', 'Research', this)">Research</button>
        </div>
        
        <div class="proj-grid" id="projGrid">
            {% for proj in projects.items %}
            <div class="proj-card card reveal proj-item {% if loop.index % 3 == 2 %}rv1{% elif loop.index % 3 == 0 %}rv2{% endif %}" data-category="{{ proj.category }}">
                <div class="card-glow"></div><div class="corner tl"></div><div class="corner br"></div>
                {% if proj.featured_image %}
                <div style="margin:-1.5rem -1.5rem 1rem -1.5rem; max-height:160px; overflow:hidden; border-radius:12px 12px 0 0;">
                    <img src="{{ proj.featured_image }}" alt="{{ proj.title }}" style="width:100%; height:160px; object-fit:cover;" />
                </div>
                {% endif %}
                <div class="proj-hd">
                    <div class="proj-num">// PROJECT {{ loop.index | string | padStart(2, '0') }}</div>
                    <div class="proj-type">{{ proj.category | upper }}</div>
                </div>
                <div class="proj-title">{{ proj.title }}</div>
                <p class="proj-desc">{{ proj.description }}</p>
                <div class="proj-stack">
                    {% for tech in proj.technologies %}
                    <span class="stag" data-tech="{{ tech }}">{{ tech }}</span>
                    {% endfor %}
                </div>
                <div class="proj-links" style="margin-top:1rem; display:flex; gap:0.6rem; flex-wrap:wrap;">
                    <button onclick='openProjModal({{ proj | dump | safe }})' class="plink" style="background:none; border:none; cursor:pointer;"><i class="fa-solid fa-circle-info fa-xs"></i> Full Specs</button>
                    {% if proj.github_link %}<a href="{{ proj.github_link }}" class="plink" target="_blank"><i class="fa-brands fa-github fa-xs"></i> GitHub</a>{% endif %}
                    {% if proj.live_demo %}<a href="{{ proj.live_demo }}" class="plink" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i> Live Demo</a>{% endif %}
                </div>
            </div>
            {% endfor %}
            {% for proj in collections.projects %}
            <div class="proj-card card reveal proj-item" data-category="{{ proj.data.category }}">
                <div class="card-glow"></div><div class="corner tl"></div><div class="corner br"></div>
                {% if proj.data.featured_image or proj.data.cover_image %}
                <div style="margin:-1.5rem -1.5rem 1rem -1.5rem; max-height:160px; overflow:hidden; border-radius:12px 12px 0 0;">
