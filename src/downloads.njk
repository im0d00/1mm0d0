---
layout: layouts/base.njk
title: Cybersecurity Download Hub & Resource Vault | Aimad Ul Islam
description: Download open-source security scripts, cheat sheets, incident response checklists, virtual lab topologies, and technical cheat sheets by Aimad Ul Islam.
---

<!-- HERO SECTION -->
<section id="blog-hero" aria-labelledby="dl-hero-title">
  <canvas id="blog-hero-canvas" aria-hidden="true"></canvas>
  <div class="blog-hero-inner container">
    <div class="blog-hero-eye"><i class="fa-solid fa-download"></i> Open Repository & Tooling Vault</div>
    <h1 class="blog-hero-title" id="dl-hero-title">
      Download <span class="accent">Resource Hub</span>
    </h1>
    <p class="blog-hero-sub">Direct access to open-source Python triage scripts, Volatility CLI cheat sheets, Packet Tracer network topologies, and DFIR response checklists.</p>

    <!-- Download Stats -->
    <div class="sidebar-stats-grid">
      <div class="s-stat-box card">
        <div class="s-stat-val">{{ downloads.items.length + collections.downloads.length }}</div>
        <div class="s-stat-lbl">Resources</div>
      </div>
      <div class="s-stat-box card">
        <div class="s-stat-val text-cyan">ZIP / PDF</div>
        <div class="s-stat-lbl">Formats</div>
      </div>
      <div class="s-stat-box card">
        <div class="s-stat-val">100%</div>
        <div class="s-stat-lbl">Malware-Free</div>
      </div>
      <div class="s-stat-box card">
        <div class="s-stat-val text-green">Free</div>
        <div class="s-stat-lbl">Open Access</div>
      </div>
    </div>

    <!-- Search & Filters -->
    <div class="search-filter-container card">
      <div class="search-wrap" role="search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" id="dl-search" placeholder="Search downloadable files, cheat sheets, scripts, resume, templates..." autocomplete="off" aria-label="Search downloads"/>
      </div>

      <div class="filter-controls-row">
        <div class="filter-group">
          <label for="dl-cat-select"><i class="fa-solid fa-filter"></i> Category:</label>
          <select id="dl-cat-select" class="cyber-select">
            <option value="all">All Categories</option>
            <option value="resume">Resume / CV</option>
            <option value="cheat sheet">Cheat Sheets</option>
            <option value="scripts">Scripts & Tools</option>
            <option value="checklist">Checklists</option>
            <option value="lab">Practice Lab Files</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Category Pills -->
    <div id="categories-bar" class="categories-bar-wrapper">
      <div class="categories-scroll" role="list">
        <button class="cat-btn active" data-cat="all" role="listitem"><i class="fa-solid fa-border-all fa-xs"></i> All Downloads</button>
        <button class="cat-btn" data-cat="cheat sheet" role="listitem"><i class="fa-solid fa-note-sticky fa-xs"></i> Cheat Sheets</button>
        <button class="cat-btn" data-cat="scripts" role="listitem"><i class="fa-solid fa-terminal fa-xs"></i> Automation Scripts</button>
        <button class="cat-btn" data-cat="resume" role="listitem"><i class="fa-solid fa-file-pdf fa-xs"></i> Resume & Docs</button>
      </div>
    </div>
  </div>
</section>

<!-- MAIN CONTENT -->
<main class="container">
  <section id="downloads-section" class="articles-main-section">
    <div class="section-flex-header">
      <h2 class="articles-section-title"><i class="fa-solid fa-folder-open"></i> Available Download Packages</h2>
      <span class="posts-count-badge" id="dl-count">Showing All Files</span>
    </div>

    <div id="dl-grid" class="articles-grid">
      
      <!-- Data items from JSON -->
      {% for dl in downloads.items %}
      <article class="card article-card dl-card"
               data-category="{{ (dl.category or 'General') | lower }}"
               data-name="{{ dl.name | lower }}"
               data-description="{{ dl.description | lower }}"
               data-format="{{ (dl.format or 'file') | lower }}">
        <div class="card-glow"></div>
        <div class="article-card-img-wrap" style="height: 160px;">
          <div class="article-card-img-placeholder">
            {% if (dl.format | lower) == 'pdf' %}
            <i class="fa-solid fa-file-pdf text-cyan" style="font-size: 3rem;"></i>
            {% else %}
            <i class="fa-solid fa-file-zipper text-cyan" style="font-size: 3rem;"></i>
            {% endif %}
          </div>
          <span class="card-diff-badge intermediate">{{ dl.size or "1.0 MB" }}</span>
        </div>

        <div class="article-card-body">
          <div class="article-card-tags">
            <span class="tag tag-cyber"><i class="fa-solid fa-tag"></i> {{ dl.category }}</span>
            <span class="tag tag-tut"><i class="fa-solid fa-code"></i> {{ dl.format or "PDF" }}</span>
          </div>

          <h3 class="article-card-title">{{ dl.name }}</h3>
          <p class="article-card-excerpt">{{ dl.description }}</p>

          <div class="article-card-footer" style="margin-top: 1.2rem;">
            <a href="{{ dl.file_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-cyan btn-full"><i class="fa-solid fa-download"></i> Download {{ dl.format or "File" }} ({{ dl.size }})</a>
          </div>
        </div>
      </article>
      {% endfor %}

      <!-- Markdown Collection Items from Decap CMS -->
      {% for dl in collections.downloads %}
      <article class="card article-card dl-card"
               data-category="{{ (dl.data.category or 'General') | lower }}"
               data-name="{{ (dl.data.title or dl.data.name) | lower }}"
               data-description="{{ (dl.data.description or dl.data.summary or '') | lower }}"
               data-format="{{ (dl.data.format or 'PDF') | lower }}"
               onclick="window.location='{{ dl.url }}'">
        <div class="card-glow"></div>
        <div class="article-card-img-wrap" style="height: 160px;">
          {% if dl.data.featured_image or dl.data.image %}
          <img class="article-card-img" src="{{ dl.data.featured_image or dl.data.image }}" alt="{{ dl.data.title }}" loading="lazy"/>
          {% else %}
          <div class="article-card-img-placeholder">
            <i class="fa-solid fa-download text-cyan" style="font-size: 3rem;"></i>
          </div>
          {% endif %}
          <span class="card-diff-badge intermediate">{{ dl.data.size or "Download" }}</span>
        </div>

        <div class="article-card-body">
          <div class="article-card-tags">
            <span class="tag tag-cyber"><i class="fa-solid fa-tag"></i> {{ dl.data.category or "Resource" }}</span>
            <span class="tag tag-tut text-green"><i class="fa-solid fa-circle-check"></i> {{ dl.data.format or "PDF" }}</span>
          </div>

          <h3 class="article-card-title">{{ dl.data.title or dl.data.name }}</h3>
          <p class="article-card-excerpt">{{ dl.data.description or dl.data.summary }}</p>

          <div class="article-card-footer" style="margin-top: 1.2rem;">
            <a href="{{ dl.data.file_url or dl.url }}" class="btn btn-sm btn-cyan btn-full"><i class="fa-solid fa-download"></i> Access Download Package</a>
          </div>
        </div>
      </article>
      {% endfor %}

    </div>

    <!-- No Results Fallback -->
    <div class="no-results card" id="no-dl-results" style="display:none; text-align: center; padding: 3rem 1.5rem;">
      <i class="fa-solid fa-folder-open text-cyan" style="font-size: 3rem; margin-bottom: 1rem;"></i>
      <h3>No Download Packages Match Your Query</h3>
      <p>Try searching for cheat sheets, scripts, resume, or packet tracer files.</p>
      <button class="btn btn-cyan mt-3" onclick="resetDlSearch()"><i class="fa-solid fa-rotate"></i> Reset All Filters</button>
    </div>

    <!-- Pagination Controls -->
    <div class="pagination-container" id="dl-pagination-controls">
      <!-- Dynamically rendered -->
    </div>
  </section>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const searchInput = document.getElementById("dl-search");
  const catSelect = document.getElementById("dl-cat-select");
  const catBtns = document.querySelectorAll(".cat-btn");
  const dlGrid = document.getElementById("dl-grid");
  const cards = Array.from(document.querySelectorAll(".dl-card"));
  const countBadge = document.getElementById("dl-count");
  const noResults = document.getElementById("no-dl-results");
  const paginationControls = document.getElementById("dl-pagination-controls");

  let currentSearch = "";
  let currentCat = "all";
  let currentPage = 1;
  const itemsPerPage = 6;

  function filterDownloads() {
    let filtered = cards.filter(card => {
      const name = card.getAttribute("data-name") || "";
      const desc = card.getAttribute("data-description") || "";
      const cat = card.getAttribute("data-category") || "";
      const format = card.getAttribute("data-format") || "";

      const matchSearch = currentSearch === "" || 
                          name.includes(currentSearch) || 
                          desc.includes(currentSearch) || 
                          cat.includes(currentSearch) || 
                          format.includes(currentSearch);

      const matchCat = currentCat === "all" || cat.includes(currentCat.toLowerCase()) || format.includes(currentCat.toLowerCase());

      return matchSearch && matchCat;
    });

    if (countBadge) countBadge.textContent = `${filtered.length} Files Displayed`;

    cards.forEach(c => c.style.display = "none");

    if (filtered.length === 0) {
      if (noResults) noResults.style.display = "block";
      if (paginationControls) paginationControls.innerHTML = "";
      return;
    } else {
      if (noResults) noResults.style.display = "none";
    }

    const totalPages = Math.ceil(filtered.length / itemsPerPage);
    if (currentPage > totalPages) currentPage = 1;

    const startIdx = (currentPage - 1) * itemsPerPage;
    const endIdx = startIdx + itemsPerPage;
    const pageItems = filtered.slice(startIdx, endIdx);

    pageItems.forEach(item => {
      item.style.display = "flex";
      dlGrid.appendChild(item);
    });

    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    if (!paginationControls || totalPages <= 1) {
      if (paginationControls) paginationControls.innerHTML = "";
      return;
    }

    let html = `<div class="cyber-pagination">`;
    html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" onclick="changeDlPage(${currentPage - 1})"><i class="fa-solid fa-chevron-left"></i> Prev</button>`;

    for (let i = 1; i <= totalPages; i++) {
      html += `<button class="page-num ${i === currentPage ? 'active' : ''}" onclick="changeDlPage(${i})">${i}</button>`;
    }

    html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" onclick="changeDlPage(${currentPage + 1})">Next <i class="fa-solid fa-chevron-right"></i></button>`;
    html += `</div>`;

    paginationControls.innerHTML = html;
  }

  window.changeDlPage = (page) => {
    currentPage = page;
    filterDownloads();
    document.getElementById("downloads-section").scrollIntoView({ behavior: 'smooth' });
  };

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      currentSearch = e.target.value.toLowerCase().trim();
      currentPage = 1;
      filterDownloads();
    });
  }

  if (catSelect) {
    catSelect.addEventListener("change", (e) => {
      currentCat = e.target.value;
      currentPage = 1;
      filterDownloads();
    });
  }

  catBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      catBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      currentCat = btn.getAttribute("data-cat");
      currentPage = 1;
      filterDownloads();
    });
  });

  window.resetDlSearch = () => {
    if (searchInput) searchInput.value = "";
    if (catSelect) catSelect.value = "all";
    currentSearch = "";
    currentCat = "all";
    catBtns.forEach(b => {
      if (b.getAttribute("data-cat") === "all") b.classList.add("active");
      else b.classList.remove("active");
    });
    currentPage = 1;
    filterDownloads();
  };

  filterDownloads();
});
</script>
