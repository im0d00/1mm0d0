---
permalink: /search.json
eleventyExcludeFromCollections: true
---
[
  {%- for post in collections.posts %}
  {%- if not post.data.draft and post.data.status != "Draft" %}
  {
    "type": "Blog",
    "title": {{ post.data.title | dump | safe }},
    "subtitle": {{ (post.data.subtitle or "") | dump | safe }},
    "description": {{ (post.data.excerpt or "") | dump | safe }},
    "author": {{ (post.data.author or "Aimad Ul Islam") | dump | safe }},
    "category": {{ (post.data.categories[0] or "Cybersecurity") | dump | safe }},
    "categories": {{ (post.data.categories or []) | dump | safe }},
    "tags": {{ (post.data.tags or []) | dump | safe }},
    "url": {{ post.url | dump | safe }}
  },
  {%- endif %}
  {%- endfor %}
  {%- for proj in collections.projects %}
  {
    "type": "Project",
    "title": {{ proj.data.title | dump | safe }},
    "description": {{ (proj.data.description or proj.data.problem_statement or proj.data.summary or "") | dump | safe }},
    "category": {{ (proj.data.category or "Digital Forensics") | dump | safe }},
    "tags": ["Python", "Volatility 3", "Memory Forensics", "YARA", "Incident Response", "Malware Analysis"],
    "url": {{ proj.url | dump | safe }}
  },
  {%- endfor %}
  {%- for proj in projects.items %}
  {
    "type": "Project",
    "title": {{ proj.title | dump | safe }},
    "description": {{ (proj.description or "") | dump | safe }},
    "category": {{ (proj.category or "Security Engineering") | dump | safe }},
    "tags": {{ (proj.technologies or ["Python", "Security"]) | dump | safe }},
    "url": "/projects/"
  },
  {%- endfor %}
  {%- for lab in collections.labs %}
  {
    "type": "Lab",
    "title": {{ (lab.data.title or lab.data.name) | dump | safe }},
    "description": {{ (lab.data.description or "") | dump | safe }},
    "category": {{ (lab.data.platform or "Virtual Lab") | dump | safe }},
    "tags": ["Active Directory", "SOC", "Cyber Defense", "Homelab", "Splunk", "Windows Server", "pfSense", "Detection Engineering"],
    "url": {{ lab.url | dump | safe }}
  },
  {%- endfor %}
  {%- for lab in labs.items %}
  {
    "type": "Lab",
    "title": {{ lab.name | dump | safe }},
    "description": {{ lab.description | dump | safe }},
    "category": {{ lab.platform | dump | safe }},
    "tags": {{ (lab.tools or ["Lab", "Simulation"]) | dump | safe }},
    "url": "/labs/"
  },
  {%- endfor %}
  {%- for rep in collections.research %}
  {
    "type": "Research",
    "title": {{ rep.data.title | dump | safe }},
    "description": {{ (rep.data.summary or rep.data.description or "") | dump | safe }},
    "category": {{ (rep.data.category or "Architecture & Defense") | dump | safe }},
    "tags": ["Research", "Whitepaper", "Zero Trust", "Threat Modeling", "Hybrid Networks"],
    "url": {{ rep.url | dump | safe }}
  },
  {%- endfor %}
  {%- for report in reports.items %}
  {
    "type": "Research",
    "title": {{ report.title | dump | safe }},
    "description": {{ report.summary | dump | safe }},
    "category": {{ report.category | dump | safe }},
    "tags": ["Research", "Security Report"],
    "url": "/research/"
  },
  {%- endfor %}
  {%- for dl in collections.downloads %}
  {
    "type": "Download",
    "title": {{ (dl.data.title or dl.data.name) | dump | safe }},
    "description": {{ (dl.data.description or "") | dump | safe }},
    "category": {{ (dl.data.category or "Cheatsheet") | dump | safe }},
    "tags": ["Download", {{ (dl.data.format or "PDF") | dump | safe }}],
    "url": {{ dl.url | dump | safe }}
  },
  {%- endfor %}
  {%- for cert in certifications.items %}
  {
    "type": "Certification",
    "title": {{ cert.name | dump | safe }},
    "description": {{ (cert.provider + " - " + cert.status) | dump | safe }},
    "category": "Credentials",
    "tags": [{{ cert.provider | dump | safe }}, "Certification", "Credential"],
    "url": "/#certifications"
  },
  {%- endfor %}
