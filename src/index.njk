        </div>` : ''}
    `;
    if (detailModal) detailModal.style.display = 'flex';
}

function openKbModal(item) {
    if (modalTitle) modalTitle.innerHTML = `<i class="fa-solid fa-book-journal-whills" style="color:var(--cyan);"></i> ${item.title}`;
    const tagBadges = (item.tags || []).map(t => `<span class="tech-badge"><i class="${getTechIcon(t)}"></i> ${t}</span>`).join('');
    if (modalBody) modalBody.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem; background:rgba(0,212,255,0.06); padding:0.6rem 1rem; border-radius:8px; border:1px solid var(--border);">
            <span style="color:var(--cyan); font-family:'JetBrains Mono',monospace; font-size:0.82rem;">TOPIC: ${item.category ? item.category.toUpperCase() : 'CYBERSECURITY'}</span>
            <span style="color:var(--amber); font-family:'JetBrains Mono',monospace; font-size:0.82rem; text-transform:uppercase;">[${item.difficulty || 'GENERAL'}]</span>
        </div>
        <div style="margin-bottom:1.2rem;">
            <div style="font-size:0.82rem; color:var(--muted); text-transform:uppercase; margin-bottom:0.4rem;">Executive Overview</div>
            <p style="color:var(--silver); line-height:1.6; font-size:0.95rem;">${item.summary}</p>
        </div>
        <div style="margin-bottom:1.5rem;">
            <div style="font-size:0.82rem; color:var(--muted); text-transform:uppercase; margin-bottom:0.5rem;">Key Concepts & Tags</div>
            <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">${tagBadges}</div>
        </div>
        ${item.content ? `
        <div style="background:var(--void); padding:1.2rem; border-radius:8px; border:1px solid var(--border); margin-top:1rem;">
            <div style="font-size:0.82rem; color:var(--cyan); text-transform:uppercase; font-family:'JetBrains Mono',monospace; margin-bottom:0.6rem;"><i class="fa-solid fa-code"></i> Reference Material / Guide</div>
            <pre style="white-space:pre-wrap; font-family:'JetBrains Mono',monospace; font-size:0.85rem; color:var(--silver); line-height:1.5;">${item.content}</pre>
        </div>` : ''}
    `;
    if (detailModal) detailModal.style.display = 'flex';
}
</script>

