<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if seo_title %}{{ seo_title }}{% elif title %}{% if "Aimad Ul Islam" in title %}{{ title }}{% else %}{{ title }} | Aimad Ul Islam{% endif %}{% else %}{{ settings.seo_title or settings.portfolio_name or "Aimad Ul Islam" }} | Cybersecurity Professional & Security Researcher{% endif %}</title>
    <meta name="description" content="{{ seo_description or description or excerpt or summary or settings.seo_description or settings.website_description or 'Aimad Ul Islam — Cybersecurity Professional, SOC Specialist, Network Security Engineer & Technical Researcher' }}">
    <meta name="theme-color" content="#080C1A">
    <meta name="robots" content="{% if noindex or ('/404' in page.url) or ('/admin' in page.url) %}noindex, follow{% else %}index, follow{% endif %}">
    <link rel="alternate" type="application/atom+xml" title="Aimad Ul Islam — Cybersecurity & Network Security Feed" href="https://aimadulislam.dpdns.org/feed.xml">

    <!-- Search Engine & IndexNow Verifications -->
    {% if settings.google_search_console_verification %}
    <meta name="google-site-verification" content="{{ settings.google_search_console_verification }}">
    {% endif %}
    {% if settings.bing_site_verification %}
    <meta name="msvalidate.01" content="{{ settings.bing_site_verification }}">
    {% endif %}
    {% if settings.indexnow_key %}
    <meta name="indexnow-key" content="{{ settings.indexnow_key }}">
    {% endif %}
    
    <!-- Dynamic Favicons & Icons -->
    {% set primary_favicon = settings.favicon or brand.favicon_png or brand.favicon_ico or brand.favicon_svg or '/favicon.ico' %}
    <link rel="icon" href="{{ primary_favicon }}">
    <link rel="shortcut icon" href="{{ primary_favicon }}">
    {% if brand.favicon_png or (settings.favicon and '.png' in settings.favicon) %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon or brand.favicon_png }}">
    {% endif %}
    {% if brand.favicon_svg or (settings.favicon and '.svg' in settings.favicon) %}
    <link rel="icon" type="image/svg+xml" href="{{ settings.favicon or brand.favicon_svg }}">
    {% endif %}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ brand.apple_touch_icon or primary_favicon }}">
    <link rel="manifest" href="/manifest.json">

    {% set raw_img = og_image or featured_image or image or thumbnail or brand.og_image or settings.og_image or '/images/whatsapp-image-2026-07-05-at-9.35.59-pm.jpeg' %}
    {% set clean_img = raw_img | replace(r/^\/+/, "") %}
    {% set abs_og_image = raw_img if ('http://' in raw_img or 'https://' in raw_img) else ('https://aimadulislam.dpdns.org/' + clean_img) %}

    <!-- Open Graph & Meta -->
    <meta property="og:site_name" content="{{ settings.portfolio_name or 'Aimad Security' }}">
    <meta property="og:title" content="{% if seo_title %}{{ seo_title }}{% elif title %}{% if 'Aimad' in title %}{{ title }}{% else %}{{ title }} | Aimad Security{% endif %}{% else %}{{ settings.seo_title or 'Aimad ul Islam | Cybersecurity Portfolio & Security Research' }}{% endif %}">
    <meta property="og:description" content="{{ seo_description or description or excerpt or summary or settings.seo_description or settings.website_description }}">
    <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% elif page.url == '/about/' %}profile{% else %}website{% endif %}">
    <meta property="og:url" content="{{ canonical_url or ('https://aimadulislam.dpdns.org' + page.url) }}">
    <meta property="og:image" content="{{ abs_og_image }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if seo_title %}{{ seo_title }}{% elif title %}{% if 'Aimad' in title %}{{ title }}{% else %}{{ title }} | Aimad Security{% endif %}{% else %}{{ settings.seo_title or 'Aimad ul Islam | Cybersecurity Portfolio & Security Research' }}{% endif %}">
    <meta name="twitter:description" content="{{ seo_description or description or excerpt or summary or settings.seo_description or settings.website_description }}">
    <meta name="twitter:image" content="{{ abs_og_image }}">

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ canonical_url or ('https://aimadulislam.dpdns.org' + page.url) }}">

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Aimad ul Islam Khan",
      "alternateName": [
        "Aimad ul Islam",
        "Aimad Security",
        "Aimad Khan",
        "im0d00"
      ],
      "url": "https://aimadulislam.dpdns.org/",
      "image": "{{ abs_og_image }}",
      "jobTitle": "Cybersecurity Specialist & Network Security Researcher",
      "worksFor": {
        "@type": "Organization",
        "name": "Aimad Security",
        "url": "https://aimadulislam.dpdns.org/"
      },
      "description": {{ (settings.website_description or "Aimad ul Islam Khan (Aimad Security) — Cybersecurity student, SOC analyst, and network security engineering portfolio.") | dump | safe }},
      "knowsAbout": [
        "Cybersecurity",
        "Network Security",
        "Digital Forensics & Incident Response (DFIR)",
        "Security Operations Center (SOC)",
        "Ethical Hacking",
        "Penetration Testing",
        "Linux System Administration",
        "Python Security Automation",
        "Splunk Enterprise & SIEM Triage",
        "Cisco Networking & Routing"
      ],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "University of Peshawar",
        "sameAs": "https://uop.edu.pk"
      },
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Cisco Learn-A-Thon 2026 Achievement",
          "credentialCategory": "badge",
          "recognizedBy": {
            "@type": "Organization",
            "name": "Cisco Networking Academy"
          }
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Networking Essentials",
          "credentialCategory": "certificate",
          "recognizedBy": {
            "@type": "Organization",
            "name": "Cisco Networking Academy"
          }
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Introduction to Cybersecurity",
          "credentialCategory": "certificate",
          "recognizedBy": {
            "@type": "Organization",
            "name": "Cisco Networking Academy"
          }
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Linux Essentials",
          "credentialCategory": "certificate",
          "recognizedBy": {
            "@type": "Organization",
            "name": "Linux Professional Institute & Cisco NetAcad"
          }
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Ethical Hacker",
          "credentialCategory": "certificate",
          "recognizedBy": {
            "@type": "Organization",
            "name": "Cisco Networking Academy"
          }
        }
      ],
      "sameAs": [
        "https://github.com/im0d00",
        "{{ settings.linkedin_url or 'https://linkedin.com/in/aimad-ulislam' }}",
        "{{ settings.x_url or 'https://x.com/aimadulislam' }}",
        "{{ settings.youtube_url or 'https://youtube.com/@aimadulislam' }}"
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://aimadulislam.dpdns.org/#website",
      "name": "Aimad ul Islam",
      "alternateName": ["Aimad Security", "Aimad ul Islam Khan Portfolio & Research"],
      "url": "https://aimadulislam.dpdns.org/",
      "author": {
        "@type": "Person",
        "name": "Aimad ul Islam Khan",
        "url": "https://aimadulislam.dpdns.org/"
      },
      "publisher": {
        "@type": "Person",
        "name": "Aimad ul Islam Khan",
        "url": "https://aimadulislam.dpdns.org/"
      }
    }
    </script>
    {% if page.url == "/about/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "mainEntity": {
        "@type": "Person",
        "name": "Aimad ul Islam Khan",
        "alternateName": ["Aimad ul Islam", "Aimad Security"],
        "url": "https://aimadulislam.dpdns.org/about/",
        "jobTitle": "Cybersecurity Specialist & Network Security Researcher"
      }
    }
    </script>
    {% elif page.url == "/contact/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contact Aimad ul Islam Khan | Aimad Security",
      "url": "https://aimadulislam.dpdns.org/contact/",
      "description": "Secure communication channels and incident reporting desk for Aimad ul Islam Khan."
    }
    </script>
    {% endif %}
    {% if page.url and page.url != "/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aimadulislam.dpdns.org/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {% if "/posts/" in page.url or "/blog/" in page.url %}"Blog"{% elif "/projects/" in page.url %}"Projects"{% elif "/labs/" in page.url %}"Labs"{% elif "/research/" in page.url %}"Research"{% elif "/downloads/" in page.url %}"Downloads"{% elif "/resources/" in page.url %}"Resources"{% elif "/about/" in page.url %}"About"{% elif "/contact/" in page.url %}"Contact"{% else %}{{ (title or "Page") | dump | safe }}{% endif %},
          "item": {% if "/posts/" in page.url or "/blog/" in page.url %}"https://aimadulislam.dpdns.org/blog/"{% elif "/projects/" in page.url %}"https://aimadulislam.dpdns.org/projects/"{% elif "/labs/" in page.url %}"https://aimadulislam.dpdns.org/labs/"{% elif "/research/" in page.url %}"https://aimadulislam.dpdns.org/research/"{% elif "/downloads/" in page.url %}"https://aimadulislam.dpdns.org/downloads/"{% elif "/resources/" in page.url %}"https://aimadulislam.dpdns.org/resources/"{% elif "/about/" in page.url %}"https://aimadulislam.dpdns.org/about/"{% elif "/contact/" in page.url %}"https://aimadulislam.dpdns.org/contact/"{% else %}"https://aimadulislam.dpdns.org{{ page.url }}"{% endif %}
        }
        {% if page.url != "/blog/" and page.url != "/projects/" and page.url != "/labs/" and page.url != "/research/" and page.url != "/downloads/" and page.url != "/resources/" and page.url != "/about/" and page.url != "/contact/" %},
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ (title or "Item") | dump | safe }},
          "item": "https://aimadulislam.dpdns.org{{ page.url }}"
        }
        {% endif %}
      ]
    }
    </script>
    {% endif %}
    {% if layout == "layouts/post.njk" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ (title or "") | dump | safe }},
      "description": {{ (seo_description or description or excerpt or summary or "") | dump | safe }},
      "image": {{ (og_image or featured_image or image or thumbnail or brand.og_image or settings.og_image or "/images/whatsapp-image-2026-07-05-at-9.35.59-pm.jpeg") | dump | safe }},
      "author": {
        "@type": "Person",
        "name": {{ (author or settings.author or "Aimad ul Islam") | dump | safe }},
        "url": "https://aimadulislam.dpdns.org/about/"
      },
      "datePublished": "{{ date | htmlDateString }}",
      "dateModified": "{{ (updated or last_updated or date) | htmlDateString }}",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aimadulislam.dpdns.org{{ page.url }}"
      }
    }
    </script>
    {% elif layout == "layouts/project.njk" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareSourceCode",
      "name": {{ (title or "") | dump | safe }},
      "description": {{ (description or excerpt or "") | dump | safe }},
      "programmingLanguage": {{ (technologies[0] or "Python") | dump | safe }},
      "codeRepository": {{ (github_link or settings.default_repo_url or settings.public_github_url or settings.github_url or "https://github.com/im0d00") | dump | safe }},
      "author": {
        "@type": "Person",
        "name": {{ (author or "Aimad ul Islam") | dump | safe }},
        "url": "https://aimadulislam.dpdns.org/about/"
      }
    }
    </script>
    {% elif layout == "layouts/lab.njk" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": {{ (title or name or "") | dump | safe }},
      "description": {{ (description or "") | dump | safe }},
      "author": {
        "@type": "Person",
        "name": "Aimad ul Islam Khan",
        "url": "https://aimadulislam.dpdns.org/about/"
      },
      "url": "https://aimadulislam.dpdns.org{{ page.url }}"
    }
    </script>
    {% elif layout == "layouts/research.njk" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      "headline": {{ (title or "") | dump | safe }},
      "description": {{ (summary or description or "") | dump | safe }},
      "author": {
        "@type": "Person",
        "name": {{ (author or "Aimad ul Islam") | dump | safe }},
        "url": "https://aimadulislam.dpdns.org/about/"
      },
      "datePublished": "{{ date | htmlDateString if date else '2026-03-15' }}"
    }
    </script>
    {% elif layout == "layouts/download.njk" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "DigitalDocument",
      "name": {{ (title or name or "") | dump | safe }},
      "description": {{ (description or "") | dump | safe }},
      "fileFormat": {{ (format or "PDF") | dump | safe }},
      "author": {
        "@type": "Person",
        "name": "Aimad ul Islam Khan",
        "url": "https://aimadulislam.dpdns.org/about/"
      },
      "url": "https://aimadulislam.dpdns.org{{ page.url }}"
    }
    </script>
    {% endif %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/blog.css">
    <link rel="stylesheet" href="/css/print.css" media="print">
    
    <script>
      (function() {
        var localTheme = localStorage.getItem('aimad-theme');
        if (localTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('aimad-theme', 'dark');
        }
      })();
    </script>
</head>
<body class="site-base-body">
    <div class="grid-bg"></div>
    <div class="scan-line"></div>
    <div id="reading-progress"></div>

    <!-- SHARED GLOBAL HEADER -->
    {% include "header.njk" %}

    <main id="main-content">
        {{ content | safe }}
    </main>

    <!-- SHARED GLOBAL FOOTER -->
    {% include "footer.njk" %}

    <button id="scroll-top" aria-label="Scroll to top"><i class="fa-solid fa-arrow-up"></i></button>

    <!-- SEARCH MODAL OVERLAY -->
    <div id="searchModal" role="dialog" aria-modal="true" aria-label="Website Search" style="display:none; position:fixed; inset:0; z-index:99999; background:rgba(5,8,16,0.88); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); padding:2rem 1rem; align-items:flex-start; justify-content:center; overflow-y:auto;">
        <div class="card cyber-modal-card" style="max-width:740px; width:100%; margin-top:5vh; padding:1.75rem; position:relative; border:1px solid rgba(0,217,255,0.4); background:linear-gradient(180deg, rgba(10,22,40,0.97) 0%, rgba(6,16,33,0.99) 100%); box-shadow: 0 25px 70px rgba(0,0,0,0.95), 0 0 40px rgba(8,123,255,0.35); border-radius:12px;">
            <!-- Modal Header -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem; padding-bottom:0.75rem; border-bottom:1px solid rgba(0,217,255,0.15);">
                <div style="font-family:'Space Grotesk',sans-serif; font-size:1.15rem; font-weight:700; color:var(--white); display:flex; align-items:center; gap:0.65rem;">
                    <div style="width:28px; height:28px; border-radius:6px; background:rgba(0,217,255,0.12); border:1px solid rgba(0,217,255,0.3); display:flex; align-items:center; justify-content:center; color:#00D9FF;">
                        <i class="fa-solid fa-magnifying-glass" style="font-size:0.85rem;"></i>
                    </div>
                    <span>Search Aimad Security</span>
                    <span style="font-family:'JetBrains Mono',monospace; font-size:0.68rem; color:#00D9FF; background:rgba(0,217,255,0.08); padding:2px 8px; border-radius:4px; border:1px solid rgba(0,217,255,0.25);">LIVE INDEX</span>
                </div>
                <button id="searchCloseBtn" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.15); border-radius:8px; width:34px; height:34px; color:var(--silver); font-size:1.1rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s;" aria-label="Close search (Esc)">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Search Input Box with Magnifier and Clear Button -->
            <div style="position:relative; margin-bottom:0.75rem;">
                <i class="fa-solid fa-magnifying-glass" style="position:absolute; left:1.1rem; top:50%; transform:translateY(-50%); color:#00D9FF; font-size:0.95rem; pointer-events:none;"></i>
                <input type="text" id="searchInput" placeholder="Search by title, keyword, tool, lab, research, or tag..." autocomplete="off" spellcheck="false" style="width:100%; padding:0.9rem 2.8rem 0.9rem 2.9rem; background:rgba(7,18,37,0.92); border:1.5px solid rgba(0,217,255,0.3); border-radius:10px; color:var(--white); font-family:'JetBrains Mono',monospace; font-size:0.95rem; outline:none; transition:all 0.2s; box-shadow:inset 0 2px 6px rgba(0,0,0,0.5);" />
                <button id="searchClearBtn" style="display:none; position:absolute; right:0.85rem; top:50%; transform:translateY(-50%); background:rgba(255,255,255,0.08); border:none; border-radius:50%; width:24px; height:24px; color:var(--silver); font-size:0.75rem; cursor:pointer; align-items:center; justify-content:center; transition:all 0.2s;" aria-label="Clear search input">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Keyboard shortcut guide bar -->
            <div style="display:flex; justify-content:space-between; align-items:center; padding:0 0.25rem 0.75rem; font-family:'JetBrains Mono',monospace; font-size:0.72rem; color:var(--muted); border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:0.9rem;">
                <div id="searchStats">Type keywords to search across all published records</div>
                <div style="display:flex; gap:0.6rem; align-items:center;">
                    <span><kbd class="cyber-kbd" style="font-size:0.65rem;">↑</kbd> <kbd class="cyber-kbd" style="font-size:0.65rem;">↓</kbd> navigate</span>
                    <span><kbd class="cyber-kbd" style="font-size:0.65rem;">↵</kbd> open</span>
                    <span><kbd class="cyber-kbd" style="font-size:0.65rem;">esc</kbd> close</span>
                </div>
            </div>

            <!-- Results container -->
            <div id="searchResults" role="listbox" style="max-height:430px; overflow-y:auto; display:flex; flex-direction:column; gap:0.6rem; padding-right:4px;">
                <div style="text-align:center; color:var(--muted); padding:2rem 1rem; font-size:0.9rem;">
                    <i class="fa-solid fa-terminal" style="font-size:1.8rem; color:rgba(0,217,255,0.4); margin-bottom:0.75rem; display:block;"></i>
                    Type a query to search across all published articles, labs, projects, research papers, and pages...
                </div>
            </div>
        </div>
    </div>

    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script src="/js/main.js"></script>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", function(user) {
          if (!user) {
            window.netlifyIdentity.on("login", function() {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
</body>
</html>
