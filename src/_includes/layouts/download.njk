<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or name }} | Cybersecurity Resource Download | Aimad Ul Islam</title>
    <meta name="description" content="{{ description or 'Downloadable security cheat sheet, script, or resource package by Aimad Ul Islam.' }}">
    <meta name="author" content="Aimad Ul Islam">
    <meta name="theme-color" content="#080C1A">
    
    <!-- Open Graph -->
    <meta property="og:title" content="{{ title or name }} | Aimad Ul Islam">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://aimadulislam.dpdns.org{{ page.url }}">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/blog.css">
</head>
<body class="post-page-body">
    <div class="grid-bg"></div>
    <div class="scan-line"></div>

    <!-- UNIFIED HEADER -->
    {% include "header.njk" %}

    <main class="container">
        <article class="article-hero">
            <div class="breadcrumb">
                <a href="/"><i class="fa-solid fa-house"></i> Home</a>
                <span>/</span>
                <a href="/downloads/">Downloads</a>
                <span>/</span>
                <span class="current-title">{{ title or name }}</span>
            </div>

            <div class="article-layout">
                <div class="article-main">
                    <header class="article-header card">
                        <div class="article-cats">
                            <span class="tag tag-cyber"><i class="fa-solid fa-download"></i> {{ category or "Download Package" }}</span>
                            <span class="tag tag-tut"><i class="fa-solid fa-file"></i> {{ format or "PDF" }}</span>
                            <span class="tag tag-status"><i class="fa-solid fa-hard-drive"></i> {{ size or "1.5 MB" }}</span>
                        </div>
                        
                        <h1 class="article-title">{{ title or name }}</h1>
                        
                        {% if description %}
                        <p class="article-subtitle">{{ description }}</p>
                        {% endif %}

                        {% if sha256 %}
                        <div class="sha256-box" style="margin-top: 1rem; padding: 0.75rem; background: rgba(0,0,0,0.4); border: 1px solid rgba(0,212,255,0.2); border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 0.8rem; word-break: break-all;">
                            <span style="color: var(--cyan);"><i class="fa-solid fa-shield-halved"></i> SHA256 Hash:</span> {{ sha256 }}
                        </div>
                        {% endif %}

                        <div style="margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                            {% if file_url %}
                            <a href="{{ file_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-cyan btn-sm"><i class="fa-solid fa-cloud-arrow-down"></i> Download {{ format or "Asset" }} ({{ size or "Direct" }})</a>
                            {% endif %}
                        </div>
                    </header>

                    <div class="article-body card">
                        {{ content | safe }}
                    </div>
                </div>

                <aside class="sidebar">
                    <div class="sidebar-widget card">
                        <h3 class="widget-title"><i class="fa-solid fa-circle-info"></i> Asset Spec</h3>
                        <div class="sidebar-cat-list">
                            <div class="sidebar-cat-item">
                                <span>Category:</span> <strong>{{ category or "General" }}</strong>
                            </div>
                            <div class="sidebar-cat-item">
                                <span>Format:</span> <strong>{{ format or "PDF" }}</strong>
                            </div>
                            <div class="sidebar-cat-item">
                                <span>File Size:</span> <strong>{{ size or "N/A" }}</strong>
                            </div>
                        </div>
                    </div>
                    <div class="sidebar-widget card">
                        <a href="/downloads/" class="btn btn-cyan btn-full"><i class="fa-solid fa-arrow-left"></i> Download Vault</a>
                    </div>
                </aside>
            </div>
        </article>
    </main>

    {% include "footer.njk" %}
    <script src="/js/main.js"></script>
</body>
</html>
