---
layout: layouts/base.njk
---

<div class="article-hero-wrapper">
    <div class="container">
        <!-- Top Breadcrumbs & Quick Toolbar -->
        <div class="breadcrumb-toolbar">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <a href="/"><i class="fa-solid fa-house"></i> Home</a>
                <i class="fa-solid fa-chevron-right breadcrumb-separator"></i>
                <a href="/blog/">Blog</a>
                {% if categories and categories.length > 0 %}
                <i class="fa-solid fa-chevron-right breadcrumb-separator"></i>
                <a href="/blog/?cat={{ categories[0] | urlencode }}">{{ categories[0] }}</a>
                {% endif %}
                <i class="fa-solid fa-chevron-right breadcrumb-separator"></i>
                <span class="current-title">{{ title }}</span>
            </nav>

            <div class="article-quick-tools">
                {% if github_link %}
                <a href="{{ github_link }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-xs" title="GitHub Repository"><i class="fa-brands fa-github"></i> Repository</a>
                {% endif %}
                {% if download_url %}
                <a href="{{ download_url }}" download class="btn btn-cyan btn-xs" title="Download Resource / PDF"><i class="fa-solid fa-download"></i> Assets</a>
                {% endif %}
                <a href="/blog/" class="btn btn-ghost btn-xs"><i class="fa-solid fa-arrow-left"></i> All Writeups</a>
                <button class="btn btn-ghost btn-xs copy-url-btn" data-url="https://aimadulislam.dpdns.org{{ page.url }}" title="Copy Article Link">
                    <i class="fa-solid fa-link"></i> <span class="btn-text">Share</span>
                </button>
                <button class="btn btn-ghost btn-xs" onclick="window.print()" title="Print / Export PDF">
                    <i class="fa-solid fa-print"></i> <span class="btn-text">Print</span>
                </button>
            </div>
        </div>

        <!-- Featured Cover Image / Header Banner (Single Unified Title Layout) -->
        {% set postImage = image or featured_image or thumbnail %}
        {% if postImage %}
        <div class="article-cover-container">
            <div class="article-cover-banner">
                <img src="{{ postImage }}" alt="{{ imageAlt or title }}" class="article-cover-img" />
                <div class="article-cover-overlay"></div>
                <div class="article-cover-badges">
                    <div class="cover-badge-left">
                        {% if featured or pinned %}
                        <span class="hud-badge hud-badge-cyan"><i class="fa-solid fa-star"></i> Featured Research</span>
                        {% else %}
                        <span class="hud-badge hud-badge-violet"><i class="fa-solid fa-shield-halved"></i> Security Writeup</span>
                        {% endif %}
                    </div>
                    <div class="cover-badge-right">
                        {% for cat in categories %}
                        <span class="tag tag-cyber"><i class="fa-solid fa-folder"></i> {{ cat }}</span>
                        {% endfor %}
                        <span class="difficulty-badge {{ (difficulty or 'Intermediate') | lower }}">
                            <i class="fa-solid fa-gauge-high"></i> {{ difficulty or "Intermediate" }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Unified Article Header Meta Card -->
        <header class="article-header-card card">
            <div class="card-glow"></div>
            
            <div class="article-header-meta-top">
                <div class="article-cats">
                    <span class="hud-badge hud-badge-green"><i class="fa-solid fa-terminal"></i> SEC_ID: {{ page.fileSlug | upper }}</span>
                    {% for cat in categories %}
                    <a href="/blog/?cat={{ cat | urlencode }}" class="tag tag-cyber"><i class="fa-solid fa-folder-open"></i> {{ cat }}</a>
                    {% endfor %}
                </div>
                <span class="difficulty-badge {{ (difficulty or 'Intermediate') | lower }}">
                    <i class="fa-solid fa-layer-group"></i> {{ difficulty or "Intermediate" }}
                </span>
            </div>

            <!-- Prominent H1 Article Title (Single Instance) -->
            <h1 class="article-main-title">{{ title }}</h1>

            {% if subtitle or description or excerpt %}
            <p class="article-subtitle">{{ subtitle or description or excerpt }}</p>
            {% endif %}

            <!-- High-Tech Cyber HUD Metadata Bar -->
            <div class="article-meta-hud">
                <div class="meta-hud-item">
                    <div class="meta-hud-icon"><i class="fa-solid fa-user-shield"></i></div>
                    <div class="meta-hud-info">
                        <span class="meta-hud-label">Author</span>
                        <span class="meta-hud-val">{{ author or "Aimad Ul Islam" }}</span>
                    </div>
                </div>

                <div class="meta-hud-item">
                    <div class="meta-hud-icon"><i class="fa-regular fa-calendar-check"></i></div>
                    <div class="meta-hud-info">
                        <span class="meta-hud-label">Published</span>
                        <span class="meta-hud-val">{{ date | readableDate }}</span>
                    </div>
                </div>

                {% set updatedDate = updated or last_updated %}
                {% if updatedDate %}
                <div class="meta-hud-item">
                    <div class="meta-hud-icon"><i class="fa-solid fa-rotate"></i></div>
                    <div class="meta-hud-info">
                        <span class="meta-hud-label">Last Updated</span>
                        <span class="meta-hud-val">{{ updatedDate | readableDate }}</span>
                    </div>
                </div>
                {% endif %}

                <div class="meta-hud-item">
                    <div class="meta-hud-icon"><i class="fa-regular fa-clock"></i></div>
                    <div class="meta-hud-info">
                        <span class="meta-hud-label">Est. Read Time</span>
                        <span class="meta-hud-val">{{ readingTime or 12 }} min read</span>
                    </div>
                </div>

                {% if views %}
                <div class="meta-hud-item">
                    <div class="meta-hud-icon"><i class="fa-solid fa-eye"></i></div>
                    <div class="meta-hud-info">
                        <span class="meta-hud-label">Reads / Views</span>
                        <span class="meta-hud-val">{{ views }}</span>
                    </div>
                </div>
                {% endif %}
            </div>

            {% if tags and tags.length > 0 %}
            <div class="article-tags-wrapper">
                <span class="tags-label"><i class="fa-solid fa-tags"></i> Tags:</span>
                <div class="article-tags">
                    {% for tag in tags %}
                    <a href="/blog/?tag={{ tag | urlencode }}" class="tag tag-tut">#{{ tag }}</a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </header>

        <!-- Article Layout: Main Column + Responsive Sidebar -->
        <div class="article-layout">
            <!-- Left Main Article Column -->
            <div class="article-main">
                <!-- Main Markdown Article Body -->
                <!-- Main Article Body: Handles structured content blocks OR standard markdown -->
                <div class="article-body card">
                    <div class="card-glow"></div>

                    {% if content_blocks and content_blocks.length > 0 %}
                    <div class="article-blocks-container">
                        {% for block in content_blocks %}
                            {% if block.type == "paragraph" %}
                                <div class="block-paragraph">
                                    {{ block.content | safe }}
                                </div>

                            {% elif block.type == "heading" %}
                                <div class="block-heading-wrap" style="margin-top:2.2rem; margin-bottom:1rem;">
                                    {% if block.level == "h3" %}
                                        <h3 id="sec-block-{{ loop.index }}" class="block-heading" style="font-size:1.3rem; color:var(--white); font-family:'Space Grotesk',sans-serif; font-weight:700;">{{ block.text }}</h3>
                                    {% elif block.level == "h4" %}
                                        <h4 id="sec-block-{{ loop.index }}" class="block-heading" style="font-size:1.05rem; color:var(--cyan); font-family:'JetBrains Mono',monospace; text-transform:uppercase; letter-spacing:0.05em;">{{ block.text }}</h4>
                                    {% else %}
                                        <h2 id="sec-block-{{ loop.index }}" class="block-heading" style="font-size:1.65rem; color:var(--white); font-family:'Space Grotesk',sans-serif; font-weight:700; border-bottom:1px solid var(--border); padding-bottom:0.5rem;">{{ block.text }}</h2>
                                    {% endif %}
                                    {% if block.subtitle %}
                                        <p class="block-sub" style="font-size:0.88rem; color:var(--muted); margin-top:0.3rem;">{{ block.subtitle }}</p>
                                    {% endif %}
                                </div>

                            {% elif block.type == "code_block" %}
                                <div class="code-block-wrap" style="margin:1.75rem 0;">
                                    <div class="code-block-header">
                                        <span class="code-block-filename"><i class="fa-solid fa-file-code text-cyan"></i> {{ block.filename or "script.py" }}</span>
                                        <div style="display:flex; align-items:center; gap:0.6rem;">
                                            <span class="code-block-lang">{{ (block.language or "CODE") | upper }}</span>
                                            <button class="copy-code-btn" onclick="copyCodeBlockText(this)"><i class="fa-regular fa-copy"></i> Copy</button>
                                        </div>
                                    </div>
                                    <pre><code class="language-{{ (block.language or 'text') | lower }}">{{ block.code }}</code></pre>
                                    {% if block.description %}<p class="code-block-desc" style="font-size:0.8rem; color:var(--muted); margin-top:0.4rem; font-family:'JetBrains Mono',monospace;">// {{ block.description }}</p>{% endif %}
                                </div>

                            {% elif block.type == "terminal_block" %}
                                <div class="terminal-block-wrap card" style="margin:1.75rem 0; overflow:hidden; border-radius:8px; border:1px solid var(--border);">
                                    <div class="terminal-header">
                                        <div class="terminal-dots">
                                            <span class="dot red"></span>
                                            <span class="dot yellow"></span>
                                            <span class="dot green"></span>
                                        </div>
                                        <div class="terminal-title"><i class="fa-solid fa-terminal text-green" style="margin-right:0.4rem;"></i> {{ block.title or 'Terminal' }} <span style="font-size:0.7rem; color:var(--muted);">[{{ block.os or 'Linux' }}]</span></div>
                                        <button class="copy-terminal-btn" onclick="copyCodeBlockText(this)"><i class="fa-regular fa-copy"></i> Copy Commands</button>
                                    </div>
                                    <pre class="terminal-body"><code><span class="term-prompt">root@kali:~# </span>{{ block.commands }}</code></pre>
                                    {% if block.description %}<p class="terminal-desc" style="padding:0.6rem 1.25rem; font-size:0.82rem; color:var(--muted); background:rgba(6,12,24,0.9); border-top:1px solid var(--border); font-family:'JetBrains Mono',monospace;">> {{ block.description }}</p>{% endif %}
                                </div>

                            {% elif block.type == "file_tree" %}
                                <div class="file-tree-wrap card" style="margin:1.75rem 0; border-radius:8px; overflow:hidden; border:1px solid var(--border);">
                                    <div class="file-tree-header" style="padding:0.6rem 1rem; background:rgba(15,23,42,0.8); border-bottom:1px solid var(--border); font-family:'JetBrains Mono',monospace; font-size:0.8rem; color:var(--amber);">
                                        <i class="fa-solid fa-folder-tree" style="margin-right:0.4rem;"></i> {{ block.title or 'Project Directory Tree' }}
                                    </div>
                                    <pre class="file-tree-body"><code>{{ block.tree_content }}</code></pre>
                                </div>

                            {% elif block.type == "alert" %}
                                <div class="callout callout-{{ block.alert_type or 'info' }}">
                                    <div class="callout-icon">
                                        {% if block.alert_type == 'danger' %}<i class="fa-solid fa-triangle-exclamation"></i>
                                        {% elif block.alert_type == 'warning' or block.alert_type == 'warn' %}<i class="fa-solid fa-circle-exclamation"></i>
                                        {% elif block.alert_type == 'success' %}<i class="fa-solid fa-circle-check"></i>
                                        {% elif block.alert_type == 'tip' %}<i class="fa-solid fa-lightbulb"></i>
                                        {% else %}<i class="fa-solid fa-circle-info"></i>{% endif %}
                                    </div>
                                    <div class="callout-content">
                                        {% if block.title %}<strong class="callout-title">{{ block.title }}</strong>{% endif %}
                                        <div class="callout-body"><p>{{ block.content }}</p></div>
                                    </div>
                                </div>

                            {% elif block.type == "api_endpoint" %}
                                <div class="api-endpoint-card card" style="margin:1.75rem 0; border-radius:8px; overflow:hidden; border:1px solid var(--border);">
                                    <div class="api-header">
                                        <span class="api-method method-{{ (block.method or 'GET') | lower }}">{{ block.method or 'GET' }}</span>
                                        <code class="api-path">{{ block.path }}</code>
                                    </div>
                                    <div style="padding:1.2rem;">
                                        {% if block.description %}<p style="font-size:0.9rem; color:var(--silver); margin-bottom:0.8rem;">{{ block.description }}</p>{% endif %}
                                        {% if block.headers %}
                                        <div style="margin-top:0.75rem;">
                                            <span style="font-family:'JetBrains Mono',monospace; font-size:0.72rem; color:var(--cyan); text-transform:uppercase;">Headers / Params:</span>
                                            <pre style="background:#040914; padding:0.6rem 0.8rem; border-radius:4px; font-family:'JetBrains Mono',monospace; font-size:0.8rem; color:var(--silver); margin-top:0.3rem;"><code>{{ block.headers }}</code></pre>
                                        </div>
                                        {% endif %}
                                        {% if block.request_body %}
                                        <div style="margin-top:0.75rem;">
                                            <span style="font-family:'JetBrains Mono',monospace; font-size:0.72rem; color:var(--green); text-transform:uppercase;">Request Body:</span>
                                            <pre style="background:#040914; padding:0.6rem 0.8rem; border-radius:4px; font-family:'JetBrains Mono',monospace; font-size:0.8rem; color:var(--green); margin-top:0.3rem;"><code>{{ block.request_body }}</code></pre>
                                        </div>
                                        {% endif %}
                                        {% if block.response_example %}
                                        <div style="margin-top:0.75rem;">
                                            <span style="font-family:'JetBrains Mono',monospace; font-size:0.72rem; color:var(--amber); text-transform:uppercase;">Response Example:</span>
                                            <pre style="background:#040914; padding:0.6rem 0.8rem; border-radius:4px; font-family:'JetBrains Mono',monospace; font-size:0.8rem; color:var(--silver); margin-top:0.3rem;"><code>{{ block.response_example }}</code></pre>
                                        </div>
                                        {% endif %}
                                    </div>
                                </div>

                            {% elif block.type == "quote" %}
                                <blockquote class="custom-quote">
                                    <p>"{{ block.quote }}"</p>
                                    {% if block.author %}<cite>— {{ block.author }}{% if block.cite %}, <span style="color:var(--muted);">{{ block.cite }}</span>{% endif %}</cite>{% endif %}
                                </blockquote>

                            {% elif block.type == "table" %}
                                <div class="table-responsive">
                                    <table class="custom-table">
                                        {% if block.caption %}<caption style="font-family:'JetBrains Mono',monospace; font-size:0.75rem; color:var(--muted); margin-bottom:0.5rem; caption-side:bottom;">{{ block.caption }}</caption>{% endif %}
                                        {% if block.headers and block.headers.length > 0 %}
                                        <thead>
                                            <tr>
                                                {% for h in block.headers %}<th>{{ h }}</th>{% endfor %}
                                            </tr>
                                        </thead>
                                        {% endif %}
                                        {% if block.rows %}
                                        <tbody>
                                            {% for row in block.rows %}
                                            <tr>
                                                {% for cell in row.cells or row %}
                                                <td>{{ cell }}</td>
                                                {% endfor %}
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                        {% endif %}
                                    </table>
                                </div>

                            {% elif block.type == "image_block" %}
                                <figure class="article-figure" style="margin:1.75rem 0; text-align:center;">
                                    <img src="{{ block.image }}" alt="{{ block.alt or block.caption or 'Article Image' }}" style="max-width:100%; border-radius:8px; border:1px solid var(--border); cursor:zoom-in;" onclick="openLightboxImage('{{ block.image }}', '{{ block.caption or '' }}')" />
                                    {% if block.caption %}<figcaption style="font-family:'JetBrains Mono',monospace; font-size:0.75rem; color:var(--muted); margin-top:0.5rem;"><i class="fa-solid fa-camera text-cyan"></i> {{ block.caption }}</figcaption>{% endif %}
                                </figure>

                            {% elif block.type == "gallery_block" %}
                                <div class="article-gallery-block" style="margin:2rem 0;">
                                    {% if block.title %}<h4 style="font-family:'Space Grotesk',sans-serif; font-size:1.1rem; color:var(--white); margin-bottom:1rem;"><i class="fa-solid fa-images text-cyan"></i> {{ block.title }}</h4>{% endif %}
                                    <div class="gallery-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem;">
                                        {% for img in block.images %}
                                        <div class="gallery-item card" style="overflow:hidden; border-radius:8px; cursor:zoom-in; border:1px solid var(--border2); background:rgba(10,22,40,0.6);" onclick="openLightboxImage('{{ img }}', 'Gallery Image')">
                                            <img src="{{ img }}" alt="Gallery Image" style="width:100%; height:140px; object-fit:cover;" />
                                        </div>
                                        {% endfor %}
                                    </div>
                                </div>

                            {% elif block.type == "video_block" %}
                                <div class="video-embed-wrap" style="margin:1.75rem 0; border-radius:8px; overflow:hidden; border:1px solid var(--border); background:#000;">
                                    <div style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden;">
                                        <iframe src="{{ block.embed_url }}" title="{{ block.caption or 'Video' }}" style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;" allowfullscreen></iframe>
                                    </div>
                                    {% if block.caption %}<p style="padding:0.6rem 1rem; font-family:'JetBrains Mono',monospace; font-size:0.75rem; color:var(--muted); text-align:center;">{{ block.caption }}</p>{% endif %}
                                </div>

                            {% elif block.type == "checklist" %}
                                <div class="checklist-block card" style="padding:1.2rem 1.5rem; margin:1.75rem 0; border:1px solid var(--border);">
                                    {% if block.title %}<h4 style="font-family:'Space Grotesk',sans-serif; font-size:1.05rem; color:var(--white); margin-bottom:0.8rem;"><i class="fa-solid fa-list-check text-cyan"></i> {{ block.title }}</h4>{% endif %}
                                    <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.5rem;">
                                        {% for item in block.items %}
                                        <li style="display:flex; align-items:center; gap:0.6rem; font-size:0.92rem; color:var(--silver);">
                                            <i class="fa-solid {% if item.checked %}fa-square-check text-green{% else %}fa-square text-muted{% endif %}"></i>
                                            <span style="{% if item.checked %}text-decoration:line-through; opacity:0.7;{% endif %}">{{ item.text }}</span>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </div>

                            {% elif block.type == "divider" %}
                                <hr class="article-divider divider-{{ block.style or 'glow' }}" style="margin:2.2rem 0; border:none; border-top:1px solid var(--border);" />
                            {% endif %}
                        {% endfor %}
                    </div>
                    {% else %}
                        {{ content | safe }}
                    {% endif %}

                    {% if gallery and gallery.length > 0 %}
                    <div class="article-gallery-section" style="margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid var(--border);">
                        <h3 style="font-size:1.15rem; color:var(--white); margin-bottom:1.2rem; display:flex; align-items:center; gap:0.6rem; font-family:'Space Grotesk',sans-serif;">
                            <i class="fa-solid fa-images text-cyan"></i> Research Evidence & Figure Gallery
                        </h3>
                        <div class="gallery-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem;">
                            {% for img in gallery %}
                            <div class="gallery-item card" style="overflow:hidden; border-radius:8px; cursor:zoom-in; border:1px solid var(--border2); background:rgba(10,22,40,0.6);" onclick="openLightboxImage('{{ img }}', 'Research Evidence Figure')">
                                <img src="{{ img }}" alt="Research Evidence Figure" style="width:100%; height:140px; object-fit:cover; transition:transform 0.3s;" />
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {% if external_resources and external_resources.length > 0 %}
                    <div class="article-references-section" style="margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid var(--border);">
                        <h3 style="font-size:1.15rem; color:var(--white); margin-bottom:1.2rem; display:flex; align-items:center; gap:0.6rem; font-family:'Space Grotesk',sans-serif;">
                            <i class="fa-solid fa-book-bookmark text-cyan"></i> External Resources & Citations
                        </h3>
                        <ul class="references-list" style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.6rem;">
                            {% for res in external_resources %}
                            <li style="padding:0.75rem 1.2rem; background:rgba(10,22,40,0.6); border:1px solid var(--border2); border-radius:8px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.6rem;">
                                <span style="color:var(--white); font-weight:600; font-size:0.92rem;"><i class="fa-solid fa-link text-cyan" style="font-size:0.85rem; margin-right:0.4rem;"></i> {{ res.title }}</span>
                                <a href="{{ res.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-xs btn-outline" style="font-size:0.78rem;">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Resource
                                </a>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                </div>

                <!-- Social Share Bar -->
                <div class="social-share card">
                    <div class="share-header">
                        <i class="fa-solid fa-share-nodes text-cyan"></i>
                        <span class="share-label">Share Writeup:</span>
                    </div>
                    <div class="share-buttons">
                        <a href="https://x.com/intent/tweet?text={{ title | urlencode }}&url=https://aimadulislam.dpdns.org{{ page.url }}" target="_blank" rel="noopener noreferrer" class="share-btn twitter" aria-label="Share on X (Twitter)" title="Share on X">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>
                        <a href="https://www.linkedin.com/shareArticle?mini=true&url=https://aimadulislam.dpdns.org{{ page.url }}&title={{ title | urlencode }}" target="_blank" rel="noopener noreferrer" class="share-btn linkedin" aria-label="Share on LinkedIn" title="Share on LinkedIn">
                            <i class="fa-brands fa-linkedin-in"></i>
                        </a>
                        <a href="https://t.me/share/url?url=https://aimadulislam.dpdns.org{{ page.url }}&text={{ title | urlencode }}" target="_blank" rel="noopener noreferrer" class="share-btn telegram" aria-label="Share on Telegram" title="Share on Telegram">
                            <i class="fa-brands fa-telegram"></i>
                        </a>
                        <a href="https://api.whatsapp.com/send?text={{ title | urlencode }}%20https://aimadulislam.dpdns.org{{ page.url }}" target="_blank" rel="noopener noreferrer" class="share-btn whatsapp" aria-label="Share on WhatsApp" title="Share on WhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>
                        <button class="share-btn copy-url copy-url-btn" data-url="https://aimadulislam.dpdns.org{{ page.url }}" aria-label="Copy Direct Article Link" title="Copy Article Link">
                            <i class="fa-solid fa-link"></i> <span class="share-btn-text">Copy Link</span>
                        </button>
                    </div>
                </div>

                <!-- Cybersecurity Specialist Author Box -->
                <div class="author-box card">
                    <div class="card-glow"></div>
                    <div class="author-avatar-wrap">
                        <div class="author-avatar-inner">
                            {% if author_avatar %}
                            <img src="{{ author_avatar }}" alt="{{ author or 'Aimad Ul Islam' }}" class="author-avatar-img" />
                            {% else %}
                            <i class="fa-solid fa-user-shield"></i>
                            {% endif %}
                        </div>
                        <span class="author-verified-dot" title="Verified Security Researcher"></span>
                    </div>
                    <div class="author-info">
                        <div class="author-header">
                            <div>
                                <h3 class="author-name">{{ author or "Aimad Ul Islam" }}</h3>
                                <span class="author-role">Cybersecurity Practitioner & SOC Analyst</span>
                            </div>
                            <a href="/#contact" class="btn btn-xs btn-outline"><i class="fa-solid fa-paper-plane"></i> Contact Author</a>
                        </div>
                        <p class="author-bio">
                            Cybersecurity professional specializing in DFIR investigations, SOC operations, SIEM automation, and threat research. Documenting ethical hacking labs, network architecture, and security policies.
                        </p>
                        <div class="author-links">
                            <a href="{{ contact.github or settings.github_url or 'https://github.com/im0d00' }}" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-github"></i> GitHub</a>
                            <a href="https://linkedin.com/in/aimadulislam" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-linkedin"></i> LinkedIn</a>
                            <a href="/resources/"><i class="fa-solid fa-shield-halved"></i> Resources</a>
                        </div>
                    </div>
                </div>

                <!-- Prev / Next Post Navigation -->
                {% set previousPost = collections.posts | getPreviousCollectionItem(page) %}
                {% set nextPost = collections.posts | getNextCollectionItem(page) %}
                <nav class="article-nav" aria-label="Article navigation">
                    {% if previousPost %}
                    <a href="{{ previousPost.url }}" class="article-nav-link prev card">
                        <div class="card-glow"></div>
                        <span class="article-nav-dir"><i class="fa-solid fa-arrow-left"></i> Previous Writeup</span>
                        <div class="article-nav-title">{{ previousPost.data.title }}</div>
                    </a>
                    {% else %}
                    <div class="article-nav-empty"></div>
                    {% endif %}

                    {% if nextPost %}
                    <a href="{{ nextPost.url }}" class="article-nav-link next card">
                        <div class="card-glow"></div>
                        <span class="article-nav-dir">Next Writeup <i class="fa-solid fa-arrow-right"></i></span>
                        <div class="article-nav-title">{{ nextPost.data.title }}</div>
                    </a>
                    {% endif %}
                </nav>

                <!-- Related Research Section -->
                <div class="related-posts-section">
                    <div class="related-header">
                        <h3 class="related-title"><i class="fa-solid fa-layer-group text-cyan"></i> Recommended Writeups</h3>
                        <a href="/blog/" class="btn btn-ghost btn-xs">View All Research <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                    <div class="related-grid">
                        {% set relCount = 0 %}
                        {% for post in collections.posts %}
                            {% if relCount < 3 and post.url != page.url %}
                            <a href="{{ post.url }}" class="card related-card">
                                <div class="card-glow"></div>
                                <div class="related-card-meta">
                                    <span class="tag tag-cyber"><i class="fa-solid fa-tag"></i> {{ post.data.categories[0] or "Security" }}</span>
                                    <span class="related-date"><i class="fa-regular fa-calendar"></i> {{ post.date | readableDate }}</span>
                                </div>
                                <h4 class="related-card-title">{{ post.data.title }}</h4>
                                <p class="related-card-desc">{{ post.data.subtitle or post.data.description or post.data.excerpt or "Explore technical analysis and security research." }}</p>
                            </a>
                            {% set relCount = relCount + 1 %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <!-- Peer Review & Discussion / Comments Placeholder Section -->
                <div class="comments-section card">
                    <div class="card-glow"></div>
                    <div class="comments-header">
                        <div class="comments-title-wrap">
                            <i class="fa-solid fa-comments text-cyan comments-icon"></i>
                            <div>
                                <h3 class="comments-title">Peer Review & Threat Discussion</h3>
                                <p class="comments-sub">Join the technical conversation or share insights regarding this writeup.</p>
                            </div>
                        </div>
                        <span class="hud-badge hud-badge-violet"><i class="fa-solid fa-lock"></i> Giscus / Disqus Ready</span>
                    </div>
                    
                    <div id="comments-container" class="comments-placeholder">
                        <div class="comments-placeholder-inner">
                            <i class="fa-solid fa-terminal text-muted" style="font-size: 2.2rem; margin-bottom: 0.8rem;"></i>
                            <p>Interactive peer discussions are powered by GitHub Discussions / Giscus.</p>
                            <a href="{{ contact.github or settings.github_url or 'https://github.com/im0d00' }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline mt-1">
                                <i class="fa-brands fa-github"></i> Open Discussion on GitHub
                            </a>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Sticky Sidebar -->
            <aside class="sidebar">
                <!-- Dynamic Table of Contents Widget -->
                <div class="sidebar-widget card" id="toc-widget">
                    <div class="card-glow"></div>
                    <div class="widget-title">
                        <span><i class="fa-solid fa-list-check text-cyan"></i> Table of Contents</span>
                        <span class="toc-count-badge" id="toc-count">0 sections</span>
                    </div>
                    <nav id="toc-list" class="toc-list"></nav>
                </div>

                <!-- Quick Author Widget -->
                <div class="sidebar-widget card">
                    <div class="card-glow"></div>
                    <h3 class="widget-title"><i class="fa-solid fa-user-shield text-cyan"></i> Research Author</h3>
                    <div class="sidebar-author-row">
                        <div class="author-avatar-inner" style="width:48px; height:48px; font-size:1.1rem;">
                            {% if author_avatar %}
                            <img src="{{ author_avatar }}" alt="{{ author or 'Aimad Ul Islam' }}" class="author-avatar-img" />
                            {% else %}
                            <i class="fa-solid fa-user-shield"></i>
                            {% endif %}
                        </div>
                        <div>
                            <div class="sidebar-author-name">{{ author or "Aimad Ul Islam" }}</div>
                            <div class="sidebar-author-title">SOC Specialist & DFIR Researcher</div>
                        </div>
                    </div>
                </div>

                <!-- Recent Writeups Widget -->
                <div class="sidebar-widget card">
                    <div class="card-glow"></div>
                    <h3 class="widget-title"><i class="fa-solid fa-fire text-amber"></i> Recent Research</h3>
                    <div class="sidebar-posts">
                        {% set count = 0 %}
                        {% for post in collections.posts %}
                            {% if count < 4 and post.url != page.url %}
                            <a href="{{ post.url }}" class="sidebar-post">
                                <div class="sidebar-post-thumb">
                                    {% if post.data.image or post.data.featured_image or post.data.thumbnail %}
                                    <img src="{{ post.data.image or post.data.featured_image or post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy" />
                                    {% else %}
                                    <span class="thumb-emoji">{{ post.data.emoji or '🔬' }}</span>
                                    {% endif %}
                                </div>
                                <div class="sidebar-post-content">
                                    <h4 class="sidebar-post-title">{{ post.data.title }}</h4>
                                    <span class="sidebar-post-meta"><i class="fa-regular fa-calendar"></i> {{ post.date | readableDate }}</span>
                                </div>
                            </a>
                            {% set count = count + 1 %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <!-- Categories List Widget -->
                <div class="sidebar-widget card">
                    <div class="card-glow"></div>
                    <h3 class="widget-title"><i class="fa-solid fa-folder-tree text-cyan"></i> Research Categories</h3>
                    <div class="sidebar-cat-list">
                        {% for cat in collections.categories %}
                        {% set count = collections.categoryCounts[cat] or 1 %}
                        <a href="/blog/?cat={{ cat | urlencode }}" class="sidebar-cat-item">
                            <span><i class="fa-solid fa-folder-open text-cyan" style="font-size:0.75rem;"></i> {{ cat }}</span>
                            <span class="sidebar-cat-count">{{ count }}</span>
                        </a>
                        {% endfor %}
                    </div>
                </div>

                <!-- Security Advisory / Governance Center Link -->
                <div class="sidebar-widget card">
                    <div class="card-glow"></div>
                    <h3 class="widget-title"><i class="fa-solid fa-shield-halved text-cyan"></i> Security Center</h3>
                    <p class="widget-desc">Review security disclosures, download vulnerability advisories, or inspect open source tooling.</p>
                    <a href="/resources/" class="btn btn-sm btn-outline btn-full mt-1">
                        <i class="fa-solid fa-folder-open"></i> Governance & Policies
                    </a>
                </div>

                <!-- Newsletter / Threat Alerts Form -->
                <div class="sidebar-widget card">
                    <div class="card-glow"></div>
                    <h3 class="widget-title"><i class="fa-solid fa-bell text-violet"></i> Security Alerts</h3>
                    <p class="widget-desc">Subscribe for instant notifications when new security writeups or lab walkthroughs are released.</p>
                    <form class="newsletter-form mt-1" onsubmit="event.preventDefault(); alert('Subscribed to Security Alerts feed!'); this.reset();">
                        <input type="email" class="newsletter-input" placeholder="secops@domain.com" required aria-label="Email address for security updates" />
                        <button type="submit" class="newsletter-btn"><i class="fa-solid fa-paper-plane"></i> Subscribe</button>
                    </form>
                </div>
            </aside>
        </div>
    </div>
</div>

<!-- Lightbox Modal Overlay for Images -->
<div id="imageLightbox" class="lightbox-modal" style="display:none;" onclick="closeLightbox()">
    <span class="lightbox-close">&times;</span>
    <img id="lightboxImg" class="lightbox-content" alt="Enlarged figure view" />
    <div id="lightboxCaption" class="lightbox-caption"></div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. Copy URL functionality for all copy buttons
        document.querySelectorAll('.copy-url-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const url = this.getAttribute('data-url') || window.location.href;
                navigator.clipboard.writeText(url).then(() => {
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<i class="fa-solid fa-check text-green"></i> <span class="btn-text">Copied!</span>';
                    setTimeout(() => {
                        this.innerHTML = originalHtml;
                    }, 2200);
                }).catch(() => {
                    alert('Copied URL: ' + url);
                });
            });
        });

        // 2. Wrap Markdown code blocks with copy bar and language label
        const articleBody = document.querySelector('.article-body');
        if (articleBody) {
            const preBlocks = articleBody.querySelectorAll('pre');
            preBlocks.forEach((pre, idx) => {
                if (pre.parentElement.classList.contains('code-block-wrap')) return;

                const code = pre.querySelector('code');
                let lang = 'CODE';
                if (code) {
                    const match = code.className.match(/language-([a-zA-Z0-9_\-]+)/);
                    if (match) {
                        lang = match[1].toUpperCase();
                    }
                }

                const wrapper = document.createElement('div');
                wrapper.className = 'code-block-wrap';

                const header = document.createElement('div');
                header.className = 'code-block-header';
                header.innerHTML = `
                    <span class="code-block-lang"><i class="fa-solid fa-terminal"></i> ${lang}</span>
                    <button class="copy-code-btn" aria-label="Copy code block">
                        <i class="fa-regular fa-copy"></i> Copy
                    </button>
                `;

                pre.parentNode.insertBefore(wrapper, pre);
                wrapper.appendChild(header);
                wrapper.appendChild(pre);

                const copyBtn = header.querySelector('.copy-code-btn');
                copyBtn.addEventListener('click', () => {
                    const codeText = pre.innerText || pre.textContent;
                    navigator.clipboard.writeText(codeText).then(() => {
                        copyBtn.innerHTML = '<i class="fa-solid fa-check text-green"></i> Copied!';
                        copyBtn.classList.add('copied');
                        setTimeout(() => {
                            copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy';
                            copyBtn.classList.remove('copied');
                        }, 2000);
                    });
                });
            });

            // Click-to-zoom Lightbox for Article Images
            const images = articleBody.querySelectorAll('img');
            images.forEach(img => {
                img.style.cursor = 'zoom-in';
                img.addEventListener('click', () => {
                    const lightbox = document.getElementById('imageLightbox');
                    const lightboxImg = document.getElementById('lightboxImg');
                    const lightboxCaption = document.getElementById('lightboxCaption');
                    if (lightbox && lightboxImg) {
                        lightbox.style.display = 'flex';
                        lightboxImg.src = img.src;
                        if (lightboxCaption) {
                            lightboxCaption.textContent = img.alt || img.title || 'Image view';
                        }
                    }
                });
            });
        }

        // 3. Dynamic Table of Contents Generator + Live Scroll Spy Highlight
        const tocWidget = document.getElementById('toc-widget');
        const tocList = document.getElementById('toc-list');
        const tocCount = document.getElementById('toc-count');

        if (articleBody && tocList) {
            const headings = articleBody.querySelectorAll('h2, h3');
            if (headings.length === 0) {
                if (tocWidget) tocWidget.style.display = 'none';
            } else {
                if (tocCount) tocCount.textContent = headings.length + ' sections';
                
                const tocLinks = [];

                headings.forEach((h, idx) => {
                    if (!h.id) {
                        h.id = 'sec-' + idx + '-' + h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                    }

                    const li = document.createElement('li');
                    li.className = 'toc-item ' + (h.tagName.toLowerCase() === 'h3' ? 'h3' : 'h2');

                    const link = document.createElement('a');
                    link.href = '#' + h.id;
                    link.innerHTML = `<i class="fa-solid fa-angle-right toc-bullet"></i> ${h.textContent.replace(/^#+\s*/, '')}`;
                    
                    link.addEventListener('click', (e) => {
                        e.preventDefault();
                        const target = document.getElementById(h.id);
                        if (target) {
                            const offset = 95;
                            const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
                            window.scrollTo({ top: targetPosition, behavior: 'smooth' });
                            history.pushState(null, null, '#' + h.id);
                        }
                    });

                    li.appendChild(link);
                    tocList.appendChild(li);
                    tocLinks.push({ heading: h, link: link });
                });

                // Scroll Spy for TOC active link
                const observerOptions = {
                    root: null,
                    rootMargin: '-100px 0px -65% 0px',
                    threshold: 0
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const id = entry.target.id;
                            tocLinks.forEach(item => {
                                if (item.heading.id === id) {
                                    item.link.classList.add('active');
                                    item.link.parentElement.classList.add('active');
                                } else {
                                    item.link.classList.remove('active');
                                    item.link.parentElement.classList.remove('active');
                                }
                            });
                        }
                    });
                }, observerOptions);

                headings.forEach(h => observer.observe(h));
            }
        }

        // 4. Reading Progress Bar
        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            const progress = document.getElementById('reading-progress');
            if (progress) progress.style.width = scrolled + '%';
        });
    });

    function closeLightbox() {
        const lightbox = document.getElementById('imageLightbox');
        if (lightbox) lightbox.style.display = 'none';
    }

    function openLightboxImage(src, caption) {
        const lightbox = document.getElementById('imageLightbox');
        const lightboxImg = document.getElementById('lightboxImg');
        const lightboxCaption = document.getElementById('lightboxCaption');
        if (lightbox && lightboxImg) {
            lightbox.style.display = 'flex';
            lightboxImg.src = src;
            if (lightboxCaption) {
                lightboxCaption.textContent = caption || 'Image view';
            }
        }
    }

    function copyCodeBlockText(btn) {
        if (!btn) return;
        const parent = btn.closest('.code-block-wrap') || btn.closest('.terminal-block-wrap');
        let codeText = '';
        if (parent) {
            const pre = parent.querySelector('pre');
            if (pre) codeText = pre.innerText || pre.textContent;
        }
        if (!codeText) return;

        navigator.clipboard.writeText(codeText.trim()).then(() => {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-check text-green"></i> Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.classList.remove('copied');
            }, 2000);
        }).catch(() => {
            alert('Code copied!');
        });
    }
</script>
