<script>
// LOADER
const statuses = ['Initializing security modules...', 'Loading profile data...', 'Establishing secure connection...', 'Verifying credentials...', 'Rendering interface...', 'System ready.'];
let si = 0;
const lstat = document.getElementById('lstat');
const sint = setInterval(() => { if (si < statuses.length - 1) { si++; lstat.textContent = statuses[si]; } }, 350);
window.addEventListener('load', () => {
    clearInterval(sint);
    lstat.textContent = 'System ready.';
    setTimeout(() => document.getElementById('loader').classList.add('hide'), 1200);
});

// HERO CANVAS
(() => {
    const c = document.getElementById('hero-canvas'), ctx = c.getContext('2d');
    let W, H, nodes = [];
    const N = 52;
    function resize() { W = c.width = c.offsetWidth; H = c.height = c.offsetHeight; }
    window.addEventListener('resize', resize);
    resize();
    for (let i = 0; i < N; i++) nodes.push({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .38, vy: (Math.random() - .5) * .38, r: Math.random() * 1.7 + 1, p: Math.random() * Math.PI * 2, t: Math.random() > .72 ? 'v' : 'c' });
    function draw() {
        ctx.clearRect(0, 0, W, H);
        nodes.forEach(n => { n.x += n.vx; n.y += n.vy; n.p += .017; if (n.x < 0 || n.x > W) n.vx *= -1; if (n.y < 0 || n.y > H) n.vy *= -1; });
        for (let i = 0; i < N; i++) for (let j = i + 1; j < N; j++) {
            const dx = nodes[i].x - nodes[j].x, dy = nodes[i].y - nodes[j].y, d = Math.sqrt(dx * dx + dy * dy);
            if (d < 175) {
                const a = (1 - d / 175) * .22;
                ctx.strokeStyle = nodes[i].t === 'c' ? `rgba(0,212,255,${a})` : `rgba(167,139,250,${a})`;
                ctx.lineWidth = .55; ctx.beginPath(); ctx.moveTo(nodes[i].x, nodes[i].y); ctx.lineTo(nodes[j].x, nodes[j].y); ctx.stroke();
            }
        }
        nodes.forEach(n => {
            const p = .5 + .5 * Math.sin(n.p);
            ctx.beginPath(); ctx.arc(n.x, n.y, n.r * (.65 + .35 * p), 0, Math.PI * 2);
            ctx.fillStyle = n.t === 'c' ? `rgba(0,212,255,${p*.75})` : `rgba(167,139,250,${p*.65})`;
            ctx.fill();
        });
        requestAnimationFrame(draw);
    }
    draw();
})();

// NAV HIGHLIGHTING & MOBILE NAV
window.addEventListener('scroll', () => {
    const secs = document.querySelectorAll('section[id]');
    const links = document.querySelectorAll('.nav-links a');
    let cur = '';
    secs.forEach(s => { if (window.scrollY >= s.offsetTop - 130) cur = s.id; });
    links.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '/#' + cur || a.getAttribute('href') === '#' + cur));
});
document.getElementById('ham').addEventListener('click', () => document.getElementById('mobNav').classList.toggle('open'));
document.querySelectorAll('.mobile-nav a').forEach(a => a.addEventListener('click', () => document.getElementById('mobNav').classList.remove('open')));

// HERO ROLE TYPEWRITER
const roles = {{ hero.rotating_job_titles | dump | safe }};
let ri = 0;
const roleEl = document.getElementById('heroRole');
if (roleEl && roles.length > 0) {
    setInterval(() => {
        roleEl.style.opacity = '0';
        roleEl.style.transform = 'translateY(-10px)';
        setTimeout(() => {
            ri = (ri + 1) % roles.length;
            roleEl.textContent = roles[ri] + '_';
            roleEl.style.transition = 'opacity .4s,transform .4s';
            roleEl.style.opacity = '1';
            roleEl.style.transform = 'none';
        }, 300);
    }, 2800);
}

// SCROLL REVEAL & SKILL BARS
const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: .1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

const sobs = new IntersectionObserver(entries => {
    entries.forEach(e => {
        if (e.isIntersecting) {
            e.target.querySelectorAll('.sk-fill[data-w]').forEach(b => {
                setTimeout(() => { b.style.width = b.dataset.w + '%'; }, 200);
            });
            sobs.unobserve(e.target);
        }
    });
}, { threshold: .2 });
document.querySelectorAll('.card').forEach(c => { if (c.querySelector('.sk-fill')) sobs.observe(c); });

// CONTACT FORM HANDLER
function handleForm(e) {
    const endpoint = "{{ contact.contact_form_endpoint }}";
    if (!endpoint || endpoint === '#' || endpoint === '') {
        e.preventDefault();
        const txt = `Name: ${document.getElementById('cn').value}\nEmail: ${document.getElementById('ce').value}\nOrg: ${document.getElementById('co').value}\nType: ${document.getElementById('ct').value}\n\nMessage:\n${document.getElementById('cm').value}`;
        navigator.clipboard.writeText(txt).catch(() => {});
        document.getElementById('formOk').style.display = 'block';
        e.target.reset();
    }
}
</script>
<!-- SEARCH MODAL OVERLAY -->
<div id="searchModal" style="display:none; position:fixed; inset:0; z-index:99999; background:rgba(5,8,16,0.85); backdrop-filter:blur(8px); padding:2rem 1rem; align-items:flex-start; justify-content:center; overflow-y:auto;">
    <div class="card" style="max-width:700px; width:100%; margin-top:5vh; padding:1.8rem; position:relative; border:1px solid var(--border2); background:var(--panel);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
