---
layout: layouts/base.njk
permalink: /contact/index.html
title: "Contact Aimad Ul Islam | Cybersecurity & Incident Response Desk"
seo_title: "Contact Aimad Ul Islam | Cybersecurity & Incident Response Desk"
seo_description: "Get in touch with Aimad Ul Islam for SOC analyst opportunities, DFIR collaborations, security consulting, or penetration testing inquiries."
canonical_url: "https://aimadulislam.dpdns.org/contact/"
---

<div class="container" style="padding-top: 4rem; padding-bottom: 5rem;">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb" style="margin-bottom: 2rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--silver);">
        <a href="/" style="color: var(--cyan); text-decoration: none;"><i class="fa-solid fa-house"></i> Home</a>
        <span>/</span>
        <span style="color: var(--white); font-weight: 600;">Contact</span>
    </nav>

    <!-- Header Hero Card -->
    <header class="card" style="padding: 2.5rem; margin-bottom: 2.5rem; border: 1px solid var(--border2); background: var(--panel); border-radius: var(--radius-lg); position: relative; overflow: hidden;">
        <div class="card-glow"></div>
        <div style="font-family: 'Space Grotesk', sans-serif; font-size: 0.85rem; text-transform: uppercase; color: var(--cyan); letter-spacing: 1.5px; margin-bottom: 0.4rem; font-weight: 600;">
            <i class="fa-solid fa-satellite-dish"></i> Communication Channels
        </div>
        <h1 style="font-size: 2.4rem; font-weight: 700; color: var(--white); margin-bottom: 0.6rem; line-height: 1.2;">
            Contact & Collaboration Desk
        </h1>
        <p style="color: var(--silver); font-size: 1.05rem; margin-bottom: 0; line-height: 1.6; max-width: 800px;">
            Actively seeking SOC analyst roles, penetration testing internships, cybersecurity research collaborations, and security engineering positions.
        </p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem;">
        <!-- Left: Direct Channels & Information -->
        <section class="card" style="padding: 2rem; border: 1px solid var(--border); background: var(--card); display: flex; flex-direction: column; gap: 1.5rem;">
            <h2 style="font-size: 1.35rem; color: var(--white); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.6rem;">
                <i class="fa-solid fa-address-card" style="color: var(--cyan);"></i> Direct Reach
            </h2>

            <div class="con-item" style="display: flex; gap: 1rem; align-items: flex-start;">
                <div class="ci-ic" style="width: 42px; height: 42px; border-radius: 8px; background: rgba(0,212,255,0.1); border: 1px solid rgba(0,212,255,0.25); display: flex; align-items: center; justify-content: center; color: var(--cyan);"><i class="fa-solid fa-envelope"></i></div>
                <div>
                    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.5px;">Primary Email</div>
                    <div style="font-size: 1rem; font-weight: 600;"><a href="mailto:{{ contact.email or settings.contact_email or 'info@aimadulislam.dpdns.org' }}" style="color: var(--cyan); text-decoration: none;">{{ contact.email or settings.contact_email or 'info@aimadulislam.dpdns.org' }}</a></div>
                </div>
            </div>

            <div class="con-item" style="display: flex; gap: 1rem; align-items: flex-start;">
                <div class="ci-ic" style="width: 42px; height: 42px; border-radius: 8px; background: rgba(0,255,136,0.1); border: 1px solid rgba(0,255,136,0.25); display: flex; align-items: center; justify-content: center; color: var(--green);"><i class="fa-brands fa-github"></i></div>
                <div>
                    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.5px;">GitHub Code Repository</div>
                    <div style="font-size: 1rem; font-weight: 600;"><a href="{{ contact.github or settings.public_github_url or settings.github_url or 'https://github.com/im0d00' }}" target="_blank" rel="noopener noreferrer" style="color: var(--green); text-decoration: none;">github.com/{{ settings.public_github_username or contact.github_username or 'im0d00' }}</a></div>
                </div>
            </div>

            <div class="con-item" style="display: flex; gap: 1rem; align-items: flex-start;">
                <div class="ci-ic" style="width: 42px; height: 42px; border-radius: 8px; background: rgba(124,58,237,0.1); border: 1px solid rgba(124,58,237,0.25); display: flex; align-items: center; justify-content: center; color: var(--violet2);"><i class="fa-brands fa-linkedin-in"></i></div>
                <div>
                    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.5px;">LinkedIn Network</div>
                    <div style="font-size: 1rem; font-weight: 600;"><a href="{{ contact.linkedin or 'https://linkedin.com/in/aimad-ulislam' }}" target="_blank" rel="noopener noreferrer" style="color: var(--violet2); text-decoration: none;">linkedin.com/in/aimad-ulislam</a></div>
                </div>
            </div>

            <div class="con-item" style="display: flex; gap: 1rem; align-items: flex-start;">
                <div class="ci-ic" style="width: 42px; height: 42px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--silver);"><i class="fa-solid fa-location-dot"></i></div>
                <div>
                    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.5px;">Location & Operations</div>
                    <div style="font-size: 0.95rem; color: var(--white); font-weight: 500;">{{ contact.location or 'Peshawar, KPK, Pakistan' }}</div>
                    <div style="font-size: 0.82rem; color: var(--muted);">PKT (UTC+5) • Open for Global Remote Schedules</div>
                </div>
            </div>

            <div style="border-top: 1px solid var(--border); padding-top: 1rem;">
                <div style="font-size: 0.88rem; color: var(--muted); margin-bottom: 0.8rem;">Responsible Vulnerability Disclosure</div>
                <p style="font-size: 0.85rem; color: var(--silver); line-height: 1.5; margin-bottom: 0.8rem;">
                    For security researchers seeking to report vulnerabilities regarding platform services, please review our official guidelines:
                </p>
                <a href="/resources/responsible-disclosure/" class="btn btn-outline btn-xs"><i class="fa-solid fa-shield-halved"></i> Vulnerability Disclosure Policy</a>
            </div>
        </section>

        <!-- Right: Interactive Contact Form -->
        <section class="card" style="padding: 2rem; border: 1px solid var(--border); background: var(--card);">
            <h2 style="font-size: 1.35rem; color: var(--white); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem;">
                <i class="fa-solid fa-paper-plane" style="color: var(--cyan);"></i> Send Secure Message
            </h2>
            <form class="con-form" action="{{ contact.contact_form_endpoint or 'https://formspree.io/f/xbjnqpyz' }}" method="POST" onsubmit="handleForm(event)">
                <div class="fg" style="margin-bottom: 1rem;">
                    <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 0.4rem;">Your Full Name</label>
                    <input type="text" name="name" id="cn" placeholder="e.g. Jane Doe" required style="width: 100%; padding: 0.75rem 1rem; background: rgba(10,22,40,0.85); border: 1px solid var(--border2); border-radius: 6px; color: var(--white); font-family: inherit;" />
                </div>
                <div class="fg" style="margin-bottom: 1rem;">
                    <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 0.4rem;">Email Address</label>
                    <input type="email" name="email" id="ce" placeholder="jane@organization.com" required style="width: 100%; padding: 0.75rem 1rem; background: rgba(10,22,40,0.85); border: 1px solid var(--border2); border-radius: 6px; color: var(--white); font-family: inherit;" />
                </div>
                <div class="fg" style="margin-bottom: 1rem;">
                    <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 0.4rem;">Organization / Subject</label>
                    <input type="text" name="organization" id="co" placeholder="Company, University, or Topic" style="width: 100%; padding: 0.75rem 1rem; background: rgba(10,22,40,0.85); border: 1px solid var(--border2); border-radius: 6px; color: var(--white); font-family: inherit;" />
                </div>
                <div class="fg" style="margin-bottom: 1rem;">
                    <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 0.4rem;">Inquiry Classification</label>
                    <select name="type" id="ct" style="width: 100%; padding: 0.75rem 1rem; background: #0A1628; border: 1px solid var(--border2); border-radius: 6px; color: var(--white); font-family: inherit;">
                        <option value="">Select category...</option>
                        <option>SOC Analyst / Security Role</option>
                        <option>Penetration Testing / Security Consulting</option>
                        <option>Research Collaboration / Whitepaper</option>
                        <option>General Technical Inquiry</option>
                    </select>
                </div>
                <div class="fg" style="margin-bottom: 1.5rem;">
                    <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 0.4rem;">Message Details</label>
                    <textarea name="message" id="cm" placeholder="How can we collaborate on cybersecurity operations?" required rows="5" style="width: 100%; padding: 0.75rem 1rem; background: rgba(10,22,40,0.85); border: 1px solid var(--border2); border-radius: 6px; color: var(--white); font-family: inherit; resize: vertical;"></textarea>
                </div>
                <button type="submit" class="btn btn-cyan w-full" style="width: 100%; padding: 0.85rem;"><i class="fa-solid fa-paper-plane fa-xs"></i> Submit Message</button>
                <div class="form-ok" id="formOk" style="display:none; margin-top: 1rem; padding: 0.8rem; background: rgba(0,255,136,0.15); border: 1px solid var(--green); color: var(--green); border-radius: 6px; text-align: center;">
                    <i class="fa-solid fa-circle-check"></i> Thank you! Message transmitted successfully.
                </div>
            </form>
        </section>
    </div>
</div>
