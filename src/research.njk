---
layout: layouts/base.njk
title: Cybersecurity Research Center & Threat Intelligence | Aimad Ul Islam
description: Peer-reviewed research, threat intelligence whitepapers, malware case studies, vulnerability advisories, and DFIR investigation reports by Aimad Ul Islam.
---

<!-- HERO SECTION -->
<section id="blog-hero" aria-labelledby="research-hero-title">
  <canvas id="blog-hero-canvas" aria-hidden="true"></canvas>
  <div class="blog-hero-inner container">
    <div class="blog-hero-eye"><i class="fa-solid fa-microscope"></i> Threat Intelligence & Whitepaper Vault</div>
    <h1 class="blog-hero-title" id="research-hero-title">
      Security <span class="accent">Research Center</span>
    </h1>
    <p class="blog-hero-sub">In-depth technical white papers, zero-trust implementation blueprints, automated malware triage reports, and SOC threat intelligence digests.</p>

    <!-- Research Stats -->
    <div class="sidebar-stats-grid">
      <div class="s-stat-box card">
        <div class="s-stat-val">{{ reports.items.length + collections.research.length }}</div>
        <div class="s-stat-lbl">White Papers</div>
      </div>
      <div class="s-stat-box card">
        <div class="s-stat-val text-cyan">PDF</div>
        <div class="s-stat-lbl">Open Standard</div>
      </div>
      <div class="s-stat-box card">
        <div class="s-stat-val">2026</div>
        <div class="s-stat-lbl">Latest Edition</div>
      </div>
      <div class="s-stat-box card">
        <div class="s-stat-val text-green">Verified</div>
        <div class="s-stat-lbl">Peer-Reviewed</div>
      </div>
    </div>

    <!-- Search & Filters -->
    <div class="search-filter-container card">
      <div class="search-wrap" role="search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" id="research-search" placeholder="Search papers by CVE, title, malware analysis, SIEM, or keyword..." autocomplete="off" aria-label="Search research papers"/>
      </div>

      <div class="filter-controls-row">
        <div class="filter-group">
          <label for="research-cat-select"><i class="fa-solid fa-folder"></i> Category:</label>
          <select id="research-cat-select" class="cyber-select">
            <option value="all">All Document Types</option>
            <option value="whitepaper">White Papers</option>
            <option value="security report">Security Reports</option>
            <option value="case study">Case Studies</option>
            <option value="advisory">Security Advisories</option>
            <option value="malware">Malware Reports</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Category Pills -->
    <div id="categories-bar" class="categories-bar-wrapper">
      <div class="categories-scroll" role="list">
        <button class="cat-btn active" data-cat="all" role="listitem"><i class="fa-solid fa-border-all fa-xs"></i> All Publications</button>
        <button class="cat-btn" data-cat="whitepaper" role="listitem"><i class="fa-solid fa-file-invoice fa-xs"></i> White Papers</button>
        <button class="cat-btn" data-cat="security report" role="listitem"><i class="fa-solid fa-shield-halved fa-xs"></i> Security Reports</button>
        <button class="cat-btn" data-cat="case study" role="listitem"><i class="fa-solid fa-flask-vial fa-xs"></i> Case Studies</button>
        <button class="cat-btn" data-cat="malware" role="listitem"><i class="fa-solid fa-bug fa-xs"></i> Threat Analysis</button>
      </div>
    </div>
  </div>
</section>

<!-- MAIN CONTENT -->
<main class="container">
  <section id="research-section" class="articles-main-section">
    <div class="section-flex-header">
      <h2 class="articles-section-title"><i class="fa-solid fa-book-journal-whills"></i> Publications & Technical Reports</h2>
      <span class="posts-count-badge" id="research-count">Showing All Reports</span>
    </div>

    <div id="research-grid" class="articles-grid">
      
      <!-- Data items from JSON -->
      {% for rep in reports.items %}
      <article class="card article-card research-card"
               data-category="{{ (rep.category or 'Whitepaper') | lower }}"
               data-title="{{ rep.title | lower }}"
               data-summary="{{ rep.summary | lower }}"
               data-author="{{ (rep.author or 'Aimad Ul Islam') | lower }}">
        <div class="card-glow"></div>
        <div class="article-card-img-wrap" style="height: 180px;">
          <div class="article-card-img-placeholder">
            <i class="fa-solid fa-file-pdf text-cyan" style="font-size: 3rem;"></i>
          </div>
          <span class="card-diff-badge intermediate">{{ rep.version or "v1.0" }}</span>
        </div>

        <div class="article-card-body">
          <div class="article-card-tags">
            <span class="tag tag-cyber"><i class="fa-solid fa-flask"></i> {{ rep.category }}</span>
            <span class="tag tag-tut"><i class="fa-solid fa-hard-drive"></i> {{ rep.file_size or "2.0 MB" }}</span>
          </div>

          <h3 class="article-card-title">{{ rep.title }}</h3>
          <p class="article-card-excerpt">{{ rep.summary }}</p>

          <div class="article-card-footer" style="margin-top: 1.2rem;">
            {% if rep.pdf_url %}
            <a href="{{ rep.pdf_url }}" target="_blank" class="btn btn-sm btn-cyan btn-full"><i class="fa-solid fa-file-arrow-down"></i> Download PDF Paper</a>
            {% endif %}
          </div>
        </div>
      </article>
      {% endfor %}

      <!-- Markdown Collection Items from Decap CMS -->
      {% for rep in collections.research %}
      <article class="card article-card research-card"
               data-category="{{ (rep.data.category or 'Research') | lower }}"
               data-title="{{ rep.data.title | lower }}"
               data-summary="{{ (rep.data.summary or rep.data.description or '') | lower }}"
               data-author="{{ (rep.data.author or 'Aimad Ul Islam') | lower }}"
               onclick="window.location='{{ rep.url }}'">
        <div class="card-glow"></div>
        <div class="article-card-img-wrap" style="height: 180px;">
          {% if rep.data.featured_image or rep.data.image %}
          <img class="article-card-img" src="{{ rep.data.featured_image or rep.data.image }}" alt="{{ rep.data.title }}" loading="lazy"/>
          {% else %}
          <div class="article-card-img-placeholder">
            <i class="fa-solid fa-book-journal-whills text-cyan" style="font-size: 3rem;"></i>
          </div>
          {% endif %}
          <span class="card-diff-badge intermediate">{{ rep.data.category or "Research" }}</span>
        </div>

        <div class="article-card-body">
          <div class="article-card-tags">
            <span class="tag tag-cyber"><i class="fa-solid fa-flask"></i> {{ rep.data.category or "Threat Research" }}</span>
            <span class="tag tag-tut text-green"><i class="fa-solid fa-shield-halved"></i> Peer-Reviewed</span>
          </div>

          <h3 class="article-card-title">{{ rep.data.title }}</h3>
          <p class="article-card-excerpt">{{ rep.data.summary or rep.data.description }}</p>

          <div class="article-card-footer" style="margin-top: 1.2rem;">
            <a href="{{ rep.url }}" class="btn btn-sm btn-cyan btn-full"><i class="fa-solid fa-book-open"></i> Read Research Paper</a>
          </div>
        </div>
      </article>
      {% endfor %}

    </div>

    <!-- No Results Fallback -->
    <div class="no-results card" id="no-research-results" style="display:none; text-align: center; padding: 3rem 1.5rem;">
      <i class="fa-solid fa-book-journal-whills text-cyan" style="font-size: 3rem; margin-bottom: 1rem;"></i>
      <h3>No Research Reports Match Query</h3>
      <p>Try searching for CVE identifiers, threat intelligence, malware, or SIEM automation.</p>
      <button class="btn btn-cyan mt-3" onclick="resetResearchSearch()"><i class="fa-solid fa-rotate"></i> Reset All Filters</button>
    </div>

    <!-- Pagination Controls -->
    <div class="pagination-container" id="research-pagination-controls">
      <!-- Dynamically rendered -->
    </div>
  </section>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const searchInput = document.getElementById("research-search");
  const catSelect = document.getElementById("research-cat-select");
  const catBtns = document.querySelectorAll(".cat-btn");
  const researchGrid = document.getElementById("research-grid");
  const cards = Array.from(document.querySelectorAll(".research-card"));
  const countBadge = document.getElementById("research-count");
  const noResults = document.getElementById("no-research-results");
  const paginationControls = document.getElementById("research-pagination-controls");

  let currentSearch = "";
  let currentCat = "all";
  let currentPage = 1;
  const itemsPerPage = 6;

  function filterResearch() {
    let filtered = cards.filter(card => {
      const title = card.getAttribute("data-title") || "";
      const summary = card.getAttribute("data-summary") || "";
      const cat = card.getAttribute("data-category") || "";

      const matchSearch = currentSearch === "" || 
                          title.includes(currentSearch) || 
                          summary.includes(currentSearch) || 
                          cat.includes(currentSearch);

      const matchCat = currentCat === "all" || cat.includes(currentCat.toLowerCase());

      return matchSearch && matchCat;
    });

    if (countBadge) countBadge.textContent = `${filtered.length} Reports Displayed`;

    cards.forEach(c => c.style.display = "none");

    if (filtered.length === 0) {
      if (noResults) noResults.style.display = "block";
      if (paginationControls) paginationControls.innerHTML = "";
      return;
    } else {
      if (noResults) noResults.style.display = "none";
    }

    const totalPages = Math.ceil(filtered.length / itemsPerPage);
    if (currentPage > totalPages) currentPage = 1;

    const startIdx = (currentPage - 1) * itemsPerPage;
    const endIdx = startIdx + itemsPerPage;
    const pageItems = filtered.slice(startIdx, endIdx);

    pageItems.forEach(item => {
      item.style.display = "flex";
      researchGrid.appendChild(item);
    });

    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    if (!paginationControls || totalPages <= 1) {
      if (paginationControls) paginationControls.innerHTML = "";
      return;
    }

    let html = `<div class="cyber-pagination">`;
    html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" onclick="changeResearchPage(${currentPage - 1})"><i class="fa-solid fa-chevron-left"></i> Prev</button>`;

    for (let i = 1; i <= totalPages; i++) {
      html += `<button class="page-num ${i === currentPage ? 'active' : ''}" onclick="changeResearchPage(${i})">${i}</button>`;
    }

    html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" onclick="changeResearchPage(${currentPage + 1})">Next <i class="fa-solid fa-chevron-right"></i></button>`;
    html += `</div>`;

    paginationControls.innerHTML = html;
  }

  window.changeResearchPage = (page) => {
    currentPage = page;
    filterResearch();
    document.getElementById("research-section").scrollIntoView({ behavior: 'smooth' });
  };

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      currentSearch = e.target.value.toLowerCase().trim();
      currentPage = 1;
      filterResearch();
    });
  }

  if (catSelect) {
    catSelect.addEventListener("change", (e) => {
      currentCat = e.target.value;
      currentPage = 1;
      filterResearch();
    });
  }

  catBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      catBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      currentCat = btn.getAttribute("data-cat");
      currentPage = 1;
      filterResearch();
    });
  });

  window.resetResearchSearch = () => {
    if (searchInput) searchInput.value = "";
    if (catSelect) catSelect.value = "all";
    currentSearch = "";
    currentCat = "all";
    catBtns.forEach(b => {
      if (b.getAttribute("data-cat") === "all") b.classList.add("active");
      else b.classList.remove("active");
    });
    currentPage = 1;
    filterResearch();
  };

  filterResearch();
});
</script>
