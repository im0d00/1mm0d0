<header id="navbar" class="cyber-header" role="banner">
    {% set headerLogoImg = settings.profile_picture or brand.logo or settings.logo or brand.header_logo or "/images/whatsapp-image-2026-07-05-at-9.35.59-pm.jpeg" %}
    {% set siteName = brand.logo_text or settings.portfolio_name or settings.site_name or "Aimad Security" %}

    <div class="cyber-nav-container">
        <!-- OUTER FUTURISTIC CYBER FRAME -->
        <div class="cyber-nav-frame">
            <!-- Decorative Laser Rails & Circuit Accents -->
            <div class="cyber-frame-laser laser-top-left" aria-hidden="true"></div>
            <div class="cyber-frame-laser laser-top-right" aria-hidden="true"></div>
            <div class="cyber-frame-laser laser-bottom-center" aria-hidden="true"></div>
            <div class="cyber-frame-cap cap-left" aria-hidden="true"></div>
            <div class="cyber-frame-cap cap-right" aria-hidden="true"></div>
            <div class="cyber-frame-glow-left" aria-hidden="true"></div>
            <div class="cyber-frame-glow-right" aria-hidden="true"></div>

            <!-- INNER NAVIGATION BAR CONTENT -->
            <div class="cyber-nav-inner">
                <!-- Branding on the left: Circular Avatar with HUD ring + Aimad Security -->
                <a href="{{ brand.logo_link or '/' }}" class="cyber-brand-wrap" aria-label="{{ siteName }} Home">
                    <div class="cyber-avatar-wrap">
                        <div class="cyber-avatar-hud-ring" aria-hidden="true"></div>
                        <img src="{{ headerLogoImg }}" alt="{{ siteName }}" class="cyber-avatar-img" width="42" height="42" loading="eager" />
                    </div>
                    <div class="cyber-brand-text">
                        <span class="cyber-brand-title">{{ siteName }}</span>
                        <span class="cyber-brand-line" aria-hidden="true"></span>
                    </div>
                </a>

                <!-- Exact Navigation Sequence: 1. Home, 2. Projects, 3. Labs, 4. About, 5. Search, 6. Blog, 7. Research, 8. Contact -->
                <ul class="cyber-nav-links" role="menubar">
                    <!-- 1. Home -->
                    <li class="cyber-nav-item" role="none">
                        <a href="/" class="cyber-nav-link {% if page.url == '/' %}active{% endif %}" role="menuitem">
                            <i class="fa-solid fa-house" aria-hidden="true"></i>
                            <span>Home</span>
                        </a>
                    </li>

                    <!-- 2. Projects -->
                    <li class="cyber-nav-item" role="none">
                        <a href="/projects/" class="cyber-nav-link {% if '/projects' in page.url %}active{% endif %}" role="menuitem">
                            <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                            <span>Projects</span>
                        </a>
                    </li>

                    <!-- 3. Labs -->
                    <li class="cyber-nav-item" role="none">
                        <a href="/labs/" class="cyber-nav-link {% if '/labs' in page.url %}active{% endif %}" role="menuitem">
                            <i class="fa-solid fa-flask" aria-hidden="true"></i>
                            <span>Labs</span>
                        </a>
                    </li>

                    <!-- 4. About -->
                    <li class="cyber-nav-item" role="none">
                        <a href="/about/" class="cyber-nav-link {% if '/about' in page.url %}active{% endif %}" role="menuitem">
                            <i class="fa-solid fa-user" aria-hidden="true"></i>
                            <span>About</span>
                        </a>
                    </li>

                    <!-- 5. Search Control (Positioned between About and Blog) -->
                    {% if settings.search_enabled != false %}
                    <li class="cyber-nav-item cyber-nav-search-item" role="none">
                        <button id="searchOpenBtn" class="cyber-search-btn" onclick="openSearchModal()" aria-label="Search platform (Press Ctrl+K)">
                            <i class="fa-solid fa-magnifying-glass cyber-search-icon" aria-hidden="true"></i>
                            <span class="cyber-search-text">Search</span>
                            <kbd class="cyber-kbd" aria-hidden="true">Ctrl+K</kbd>
                        </button>
                    </li>
                    {% endif %}

                    <!-- 6. Blog -->
                    <li class="cyber-nav-item" role="none">
                        <a href="/blog/" class="cyber-nav-link {% if ('/blog' in page.url) or ('/posts' in page.url) or ('/category' in page.url) %}active{% endif %}" role="menuitem">
                            <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
                            <span>Blog</span>
                        </a>
                    </li>

                    <!-- 7. Research -->
                    <li class="cyber-nav-item" role="none">
                        <a href="/research/" class="cyber-nav-link {% if '/research' in page.url %}active{% endif %}" role="menuitem">
                            <i class="fa-solid fa-file-contract" aria-hidden="true"></i>
                            <span>Research</span>
                        </a>
                    </li>

                    <!-- 8. Contact -->
                    <li class="cyber-nav-item" role="none">
                        <a href="/contact/" class="cyber-nav-link {% if '/contact' in page.url %}active{% endif %}" role="menuitem">
                            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                            <span>Contact</span>
                        </a>
                    </li>
                </ul>

                <!-- Utility actions on far right: Theme toggle & Mobile hamburger -->
                <div class="cyber-nav-actions">
                    <button class="cyber-icon-btn dark-mode-btn" id="theme-toggle" aria-label="Toggle dark/light theme" onclick="toggleTheme()">
                        <i class="fa-regular fa-moon" id="theme-toggle-icon" aria-hidden="true"></i>
                    </button>

                    <button class="cyber-hamburger" id="ham" aria-label="Toggle navigation menu" aria-expanded="false" onclick="toggleMobileNav(event)">
                        <span class="ham-line"></span>
                        <span class="ham-line"></span>
                        <span class="ham-line"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- MOBILE OVERLAY & DRAWER -->
<div class="mobile-overlay" id="mobOverlay" onclick="closeMobileNav(event)"></div>
<aside class="mobile-nav" id="mobNav" aria-label="Mobile Navigation Drawer">
    <div class="mobile-nav-header">
        <a href="{{ brand.logo_link or '/' }}" class="cyber-brand-wrap" aria-label="{{ siteName }} Home">
            <div class="cyber-avatar-wrap">
                <div class="cyber-avatar-hud-ring" aria-hidden="true"></div>
                <img src="{{ headerLogoImg }}" alt="{{ siteName }}" class="cyber-avatar-img" width="38" height="38" loading="lazy" />
            </div>
            <div class="cyber-brand-text">
                <span class="cyber-brand-title">{{ siteName }}</span>
                <span class="cyber-brand-line" aria-hidden="true"></span>
            </div>
        </a>
        <button class="mob-close-btn" id="mobCloseBtn" aria-label="Close menu" onclick="closeMobileNav(event)">&times;</button>
    </div>

    {% if settings.status_badge_visible != false %}
    <div class="mobile-status-badge">
        <span class="status-dot" style="{% if settings.status_badge_color %}background: {{ settings.status_badge_color }}; box-shadow: 0 0 8px {{ settings.status_badge_color }};{% endif %}"></span>
        <span>{{ settings.status_badge_text or contact.availability or "Online / SOC Ready" }}</span>
    </div>
    {% endif %}

    <!-- Mobile Navigation Menu -->
    <ul class="mobile-links">
        <li>
            <a href="/" class="{% if page.url == '/' %}active{% endif %}">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
        </li>
        <li>
            <a href="/projects/" class="{% if '/projects' in page.url %}active{% endif %}">
                <i class="fa-solid fa-folder-open"></i>
                <span>Projects</span>
            </a>
        </li>
        <li>
            <a href="/labs/" class="{% if '/labs' in page.url %}active{% endif %}">
                <i class="fa-solid fa-flask"></i>
                <span>Labs</span>
            </a>
        </li>
        <li>
            <a href="/about/" class="{% if '/about' in page.url %}active{% endif %}">
                <i class="fa-solid fa-user"></i>
                <span>About</span>
            </a>
        </li>
        <li>
            <a href="javascript:void(0)" onclick="closeMobileNav(); openSearchModal();">
                <i class="fa-solid fa-magnifying-glass"></i>
                <span>Search</span>
            </a>
        </li>
        <li>
            <a href="/blog/" class="{% if ('/blog' in page.url) or ('/posts' in page.url) or ('/category' in page.url) %}active{% endif %}">
                <i class="fa-solid fa-pen-nib"></i>
                <span>Blog</span>
            </a>
        </li>
        <li>
            <a href="/research/" class="{% if '/research' in page.url %}active{% endif %}">
                <i class="fa-solid fa-file-contract"></i>
                <span>Research</span>
            </a>
        </li>
        <li>
            <a href="/contact/" class="{% if '/contact' in page.url %}active{% endif %}">
                <i class="fa-solid fa-envelope"></i>
                <span>Contact</span>
            </a>
        </li>
    </ul>

    <div class="mobile-actions">
        {% if settings.search_enabled != false %}
        <button id="mobSearchBtn" class="btn outline w-full mob-action-btn" onclick="closeMobileNav(); openSearchModal();">
            <i class="fa-solid fa-magnifying-glass"></i> Search Platform (Ctrl+K)
        </button>
        {% endif %}
        <a href="{{ resume.pdf_file or hero.resume_button_link or '/downloads/' }}" download class="btn primary w-full mob-action-btn">
            <i class="fa-solid fa-file-pdf"></i> Download Resume
        </a>
    </div>
</aside>
