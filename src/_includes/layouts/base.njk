<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if seo_title %}{{ seo_title }}{% elif title %}{% if "Aimad Ul Islam" in title %}{{ title }}{% else %}{{ title }} | Aimad Ul Islam{% endif %}{% else %}{{ settings.seo_title or settings.portfolio_name or "Aimad Ul Islam" }} | Cybersecurity Professional & Security Researcher{% endif %}</title>
    <meta name="description" content="{{ seo_description or description or excerpt or summary or settings.seo_description or settings.website_description or 'Aimad Ul Islam — Cybersecurity Professional, SOC Specialist, Network Security Engineer & Technical Researcher' }}">
    <meta name="theme-color" content="#080C1A">

    <!-- Search Engine & IndexNow Verifications -->
    {% if settings.google_search_console_verification %}
    <meta name="google-site-verification" content="{{ settings.google_search_console_verification }}">
    {% endif %}
    {% if settings.bing_site_verification %}
    <meta name="msvalidate.01" content="{{ settings.bing_site_verification }}">
    {% endif %}
    {% if settings.indexnow_key %}
    <meta name="indexnow-key" content="{{ settings.indexnow_key }}">
    {% endif %}
    
    <!-- Dynamic Favicons & Icons -->
    {% if brand.favicon_ico or settings.favicon %}
    <link rel="icon" type="image/x-icon" href="{{ brand.favicon_ico or settings.favicon }}">
    {% else %}
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    {% endif %}
    {% if brand.favicon_png %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ brand.favicon_png }}">
    {% endif %}
    {% if brand.favicon_svg %}
    <link rel="icon" type="image/svg+xml" href="{{ brand.favicon_svg }}">
    {% endif %}
    {% if brand.apple_touch_icon %}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ brand.apple_touch_icon }}">
    {% endif %}
    <link rel="manifest" href="/manifest.json">

    <!-- Open Graph & Meta -->
    <meta property="og:title" content="{% if seo_title %}{{ seo_title }}{% elif title %}{% if 'Aimad Ul Islam' in title %}{{ title }}{% else %}{{ title }} | Aimad Ul Islam{% endif %}{% else %}{{ settings.portfolio_name or 'Aimad Ul Islam' }} | Cybersecurity Professional{% endif %}">
    <meta property="og:description" content="{{ seo_description or description or excerpt or summary or settings.seo_description or settings.website_description }}">
    <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
    <meta property="og:url" content="https://aimadulislam.dpdns.org{{ page.url }}">
    <meta property="og:image" content="{{ og_image or featured_image or image or thumbnail or brand.og_image or settings.og_image or 'https://i.postimg.cc/hPyNdGVF/Whats-App-Image-2026-07-05-at-9-35-59-PM.jpg' }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if seo_title %}{{ seo_title }}{% elif title %}{% if 'Aimad Ul Islam' in title %}{{ title }}{% else %}{{ title }} | Aimad Ul Islam{% endif %}{% else %}{{ settings.portfolio_name or 'Aimad Ul Islam' }} | Cybersecurity Professional{% endif %}">
    <meta name="twitter:description" content="{{ seo_description or description or excerpt or summary or settings.seo_description or settings.website_description }}">
    <meta name="twitter:image" content="{{ og_image or featured_image or image or thumbnail or brand.og_image or settings.og_image or 'https://i.postimg.cc/hPyNdGVF/Whats-App-Image-2026-07-05-at-9-35-59-PM.jpg' }}">

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ canonical_url or ('https://aimadulislam.dpdns.org' + page.url) }}">

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": {{ (settings.author or "Aimad Ul Islam") | dump | safe }},
      "url": "https://aimadulislam.dpdns.org",
      "image": {{ (settings.og_image or "https://i.postimg.cc/hPyNdGVF/Whats-App-Image-2026-07-05-at-9-35-59-PM.jpg") | dump | safe }},
      "jobTitle": "Cybersecurity Specialist & Network Security Researcher",
      "description": {{ (settings.website_description or "Cybersecurity student, SOC enthusiast, and network security engineering portfolio and technical writeups.") | dump | safe }},
      "knowsAbout": [
        "Cybersecurity",
        "Network Security",
        "Digital Forensics & Incident Response (DFIR)",
        "Security Operations Center (SOC)",
        "Ethical Hacking",
        "Penetration Testing",
        "Linux System Administration",
        "Python Security Automation"
      ],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "University of Peshawar",
        "sameAs": "https://uop.edu.pk"
      },
      "sameAs": [
        "{{ settings.github_url or 'https://github.com/im0d00' }}",
        "{{ settings.linkedin_url or 'https://linkedin.com/in/aimadulislam' }}",
        "{{ settings.x_url or 'https://x.com/aimadulislam' }}",
        "{{ settings.youtube_url or 'https://youtube.com/@aimadulislam' }}"
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ (settings.portfolio_name or "Aimad Ul Islam") | dump | safe }},
      "url": "https://aimadulislam.dpdns.org/"
    }
    </script>
    {% if page.url and page.url != "/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aimadulislam.dpdns.org/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {% if "/posts/" in page.url or "/blog/" in page.url %}"Blog"{% elif "/projects/" in page.url %}"Projects"{% elif "/labs/" in page.url %}"Labs"{% elif "/research/" in page.url %}"Research"{% elif "/downloads/" in page.url %}"Downloads"{% elif "/resources/" in page.url %}"Resources"{% else %}{{ (title or "Page") | dump | safe }}{% endif %},
          "item": {% if "/posts/" in page.url or "/blog/" in page.url %}"https://aimadulislam.dpdns.org/blog/"{% elif "/projects/" in page.url %}"https://aimadulislam.dpdns.org/projects/"{% elif "/labs/" in page.url %}"https://aimadulislam.dpdns.org/labs/"{% elif "/research/" in page.url %}"https://aimadulislam.dpdns.org/research/"{% elif "/downloads/" in page.url %}"https://aimadulislam.dpdns.org/downloads/"{% elif "/resources/" in page.url %}"https://aimadulislam.dpdns.org/resources/"{% else %}"https://aimadulislam.dpdns.org{{ page.url }}"{% endif %}
        }
        {% if page.url != "/blog/" and page.url != "/projects/" and page.url != "/labs/" and page.url != "/research/" and page.url != "/downloads/" and page.url != "/resources/" %},
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ (title or "Item") | dump | safe }},
          "item": "https://aimadulislam.dpdns.org{{ page.url }}"
        }
        {% endif %}
      ]
    }
    </script>
    {% endif %}
    {% if layout == "layouts/post.njk" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ (title or "") | dump | safe }},
      "description": {{ (seo_description or description or excerpt or summary or "") | dump | safe }},
      "image": {{ (og_image or featured_image or image or thumbnail or brand.og_image or settings.og_image or "https://i.postimg.cc/hPyNdGVF/Whats-App-Image-2026-07-05-at-9-35-59-PM.jpg") | dump | safe }},
      "author": {
        "@type": "Person",
        "name": {{ (author or settings.author or "Aimad Ul Islam") | dump | safe }}
      },
      "datePublished": "{{ date | htmlDateString }}",
      "dateModified": "{{ (updated or last_updated or date) | htmlDateString }}",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://aimadulislam.dpdns.org{{ page.url }}"
      }
    }
    </script>
    {% endif %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/blog.css">
    
    <script>
      (function() {
        var localTheme = localStorage.getItem('aimad-theme');
        if (localTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('aimad-theme', 'dark');
        }
      })();
    </script>
</head>
<body class="site-base-body">
    <div class="grid-bg"></div>
    <div class="scan-line"></div>
    <div id="reading-progress"></div>

    <!-- SHARED GLOBAL HEADER -->
    {% include "header.njk" %}

    <main id="main-content">
        {{ content | safe }}
    </main>

    <!-- SHARED GLOBAL FOOTER -->
    {% include "footer.njk" %}

    <button id="scroll-top" aria-label="Scroll to top"><i class="fa-solid fa-arrow-up"></i></button>

    <!-- SEARCH MODAL OVERLAY -->
    <div id="searchModal" style="display:none; position:fixed; inset:0; z-index:99999; background:rgba(5,8,16,0.88); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); padding:2rem 1rem; align-items:flex-start; justify-content:center; overflow-y:auto;">
        <div class="card" style="max-width:720px; width:100%; margin-top:6vh; padding:1.8rem; position:relative; border:1px solid var(--border2); background:var(--panel); box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(0,212,255,0.15);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem;">
                <div style="font-family:'Space Grotesk',sans-serif; font-size:1.15rem; font-weight:700; color:var(--cyan); display:flex; align-items:center; gap:0.6rem;">
                    <i class="fa-solid fa-terminal"></i> Security Search Engine
                </div>
                <button id="searchCloseBtn" style="background:rgba(255,255,255,0.05); border:1px solid var(--border); border-radius:50%; width:32px; height:32px; color:var(--silver); font-size:1.1rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s;" aria-label="Close search">&times;</button>
            </div>
            <div style="position:relative; margin-bottom:1.2rem;">
                <input type="text" id="searchInput" placeholder="Search projects, labs, posts, tools, certs..." style="width:100%; padding:0.85rem 1rem 0.85rem 2.6rem; background:rgba(10,22,40,0.85); border:1px solid var(--border2); border-radius:8px; color:var(--white); font-family:'JetBrains Mono',monospace; font-size:0.92rem; outline:none;" />
                <i class="fa-solid fa-magnifying-glass" style="position:absolute; left:1rem; top:50%; transform:translateY(-50%); color:var(--cyan); font-size:0.9rem;"></i>
            </div>
            <div id="searchResults" style="max-height:420px; overflow-y:auto; display:flex; flex-direction:column; gap:0.6rem; padding-right:4px;">
                <div style="textalign:center; color:var(--muted); padding:1.5rem; font-size:0.88rem;">Type a query to search across all platform records...</div>
            </div>
        </div>
    </div>

    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script src="/js/main.js"></script>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", function(user) {
          if (!user) {
            window.netlifyIdentity.on("login", function() {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
</body>
</html>
