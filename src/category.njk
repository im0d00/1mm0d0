---
pagination:
  data: collections.categories
  size: 1
  alias: category
permalink: /category/{{ category | slugify }}/index.html
layout: layouts/base.njk
eleventyComputed:
  title: "Category: {{ category }} | Aimad Security"
  description: "Browse all technical articles and DFIR guides under {{ category }}."
---

<section class="container" style="padding-top: 5rem; padding-bottom: 4rem;">
  <div class="breadcrumb" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; color: var(--silver); font-size: 0.9rem;">
    <a href="/" style="color: var(--cyan); text-decoration: none;"><i class="fa-solid fa-house"></i> Home</a>
    <span>/</span>
    <a href="/blog/" style="color: var(--cyan); text-decoration: none;">Blog</a>
    <span>/</span>
    <span style="color: var(--white); font-weight: 600;">Category: {{ category }}</span>
  </div>

  <div class="card" style="padding: 2.5rem; margin-bottom: 2.5rem; border: 1px solid var(--border2); background: var(--panel); border-radius: var(--radius-lg);">
    <div style="font-family: 'Space Grotesk', sans-serif; font-size: 0.85rem; text-transform: uppercase; color: var(--cyan); letter-spacing: 1px; margin-bottom: 0.5rem; font-weight: 600;">
      <i class="fa-solid fa-folder-open"></i> Technical Category Archive
    </div>
    <h1 style="font-size: 2.2rem; font-weight: 700; color: var(--white); margin-bottom: 0.5rem;">{{ category }}</h1>
    <p style="color: var(--silver); font-size: 1rem; max-width: 700px; margin: 0;">
      Showing all verified security writeups, SOC playbooks, and research publications filed under <strong>{{ category }}</strong>.
    </p>
  </div>

  <div class="articles-grid">
    {% set catPosts = collections.posts %}
    {% set hasPosts = false %}
    {% for post in catPosts %}
      {% if category in post.data.categories %}
      {% set hasPosts = true %}
      <article class="card article-card" onclick="window.location='{{ post.url }}'">
        <div class="card-glow"></div>
        <div class="article-card-img-wrap">
          {% if post.data.image or post.data.thumbnail %}
          <img class="article-card-img" src="{{ post.data.image or post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy"/>
          {% else %}
          <div class="article-card-img-placeholder">
            <span class="card-emoji">{{ post.data.emoji or "📄" }}</span>
          </div>
          {% endif %}
          <span class="card-diff-badge {{ (post.data.difficulty or 'Intermediate') | lower }}">{{ post.data.difficulty or "Intermediate" }}</span>
        </div>

        <div class="article-card-body">
          <div class="article-card-tags">
            {% for cat in post.data.categories %}
            <span class="tag tag-cyber">{{ cat }}</span>
            {% endfor %}
          </div>

          <h3 class="article-card-title">{{ post.data.title }}</h3>
          <p class="article-card-excerpt">{{ post.data.excerpt or post.data.subtitle or post.data.description }}</p>

          <div class="article-card-footer">
            <div class="article-meta-mini">
              <span><i class="fa-regular fa-calendar"></i> {{ post.date | readableDate }}</span>
              <span><i class="fa-regular fa-clock"></i> {{ post.data.readingTime or 5 }}m</span>
            </div>
            <span class="read-more-link">Read Writeup <i class="fa-solid fa-arrow-right fa-xs"></i></span>
          </div>
        </div>
      </article>
      {% endif %}
    {% endfor %}

    {% if not hasPosts %}
      <div style="grid-column: 1 / -1; padding: 3rem; text-align: center; color: var(--silver); background: var(--panel); border: 1px dashed var(--border2); border-radius: var(--radius-lg);">
        <i class="fa-solid fa-file-circle-exclamation fa-2x" style="color: var(--cyan); margin-bottom: 1rem;"></i>
        <p style="font-size: 1.1rem; margin-bottom: 1rem;">No published articles found in this category yet.</p>
        <a href="/blog/" class="btn btn-cyan">View All Blog Writeups</a>
      </div>
    {% endif %}
  </div>

  <div style="margin-top: 3rem; text-align: center;">
    <a href="/blog/" class="btn btn-cyan" style="display: inline-flex; align-items: center; gap: 0.5rem;"><i class="fa-solid fa-arrow-left"></i> Back to All Blog Writeups</a>
  </div>
</section>
