---
layout: layouts/base.njk
title: Cybersecurity & Technical Blog | Aimad Ul Islam
description: Technical articles, DFIR research, SOC playbooks, Linux tutorials, and network security guides by Aimad Ul Islam.
---

<!-- HERO SECTION -->
<section id="blog-hero" aria-labelledby="blog-hero-title">
  <canvas id="blog-hero-canvas" aria-hidden="true"></canvas>
  <div class="blog-hero-inner container">
    <div class="blog-hero-eye"><i class="fa-solid fa-terminal"></i> Security Operations & Technical Journal</div>
    <h1 class="blog-hero-title" id="blog-hero-title">
      Cybersecurity <span class="accent">Knowledge Vault</span>
    </h1>
    <p class="blog-hero-sub">In-depth technical writeups on Digital Forensics & Incident Response (DFIR), SOC operations, network security, Linux hardening, and ethical hacking.</p>

    <!-- Search & Filter Controls -->
    <div class="search-filter-container card">
      <div class="search-wrap" role="search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" id="blog-search" placeholder="Search writeups by title, CVE, tool, tag, or topic..." autocomplete="off" aria-label="Search blog posts"/>
      </div>

      <div class="filter-controls-row">
        <div class="filter-group">
          <label for="difficulty-select"><i class="fa-solid fa-layer-group"></i> Level:</label>
          <select id="difficulty-select" class="cyber-select">
            <option value="all">All Difficulties</option>
            <option value="beginner">Beginner</option>
            <option value="intermediate">Intermediate</option>
            <option value="advanced">Advanced</option>
            <option value="expert">Expert</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="sort-select"><i class="fa-solid fa-arrow-down-wide-short"></i> Sort By:</label>
          <select id="sort-select" class="cyber-select">
            <option value="newest">Newest Published</option>
            <option value="oldest">Oldest First</option>
            <option value="readtime">Reading Time</option>
            <option value="title">Title (A-Z)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Category Pills with Auto Counts -->
    <div id="categories-bar" class="categories-bar-wrapper">
      <div class="categories-scroll" role="list">
        <button class="cat-btn active" data-cat="all" role="listitem">
          <i class="fa-solid fa-border-all fa-xs"></i> All Writeups <span class="cat-count">({{ collections.posts.length }})</span>
        </button>
        {% for cat in collections.categories %}
        <button class="cat-btn" data-cat="{{ cat }}" role="listitem">
          <i class="fa-solid fa-folder-open fa-xs"></i> {{ cat }} <span class="cat-count">({{ collections.categoryCounts[cat] or 1 }})</span>
        </button>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- MAIN CONTENT -->
<main class="container">
  <!-- FEATURED ARTICLE SECTION -->
  <section class="featured-section">
    <div class="articles-section-title">
      <i class="fa-solid fa-star text-cyan"></i> Featured Technical Writeup
    </div>
    <div id="featured-post-wrap">
      {% set featuredPost = collections.posts | head(1) | first %}
      {% if featuredPost %}
      <article class="featured-post card" onclick="window.location='{{ featuredPost.url }}'">
        <div class="card-glow"></div>
        <div class="featured-img-wrap">
          {% if featuredPost.data.image or featuredPost.data.thumbnail %}
          <img src="{{ featuredPost.data.image or featuredPost.data.thumbnail }}" alt="{{ featuredPost.data.title }}" loading="lazy"/>
          {% else %}
          <div class="featured-img-placeholder">
            <i class="fa-solid fa-shield-virus"></i>
            <span class="placeholder-emoji">{{ featuredPost.data.emoji or '📄' }}</span>
          </div>
          {% endif %}
          <div class="featured-img-overlay"></div>
          <span class="featured-badge"><i class="fa-solid fa-fire"></i> FEATURED</span>
        </div>
        <div class="featured-content">
          <div>
            <div class="featured-cat-row">
              {% for cat in featuredPost.data.categories %}
              <span class="tag tag-cyber"><i class="fa-solid fa-folder"></i> {{ cat }}</span>
              {% endfor %}
              <span class="tag tag-tut"><i class="fa-solid fa-gauge-high"></i> {{ featuredPost.data.difficulty or "Intermediate" }}</span>
            </div>
            <h2 class="featured-title">{{ featuredPost.data.title }}</h2>
            <p class="featured-excerpt">{{ featuredPost.data.excerpt or featuredPost.data.subtitle }}</p>
          </div>
          <div class="featured-meta">
            <span class="meta-item"><i class="fa-solid fa-user-astronaut"></i> {{ featuredPost.data.author or "Aimad Ul Islam" }}</span>
            <span class="meta-item"><i class="fa-regular fa-calendar"></i> {{ featuredPost.date | readableDate }}</span>
            <span class="meta-item"><i class="fa-regular fa-clock"></i> {{ featuredPost.data.readingTime or 10 }} min read</span>
            <a href="{{ featuredPost.url }}" class="btn btn-sm btn-cyan ml-auto"><i class="fa-solid fa-book-open"></i> Read Full Guide</a>
          </div>
        </div>
      </article>
      {% endif %}
    </div>
  </section>

  <!-- ARTICLES GRID SECTION -->
  <section id="articles-section" class="articles-main-section">
    <div class="blog-layout">
      <!-- Main Articles Grid -->
      <div class="articles-column">
        <div class="section-flex-header">
          <h2 class="articles-section-title"><i class="fa-solid fa-newspaper"></i> All Published Guides</h2>
          <span class="posts-count-badge" id="posts-count">{{ collections.posts.length }} Articles</span>
        </div>

        <div id="articles-grid" class="articles-grid">
          {% for post in collections.posts %}
          <article class="card article-card" 
                   data-categories="{{ post.data.categories | join(',') | lower }}" 
                   data-title="{{ post.data.title | lower }}"
                   data-excerpt="{{ (post.data.excerpt or post.data.subtitle or '') | lower }}"
                   data-tags="{{ (post.data.tags or []) | join(',') | lower }}"
                   data-difficulty="{{ (post.data.difficulty or 'intermediate') | lower }}"
                   data-date="{{ post.date | htmlDateString }}"
                   data-readtime="{{ post.data.readingTime or 5 }}"
                   onclick="window.location='{{ post.url }}'">
            <div class="card-glow"></div>
            <div class="article-card-img-wrap">
              {% if post.data.image or post.data.thumbnail %}
              <img class="article-card-img" src="{{ post.data.image or post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy"/>
              {% else %}
              <div class="article-card-img-placeholder">
                <span class="card-emoji">{{ post.data.emoji or "📄" }}</span>
              </div>
              {% endif %}
              <span class="card-diff-badge {{ (post.data.difficulty or 'Intermediate') | lower }}">{{ post.data.difficulty or "Intermediate" }}</span>
            </div>

            <div class="article-card-body">
              <div class="article-card-tags">
                {% for cat in post.data.categories %}
                <span class="tag tag-cyber">{{ cat }}</span>
                {% endfor %}
              </div>

              <h3 class="article-card-title">{{ post.data.title }}</h3>
              <p class="article-card-excerpt">{{ post.data.excerpt or post.data.subtitle }}</p>

              {% if post.data.tags %}
              <div class="article-tags-mini">
                {% for tag in post.data.tags %}
                <span class="mini-tag">#{{ tag }}</span>
                {% endfor %}
              </div>
              {% endif %}

              <div class="article-card-footer">
                <div class="article-meta-mini">
                  <span><i class="fa-regular fa-calendar"></i> {{ post.date | readableDate }}</span>
                  <span><i class="fa-regular fa-clock"></i> {{ post.data.readingTime or 5 }}m</span>
                </div>
                <span class="read-more-link">Read Writeup <i class="fa-solid fa-arrow-right fa-xs"></i></span>
              </div>
            </div>
          </article>
          {% endfor %}
        </div>

        <!-- No Results Fallback -->
        <div class="no-results card" id="no-results" style="display:none;">
          <i class="fa-solid fa-robot"></i>
          <h3>No Matching Security Writeups Found</h3>
          <p>Try refining your search keyword, changing difficulty levels, or resetting category filters.</p>
          <button class="btn btn-cyan mt-3" onclick="resetSearch()"><i class="fa-solid fa-rotate"></i> Reset All Filters</button>
        </div>

        <!-- Pagination Controls -->
        <div class="pagination-container" id="pagination-controls" style="margin-top:2.5rem;">
          <!-- Dynamically populated via JS -->
        </div>
      </div>

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <!-- Quick Stats -->
        <div class="sidebar-widget card">
          <h3 class="widget-title"><i class="fa-solid fa-chart-line"></i> Knowledge Index</h3>
          <div class="sidebar-stats-grid">
            <div class="s-stat-box">
              <div class="s-stat-val">{{ collections.posts.length }}</div>
              <div class="s-stat-lbl">Articles</div>
            </div>
            <div class="s-stat-box">
              <div class="s-stat-val">{{ collections.categories.length }}</div>
              <div class="s-stat-lbl">Categories</div>
            </div>
            <div class="s-stat-box">
              <div class="s-stat-val">100%</div>
              <div class="s-stat-lbl">Verified</div>
            </div>
          </div>
        </div>

        <!-- Categories Widget -->
        <div class="sidebar-widget card">
          <h3 class="widget-title"><i class="fa-solid fa-folder-tree"></i> Categories Breakdown</h3>
          <div class="sidebar-cat-list">
            {% for cat in collections.categories %}
            <a href="#" class="sidebar-cat-item" data-cat="{{ cat }}">
              <span class="cat-name"><i class="fa-solid fa-folder text-cyan"></i> {{ cat }}</span>
              <span class="cat-count-badge">{{ collections.categoryCounts[cat] or 1 }}</span>
            </a>
            {% endfor %}
          </div>
        </div>

        <!-- Recent Articles -->
        <div class="sidebar-widget card">
          <h3 class="widget-title"><i class="fa-regular fa-clock"></i> Recent Publications</h3>
          <div class="sidebar-posts">
            {% for post in collections.posts | head(5) %}
            <a href="{{ post.url }}" class="sidebar-post">
              <div class="sidebar-post-thumb">
                {% if post.data.thumbnail or post.data.image %}
                <img src="{{ post.data.thumbnail or post.data.image }}" alt="{{ post.data.title }}"/>
                {% else %}
                <span class="thumb-emoji">{{ post.data.emoji or "📄" }}</span>
                {% endif %}
              </div>
              <div class="sidebar-post-info">
                <h4 class="sidebar-post-title">{{ post.data.title }}</h4>
                <span class="sidebar-post-date"><i class="fa-regular fa-calendar"></i> {{ post.date | readableDate }}</span>
              </div>
            </a>
            {% endfor %}
          </div>
        </div>

        <!-- Newsletter Sub Widget -->
        <div class="sidebar-widget card">
          <h3 class="widget-title"><i class="fa-solid fa-paper-plane"></i> Security Digest</h3>
          <p class="widget-desc">Get technical walkthroughs and threat intelligence briefs directly in your inbox.</p>
          <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed to Security Digest successfully!');">
            <input type="email" placeholder="security.analyst@domain.com" required class="cyber-input"/>
            <button type="submit" class="btn btn-cyan btn-full mt-2"><i class="fa-solid fa-rss"></i> Subscribe</button>
          </form>
        </div>
      </aside>
    </div>
  </section>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const searchInput = document.getElementById("blog-search");
  const difficultySelect = document.getElementById("difficulty-select");
  const sortSelect = document.getElementById("sort-select");
  const catBtns = document.querySelectorAll(".cat-btn");
  const sidebarCatLinks = document.querySelectorAll(".sidebar-cat-item");
  const articlesGrid = document.getElementById("articles-grid");
  const articles = Array.from(document.querySelectorAll(".article-card"));
  const noResults = document.getElementById("no-results");
  const postsCountBadge = document.getElementById("posts-count");
  const paginationControls = document.getElementById("pagination-controls");

  let currentCat = "all";
  let currentDifficulty = "all";
  let currentSort = "newest";
  let currentSearch = "";
  let currentPage = 1;
  const itemsPerPage = 6;

  function updateDisplay() {
    let filtered = articles.filter(article => {
      const title = article.getAttribute("data-title") || "";
      const excerpt = article.getAttribute("data-excerpt") || "";
      const cats = article.getAttribute("data-categories") || "";
      const tags = article.getAttribute("data-tags") || "";
      const difficulty = article.getAttribute("data-difficulty") || "";

      const matchesSearch = currentSearch === "" || 
                            title.includes(currentSearch) || 
                            excerpt.includes(currentSearch) || 
                            cats.includes(currentSearch) || 
                            tags.includes(currentSearch);

      const matchesCat = currentCat === "all" || cats.includes(currentCat.toLowerCase());
      const matchesDiff = currentDifficulty === "all" || difficulty === currentDifficulty.toLowerCase();

      return matchesSearch && matchesCat && matchesDiff;
    });

    // Sorting
    filtered.sort((a, b) => {
      if (currentSort === "newest") {
        return new Date(b.getAttribute("data-date")) - new Date(a.getAttribute("data-date"));
      } else if (currentSort === "oldest") {
        return new Date(a.getAttribute("data-date")) - new Date(b.getAttribute("data-date"));
      } else if (currentSort === "readtime") {
        return parseInt(b.getAttribute("data-readtime")) - parseInt(a.getAttribute("data-readtime"));
      } else if (currentSort === "title") {
        return a.getAttribute("data-title").localeCompare(b.getAttribute("data-title"));
      }
      return 0;
    });

    // Count badge update
    if (postsCountBadge) {
      postsCountBadge.textContent = `${filtered.length} Articles`;
    }

    // Hide all
    articles.forEach(a => a.style.display = "none");

    if (filtered.length === 0) {
      if (noResults) noResults.style.display = "block";
      if (paginationControls) paginationControls.innerHTML = "";
      return;
    } else {
      if (noResults) noResults.style.display = "none";
    }

    // Pagination
    const totalPages = Math.ceil(filtered.length / itemsPerPage);
    if (currentPage > totalPages) currentPage = 1;

    const startIdx = (currentPage - 1) * itemsPerPage;
    const endIdx = startIdx + itemsPerPage;
    const pageItems = filtered.slice(startIdx, endIdx);

    // Re-append sorted & paged items to grid
    pageItems.forEach(item => {
      item.style.display = "flex";
      articlesGrid.appendChild(item);
    });

    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    if (!paginationControls || totalPages <= 1) {
      if (paginationControls) paginationControls.innerHTML = "";
      return;
    }

    let html = `<div class="cyber-pagination">`;
    html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" onclick="changeBlogPage(${currentPage - 1})"><i class="fa-solid fa-chevron-left"></i> Prev</button>`;

    for (let i = 1; i <= totalPages; i++) {
      html += `<button class="page-num ${i === currentPage ? 'active' : ''}" onclick="changeBlogPage(${i})">${i}</button>`;
    }

    html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" onclick="changeBlogPage(${currentPage + 1})">Next <i class="fa-solid fa-chevron-right"></i></button>`;
    html += `</div>`;

    paginationControls.innerHTML = html;
  }

  window.changeBlogPage = (page) => {
    currentPage = page;
    updateDisplay();
    document.getElementById("articles-section").scrollIntoView({ behavior: 'smooth' });
  };

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      currentSearch = e.target.value.toLowerCase().trim();
      currentPage = 1;
      updateDisplay();
    });
  }

  if (difficultySelect) {
    difficultySelect.addEventListener("change", (e) => {
      currentDifficulty = e.target.value;
      currentPage = 1;
      updateDisplay();
    });
  }

  if (sortSelect) {
    sortSelect.addEventListener("change", (e) => {
      currentSort = e.target.value;
      currentPage = 1;
      updateDisplay();
    });
  }

  catBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      catBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      currentCat = btn.getAttribute("data-cat");
      currentPage = 1;
      updateDisplay();
    });
  });

  sidebarCatLinks.forEach(link => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const targetCat = link.getAttribute("data-cat");
      currentCat = targetCat;
      catBtns.forEach(b => {
        if(b.getAttribute("data-cat") === targetCat) b.classList.add("active");
        else b.classList.remove("active");
      });
      currentPage = 1;
      updateDisplay();
      document.getElementById("articles-section").scrollIntoView({ behavior: 'smooth' });
    });
  });

  window.resetSearch = () => {
    if (searchInput) searchInput.value = "";
    if (difficultySelect) difficultySelect.value = "all";
    if (sortSelect) sortSelect.value = "newest";
    currentSearch = "";
    currentDifficulty = "all";
    currentSort = "newest";
    currentCat = "all";
    catBtns.forEach(b => {
      if (b.getAttribute("data-cat") === "all") b.classList.add("active");
      else b.classList.remove("active");
    });
    currentPage = 1;
    updateDisplay();
  };

  // Check URL query string
  const urlParams = new URLSearchParams(window.location.search);
  const catParam = urlParams.get('cat') || urlParams.get('category');
  if (catParam) {
    currentCat = catParam;
    catBtns.forEach(b => {
      if(b.getAttribute("data-cat").toLowerCase() === catParam.toLowerCase()) b.classList.add("active");
      else b.classList.remove("active");
    });
  }

  updateDisplay();
});
</script>
