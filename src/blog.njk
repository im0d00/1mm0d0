<!-- Scroll to Top -->
<button id="scroll-top" aria-label="Scroll to top" title="Scroll to top">
  <i class="fa-solid fa-chevron-up fa-xs" aria-hidden="true"></i>
</button>

<script src="/js/blog.js"></script>
<script>
  // Simple client-side filtering logic for the Eleventy rendered list
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("blog-search");
    const catBtns = document.querySelectorAll(".cat-btn");
    const sidebarCatLinks = document.querySelectorAll(".cat-sidebar-link");
    const articles = document.querySelectorAll(".article-card");
    const noResults = document.getElementById("no-results");
    
    let currentCat = "all";
    let currentSearch = "";

    function applyFilters() {
      let visibleCount = 0;
      articles.forEach(article => {
        const title = article.getAttribute("data-title");
        const cats = article.getAttribute("data-categories");
        
        const matchesSearch = currentSearch === "" || title.includes(currentSearch) || cats.includes(currentSearch);
        const matchesCat = currentCat === "all" || cats.includes(currentCat.toLowerCase());

        if (matchesSearch && matchesCat) {
          article.style.display = "";
          visibleCount++;
        } else {
          article.style.display = "none";
        }
      });

      if (visibleCount === 0) {
        noResults.style.display = "block";
      } else {
        noResults.style.display = "none";
      }
    }

    if(searchInput) {
      searchInput.addEventListener("input", (e) => {
        currentSearch = e.target.value.toLowerCase().trim();
        applyFilters();
      });
    }

    function setActiveCategory(cat) {
      currentCat = cat;
      catBtns.forEach(b => {
        if(b.getAttribute("data-cat") === cat) {
          b.classList.add("active");
        } else {
          b.classList.remove("active");
        }
      });
      applyFilters();
    }

    catBtns.forEach(btn => {
      btn.addEventListener("click", (e) => {
        setActiveCategory(btn.getAttribute("data-cat"));
      });
    });

    sidebarCatLinks.forEach(link => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetCat = link.getAttribute("data-cat");
        setActiveCategory(targetCat);
        document.getElementById("articles-section").scrollIntoView({behavior: "smooth"});
      });
    });

    window.resetSearch = () => {
      if(searchInput) searchInput.value = "";
      currentSearch = "";
      setActiveCategory("all");
    };

    // Handle URL params
    const params = new URLSearchParams(window.location.search);
    const urlCat = params.get('cat');
    if(urlCat) {
      setActiveCategory(urlCat);
    }
  });
</script>
</body>
</html>
